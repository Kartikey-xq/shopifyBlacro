{% liquid
  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height
  assign image_fit = section.settings.image_fit
%}

{%- style -%}
  #Section-{{ section.id }} {
    --desktop-height: {{ desktop_height }}vh;
    --mobile-height: {{ mobile_height }}vh;
    --image-fit: {{ image_fit }};
    margin: 0 !important;
    padding: 0 !important;
  }
{%- endstyle -%}

{%- liquid
  # Future-proofing: We pull product images here. Currently limiting to 2 images (which are skipped by the main media gallery).
  # Later, we can apply custom filters (e.g. checking alt tags, metafields) to this array.
  assign raw_media_items = product.media | where: "media_type", "image"
  
  assign image_limit = 2
  assign image_count = 0
-%}

{%- capture slides -%}
  {%- for media in raw_media_items -%}
    {%- if image_count < image_limit -%}
      <div class="zoomed-media-carousel__slide" data-index="{{ image_count }}">
        {{ media | image_url: width: 2200 | image_tag: 
          loading: 'lazy', 
          class: 'zoomed-media-carousel__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 2200'
        }}
      </div>
      {%- assign image_count = image_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if image_count == 0 -%}
  {%- comment -%} Onboarding placeholders when product has no images or in empty editor state {%- endcomment -%}
  {%- assign image_count = 2 -%}
  {%- capture slides -%}
    {%- for i in (1..2) -%}
      <div class="zoomed-media-carousel__slide" data-index="{{ forloop.index0 }}">
        {%- assign placeholder_name = 'hero-apparel-' | append: i -%}
        {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg zoomed-media-carousel__image' }}
      </div>
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<zoomed-media-carousel class="zoomed-media-carousel-section" id="Section-{{ section.id }}">
  <div class="zoomed-media-carousel-wrapper">
    <!-- Carousel Scroller -->
    <div class="zoomed-media-carousel__scroller">
      {{ slides }}
    </div>

    <!-- Navigation Controls -->
    {%- if image_count > 1 -%}
      <button class="zoomed-media-carousel__arrow zoomed-media-carousel__arrow--prev" aria-label="Previous slide" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="zoomed-media-carousel__arrow zoomed-media-carousel__arrow--next" aria-label="Next slide" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <!-- Dot Indicators -->
      <div class="zoomed-media-carousel__dots">
        {%- for i in (1..image_count) -%}
          <button class="zoomed-media-carousel__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" type="button"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</zoomed-media-carousel>

{% stylesheet %}
  .zoomed-media-carousel-section {
    display: block;
    width: 100vw;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden;
  }

  .zoomed-media-carousel-wrapper {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    background-color: #000000;
  }

  .zoomed-media-carousel__scroller {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    scrollbar-width: none; /* Firefox */
  }

  .zoomed-media-carousel__scroller::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .zoomed-media-carousel__slide {
    flex: 0 0 100vw;
    width: 100vw;
    height: var(--desktop-height, 100vh);
    scroll-snap-align: start;
    margin: 0;
    padding: 0;
    position: relative;
    box-sizing: border-box;
  }

  .zoomed-media-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: var(--image-fit, cover);
    display: block;
  }

  .zoomed-media-carousel__slide .placeholder-svg {
    fill: #555555;
    background-color: #111111;
  }

  .zoomed-media-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
    opacity: 0.8;
    padding: 0;
  }

  .zoomed-media-carousel__arrow:hover {
    background: rgba(255, 255, 255, 0.3);
    opacity: 1;
    transform: translateY(-50%) scale(1.05);
  }

  .zoomed-media-carousel__arrow--prev {
    left: 20px;
  }

  .zoomed-media-carousel__arrow--next {
    right: 20px;
  }

  .zoomed-media-carousel__arrow svg {
    width: 24px;
    height: 24px;
  }

  .zoomed-media-carousel__dots {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .zoomed-media-carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .zoomed-media-carousel__dot.is-active {
    background: #ffffff;
    transform: scale(1.3);
  }

  @media screen and (max-width: 749px) {
    .zoomed-media-carousel__slide {
      height: var(--mobile-height, 60vh);
    }
    .zoomed-media-carousel__arrow {
      width: 40px;
      height: 40px;
    }
    .zoomed-media-carousel__arrow--prev {
      left: 10px;
    }
    .zoomed-media-carousel__arrow--next {
      right: 10px;
    }
    .zoomed-media-carousel__arrow svg {
      width: 20px;
      height: 20px;
    }
    .zoomed-media-carousel__dots {
      bottom: 20px;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('zoomed-media-carousel')) {
    class ZoomedMediaCarousel extends HTMLElement {
      connectedCallback() {
        const scroller = this.querySelector('.zoomed-media-carousel__scroller');
        const prevBtn = this.querySelector('.zoomed-media-carousel__arrow--prev');
        const nextBtn = this.querySelector('.zoomed-media-carousel__arrow--next');
        const dots = this.querySelectorAll('.zoomed-media-carousel__dot');

        if (prevBtn && nextBtn) {
          prevBtn.addEventListener('click', () => {
            scroller.scrollBy({ left: -scroller.clientWidth, behavior: 'smooth' });
          });
          nextBtn.addEventListener('click', () => {
            scroller.scrollBy({ left: scroller.clientWidth, behavior: 'smooth' });
          });
        }

        if (dots.length > 0) {
          scroller.addEventListener('scroll', () => {
            const slideWidth = scroller.clientWidth;
            if (slideWidth === 0) return;
            const index = Math.round(scroller.scrollLeft / slideWidth);
            dots.forEach((dot, i) => {
              dot.classList.toggle('is-active', i === index);
            });
          });

          dots.forEach((dot, i) => {
            dot.addEventListener('click', () => {
              scroller.scrollTo({ left: i * scroller.clientWidth, behavior: 'smooth' });
            });
          });
        }
      }
    }
    customElements.define('zoomed-media-carousel', ZoomedMediaCarousel);
  }
</script>

{% schema %}
{
  "name": "Zoomed Product Media",
  "tag": "section",
  "class": "section-zoomed-media-carousel",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Carousel Size"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop Height (viewport height)",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile Height (viewport height)",
      "default": 60
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit / Aspect Ratio",
      "options": [
        { "value": "cover", "label": "Cover (Crop to fill slide)" },
        { "value": "contain", "label": "Contain (Letterbox to fit slide)" }
      ],
      "default": "cover"
    }
  ],
  "presets": [
    {
      "name": "Zoomed Product Media"
    }
  ]
}
{% endschema %}

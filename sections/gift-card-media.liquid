{%- if product.media.size > 0 -%}
  <div class="gift-card-media-gallery" id="gift-card-media-{{ section.id }}">
    <div class="gift-card-media-gallery__grid">
      {%- for media in product.media -%}
        <div class="gift-card-media-gallery__item" data-media-type="{{ media.media_type }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{ media | image_url: width: 1200 | image_tag: class: 'gift-card-media__image', loading: 'lazy', alt: media.alt | escape }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, autoplay: false, loop: false, class: 'gift-card-media__video' }}
            {%- when 'external_video' -%}
              <div class="gift-card-media__video-wrapper">
                {{ media | external_video_tag: class: 'gift-card-media__external-video' }}
              </div>
            {%- when 'model' -%}
              {{ media | model_viewer_tag: controls: true, class: 'gift-card-media__model' }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

<style>
  #gift-card-media-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color | default: 'transparent' }};
  }
  .gift-card-media-gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap }}px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .gift-card-media-gallery__item {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .gift-card-media__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .gift-card-media__video,
  .gift-card-media__model,
  .gift-card-media__external-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    display: block;
  }
  .gift-card-media__video-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
  }
  .gift-card-media__video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media screen and (min-width: 750px) {
    .gift-card-media-gallery__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 2 }}, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Gift Card Media Gallery",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap (px)",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Gift Card Media Gallery"
    }
  ]
}
{% endschema %}

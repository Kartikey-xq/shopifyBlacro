{% comment %}
  Blacro footer section inspired by the requested layout.
  Includes CTA, client services/company menus, social links, policy menu, and current theme color scheme support.
{% endcomment %}

{% liquid
  assign brand_name = 'BLACRO'
  assign client_services_menu = linklists[section.settings.client_services_menu]
  assign company_menu = linklists[section.settings.company_menu]
  assign policy_menu = linklists[section.settings.policy_menu]
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-blacro" style="padding-block-start: {{ section.settings.padding_block_start }}px; padding-block-end: {{ section.settings.padding_block_end }}px;">
  <div class="footer-blacro__container">
    <div class="footer-blacro__hero">
      <div class="footer-blacro__hero-copy">
        <p class="footer-blacro__eyebrow">{{ brand_name }}</p>
        <h2 class="footer-blacro__headline">{{ section.settings.hero_heading | default: 'Join Blacro Loyalty' }}</h2>
        <p class="footer-blacro__text">{{ section.settings.hero_text | default: 'Unlock 10% Off Your First Purchase Plus More Rewards And Benefits' }}</p>
        {% if section.settings.hero_button_url != blank %}
          <a href="{{ section.settings.hero_button_url }}" class="footer-blacro__hero-button">{{ section.settings.hero_button_label | default: 'SIGN UP' }}</a>
        {% endif %}
      </div>
      <div class="footer-blacro__hero-links">
        <div class="footer-blacro__block">
          <p class="footer-blacro__block-title">Client Services</p>
          {% if client_services_menu != blank and client_services_menu.links.size > 0 %}
            <ul class="footer-blacro__link-list">
              {% for link in client_services_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-blacro__hint">Add a Client Services menu in section settings.</p>
          {% endif %}
        </div>

        <div class="footer-blacro__block">
          <p class="footer-blacro__block-title">Company</p>
          {% if company_menu != blank and company_menu.links.size > 0 %}
            <ul class="footer-blacro__link-list">
              {% for link in company_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-blacro__hint">Add a Company menu in section settings.</p>
          {% endif %}
        </div>

        <div class="footer-blacro__block footer-blacro__social-block">
          <p class="footer-blacro__block-title">Social</p>
          <div class="footer-blacro__social-list">
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">INSTAGRAM</span>
              </a>
            {% endif %}
            {% if section.settings.facebook_url != blank %}
              <a href="{{ section.settings.facebook_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">FACEBOOK</span>
              </a>
            {% endif %}
            {% if section.settings.x_url != blank %}
              <a href="{{ section.settings.x_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">X</span>
              </a>
            {% endif %}
            {% if section.settings.tiktok_url != blank %}
              <a href="{{ section.settings.tiktok_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">TIKTOK</span>
              </a>
            {% endif %}
            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">YOUTUBE</span>
              </a>
            {% endif %}
            {% if section.settings.linkedin_url != blank %}
              <a href="{{ section.settings.linkedin_url }}" class="footer-blacro__social-link" target="_blank" rel="noopener noreferrer">
                <span class="footer-blacro__social-icon">LINKEDIN</span>
              </a>
            {% endif %}
          </div>
          {% if section.settings.social_text != blank %}
            <p class="footer-blacro__social-note">{{ section.settings.social_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="footer-blacro__bottom">
      <div class="footer-blacro__policies">
        {% if policy_menu != blank and policy_menu.links.size > 0 %}
          {% for link in policy_menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <span class="footer-blacro__hint">Add a Policies menu in section settings.</span>
        {% endif %}
      </div>
      <div class="footer-blacro__copyright">
        <span>© {{ 'now' | date: '%Y' }} {{ brand_name }}. All rights reserved.</span>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .footer-blacro {
    position: relative;
    color: var(--color-foreground);
  }

  .footer-blacro__container {
    display: grid;
    gap: 2.5rem;
  }

  .footer-blacro__hero {
    display: grid;
    gap: 2rem;
  }

  .footer-blacro__hero-copy {
    max-width: 540px;
  }

  .footer-blacro__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-primary);
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .footer-blacro__headline {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .footer-blacro__text {
    margin: 0 0 1.5rem;
    color: var(--color-foreground-muted);
    max-width: 42rem;
  }

  .footer-blacro__hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-foreground);
    color: var(--color-foreground);
    background: transparent;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .footer-blacro__hero-button:hover {
    background: rgba(var(--color-foreground-rgb), 0.08);
    transform: translateY(-1px);
  }

  .footer-blacro__hero-links {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer-blacro__block-title {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .footer-blacro__link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .footer-blacro__link-list a,
  .footer-blacro__policies a {
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-blacro__link-list a:hover,
  .footer-blacro__policies a:hover {
    color: var(--color-foreground);
  }

  .footer-blacro__social-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-blacro__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-blacro__social-link {
    display: inline-flex;
    width: 2.8rem;
    height: 2.8rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-foreground-rgb), 0.08);
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .footer-blacro__social-link:hover {
    background: rgba(var(--color-foreground-rgb), 0.16);
    transform: translateY(-1px);
  }

  .footer-blacro__social-note {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: 0.95rem;
  }

  .footer-blacro__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.12);
    padding-top: 1.5rem;
  }

  .footer-blacro__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .footer-blacro__copyright {
    color: var(--color-foreground-muted);
    font-size: 0.95rem;
  }

  .footer-blacro__hint {
    color: rgba(var(--color-foreground-rgb), 0.6);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 980px) {
    .footer-blacro__hero-links {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .footer-blacro__container {
      gap: 1.75rem;
    }

    .footer-blacro__hero {
      gap: 1.5rem;
    }

    .footer-blacro__bottom {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .footer-blacro__policies {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blacro Footer",
  "tag": "footer",
  "class": "section-footer-blacro",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Join Blacro Loyalty"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Unlock 10% Off Your First Purchase Plus More Rewards And Benefits"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "CTA button label",
      "default": "SIGN UP"
    },
    {
      "type": "url",
      "id": "hero_button_url",
      "label": "CTA button URL"
    },
    {
      "type": "link_list",
      "id": "client_services_menu",
      "label": "Client Services menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policies menu"
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Social caption",
      "default": "Follow us for new drops and insider updates"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Blacro Footer",
      "category": "Footer",
      "settings": {
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "hero_heading": "Join Blacro Loyalty",
        "hero_text": "Unlock 10% Off Your First Purchase Plus More Rewards And Benefits",
        "hero_button_label": "SIGN UP"
      }
    }
  ]
}
{% endschema %}
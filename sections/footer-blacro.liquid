{% comment %}
  Blacro footer section inspired by the requested layout.
  Includes CTA, company menus, social links, policy menu, and current theme color scheme support.
{% endcomment %}

{% liquid
  assign brand_name = 'BLACRO'
  assign company_menu = linklists[section.settings.company_menu]
  assign policy_menu = linklists[section.settings.policy_menu]
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-blacro" id="FooterBlacro-{{ section.id }}" style="padding-block-start: {{ section.settings.padding_block_start }}px; padding-block-end: {{ section.settings.padding_block_end }}px;">
  {%- unless request.design_mode -%}
    <script>
      (function() {
        const footer = document.getElementById('FooterBlacro-{{ section.id }}');
        if (footer) {
          footer.classList.add('footer-blacro--animated');
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  footer.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.05 });
            observer.observe(footer);
          } else {
            footer.classList.add('is-visible');
          }
        }
      })();
    </script>
  {%- endunless -%}
  
  <div class="footer-blacro__container">
    <div class="footer-blacro__hero">
      <div class="footer-blacro__hero-copy">
        {% if section.settings.brand_logo_top != blank %}
          <div class="footer-blacro__brand-logo-wrapper">
            <img 
              src="{{ section.settings.brand_logo_top | image_url: width: 300 }}" 
              alt="{{ shop.name }}"
              class="footer-blacro__brand-logo"
              style="max-width: {{ section.settings.brand_logo_top_width }}px;"
              width="{{ section.settings.brand_logo_top.width }}"
              height="{{ section.settings.brand_logo_top.height }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <p class="footer-blacro__eyebrow">{{ brand_name }}</p>
        {% endif %}
        <h2 class="footer-blacro__headline">{{ section.settings.hero_heading | default: 'Join Blacro Loyalty' }}</h2>
        <p class="footer-blacro__text">{{ section.settings.hero_text | default: 'Unlock 10% Off Your First Purchase Plus More Rewards And Benefits' }}</p>
        {% if section.settings.hero_button_url != blank %}
          <a href="{{ section.settings.hero_button_url }}" class="footer-blacro__hero-button">
            <span>{{ section.settings.hero_button_label | default: 'SIGN UP' }}</span>
            <svg class="footer-blacro__button-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
      
      <div class="footer-blacro__hero-links">
        <div class="footer-blacro__block">
          <p class="footer-blacro__block-title">Company</p>
          {% if company_menu != blank and company_menu.links.size > 0 %}
            <ul class="footer-blacro__link-list">
              {% for link in company_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-blacro__hint">Add a Company menu in section settings.</p>
          {% endif %}
        </div>

        <div class="footer-blacro__block footer-blacro__social-block">
          <p class="footer-blacro__block-title">Social</p>
          {% if section.settings.social_text != blank %}
            <p class="footer-blacro__social-note">{{ section.settings.social_text }}</p>
          {% endif %}
          <ul class="footer-blacro__link-list">
            {%- liquid
              # Replace line breaks, newlines, and br tags with standard spaces, then split by space
              assign raw_links = section.settings.social_links_textarea | newline_to_br | replace: '<br />', ' ' | replace: '<br>', ' ' | strip_newlines
              assign link_array = raw_links | split: ' '
            -%}
            {%- for item in link_array -%}
              {%- assign link = item | strip | strip_newlines -%}
              {%- if link != blank and link contains 'http' -%}
                {%- liquid
                  assign platform_name = ''
                  assign platform_url = link
                  
                  if link contains 'instagram.com'
                    assign platform_name = 'Insta'
                  elsif link contains 'facebook.com' or link contains 'fb.com'
                    assign platform_name = 'Facebook'
                  elsif link contains 'linkedin.com'
                    assign platform_name = 'Linkedin'
                  elsif link contains 'twitter.com' or link contains 'x.com'
                    assign platform_name = 'Twitter'
                  elsif link contains 'tiktok.com'
                    assign platform_name = 'TikTok'
                  elsif link contains 'youtube.com' or link contains 'youtu.be'
                    assign platform_name = 'YouTube'
                  elsif link contains 'pinterest.com'
                    assign platform_name = 'Pinterest'
                  else
                    assign domain = link | split: '//' | last | remove: 'www.' | split: '.' | first
                    assign platform_name = domain | capitalize
                  endif
                -%}
                {%- if platform_name != blank -%}
                  <li>
                    <a href="{{ platform_url }}" target="_blank" rel="noopener noreferrer">
                      {{ platform_name }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

    <!-- Giant brand watermark / Big logo -->
    <div class="footer-blacro__large-brand-wrapper">
      {% if section.settings.brand_logo_bottom != blank %}
        <div class="footer-blacro__large-brand-logo-container" style="max-width: {{ section.settings.brand_logo_bottom_width }}px; margin: 0 auto; position: relative;">
          <!-- Front Logo -->
          <img 
            src="{{ section.settings.brand_logo_bottom | image_url: width: 1400 }}" 
            alt="{{ shop.name }} Large Logo"
            class="footer-blacro__large-brand-logo footer-blacro__large-brand-logo--front"
            style="display: block; width: 100%; height: auto;"
            loading="lazy"
            width="{{ section.settings.brand_logo_bottom.width }}"
            height="{{ section.settings.brand_logo_bottom.height }}"
          >
          <!-- Back Logo (Pre-flipped on Y-axis) -->
          <img 
            src="{{ section.settings.brand_logo_bottom | image_url: width: 1400 }}" 
            alt="{{ shop.name }} Large Logo"
            class="footer-blacro__large-brand-logo footer-blacro__large-brand-logo--back"
            style="display: block; width: 100%; height: auto;"
            loading="lazy"
            width="{{ section.settings.brand_logo_bottom.width }}"
            height="{{ section.settings.brand_logo_bottom.height }}"
          >
        </div>
      {% else %}
        <span class="footer-blacro__large-brand">{{ brand_name }}</span>
      {% endif %}
    </div>

    <div class="footer-blacro__bottom">
      <div class="footer-blacro__policies">
        {% if policy_menu != blank and policy_menu.links.size > 0 %}
          {% for link in policy_menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <span class="footer-blacro__hint">Add a Policies menu in section settings.</span>
        {% endif %}
      </div>
      <div class="footer-blacro__copyright">
        <span>© {{ 'now' | date: '%Y' }} {{ brand_name }}. All rights reserved.</span>
      </div>
    </div>
  </div>
</div>


{% stylesheet %}
  .footer-blacro {
    position: relative;
    color: var(--color-foreground);
    overflow: hidden;
    /* Premium subtle radial glow */
    background: radial-gradient(circle at 80% 20%, rgba(var(--color-foreground-rgb), 0.02), transparent 60%), var(--gradient-background);
  }

  /* Fade-in/out on viewport intersection */
  .footer-blacro--animated {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro--animated.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .footer-blacro__container {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 2rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-blacro__hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .footer-blacro__hero-copy {
    max-width: 540px;
  }

  .footer-blacro__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
    opacity: 0.5;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .footer-blacro__headline {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-transform: none;
  }

  .footer-blacro__text {
    margin: 0 0 2rem;
    color: var(--color-foreground);
    opacity: 0.65;
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 480px;
  }

  /* Premium sleek pill CTA button with arrow transition */
  .footer-blacro__hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    color: var(--color-foreground);
    background: transparent;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__hero-button .footer-blacro__button-arrow {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__hero-button:hover {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .footer-blacro__hero-button:hover .footer-blacro__button-arrow {
    transform: translateX(4px);
  }

  /* 2-column link layout (Company & Social) */
  .footer-blacro__hero-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .footer-blacro__block-title {
    margin: 0 0 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.4;
  }

  .footer-blacro__link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .footer-blacro__link-list a {
    display: inline-block;
    color: var(--color-foreground);
    opacity: 0.7;
    text-decoration: none;
    font-size: 0.95rem;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left;
  }

  /* Sibling Fade Effect for Link List */
  .footer-blacro__link-list:hover a {
    opacity: 0.35;
  }

  .footer-blacro__link-list a:hover {
    opacity: 1;
    transform: translateX(4px);
  }

  .footer-blacro__social-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-blacro__social-note {
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
    opacity: 0.65;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .footer-blacro__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__social-link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.12);
    background: transparent;
    color: var(--color-foreground);
    transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sibling Fade Effect for Socials */
  .footer-blacro__social-list:hover .footer-blacro__social-link {
    opacity: 0.4;
  }

  .footer-blacro__social-link:hover {
    opacity: 1 !important;
    border-color: var(--color-foreground);
    background: rgba(var(--color-foreground-rgb), 0.04);
    transform: translateY(-2px);
  }

  /* Giant brand watermark footer element */
  .footer-blacro__large-brand-wrapper {
    margin-block-start: 2rem;
    margin-block-end: 1rem;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    padding-block-start: 1rem;
    perspective: 1200px;
  }

  .footer-blacro__large-brand {
    display: block;
    text-align: center;
    font-size: clamp(3rem, 12.5vw, 11rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.05;
  }

  .footer-blacro__brand-logo-wrapper {
    margin-bottom: 1.5rem;
  }

  .footer-blacro__brand-logo {
    display: block;
    height: auto;
  }

  @keyframes footerLogoSpin {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(360deg);
    }
  }

  .footer-blacro__large-brand-logo-container {
    display: block;
    position: relative;
    transform-style: preserve-3d;
    animation: footerLogoSpin 12s linear infinite;
    transform-origin: center;
  }

  .footer-blacro__large-brand-logo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 1 !important;
    filter: none !important;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .footer-blacro__large-brand-logo--front {
    position: relative;
    z-index: 5;
    transform: rotateY(0deg);
  }

  .footer-blacro__large-brand-logo--back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    transform: rotateY(180deg);
  }

  .footer-blacro__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    padding-top: 2rem;
  }

  .footer-blacro__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
  }

  .footer-blacro__policies a {
    color: var(--color-foreground);
    opacity: 0.6;
    font-size: 0.85rem;
    text-decoration: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sibling Fade Effect for Policies */
  .footer-blacro__policies:hover a {
    opacity: 0.35;
  }

  .footer-blacro__policies a:hover {
    opacity: 1;
  }

  .footer-blacro__copyright {
    color: var(--color-foreground);
    opacity: 0.4;
    font-size: 0.85rem;
  }

  .footer-blacro__hint {
    color: rgba(var(--color-foreground-rgb), 0.6);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 980px) {
    .footer-blacro__hero {
      gap: 3rem;
    }
  }

  @media screen and (max-width: 768px) {
    .footer-blacro__hero {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-blacro__hero-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-blacro__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    .footer-blacro__policies {
      justify-content: center;
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 480px) {
    .footer-blacro__hero-links {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blacro Footer",
  "tag": "footer",
  "class": "section-footer-blacro",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Brand Identity (Top Logo)"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_top",
      "label": "Brand Logo (Top)"
    },
    {
      "type": "range",
      "id": "brand_logo_top_width",
      "label": "Brand Logo Top Width",
      "min": 50,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Brand Identity (Bottom Logo)"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_bottom",
      "label": "Large Watermark Logo (Bottom)"
    },
    {
      "type": "range",
      "id": "brand_logo_bottom_width",
      "label": "Large Watermark Logo Width",
      "min": 200,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Join Blacro Loyalty"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Unlock 10% Off Your First Purchase Plus More Rewards And Benefits"
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "CTA button label",
      "default": "SIGN UP"
    },
    {
      "type": "url",
      "id": "hero_button_url",
      "label": "CTA button URL"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policies menu"
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Social caption",
      "default": "Follow us for new drops and insider updates"
    },
    {
      "type": "textarea",
      "id": "social_links_textarea",
      "label": "Social links (separated by space or line break)",
      "default": "https://www.instagram.com/blacro.in?igsh=dnM4OWFsdzVxMTAz  https://www.facebook.com/share/1JE6hGXvWz/  https://www.linkedin.com/company/blacro/"
    },

    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Blacro Footer",
      "category": "Footer",
      "settings": {
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "hero_heading": "Join Blacro Loyalty",
        "hero_text": "Unlock 10% Off Your First Purchase Plus More Rewards And Benefits",
        "hero_button_label": "SIGN UP"
      }
    }
  ]
}
{% endschema %}
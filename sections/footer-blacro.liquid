{% comment %}
  Blacro footer section inspired by the requested layout.
  Includes CTA, company menus, social links, policy menu, and current theme color scheme support.
{% endcomment %}

{% liquid
  assign brand_name = 'BLACRO'
  assign company_menu = linklists[section.settings.company_menu]
  assign policy_menu = linklists[section.settings.policy_menu]

  assign instagram_url = section.settings.social_instagram_link | strip
  if instagram_url != blank
    unless instagram_url contains '://'
      assign instagram_url = instagram_url | prepend: 'https://'
    endunless
  endif

  assign facebook_url = section.settings.social_facebook_link | strip
  if facebook_url != blank
    unless facebook_url contains '://'
      assign facebook_url = facebook_url | prepend: 'https://'
    endunless
  endif

  assign linkedin_url = section.settings.social_linkedin_link | strip
  if linkedin_url != blank
    unless linkedin_url contains '://'
      assign linkedin_url = linkedin_url | prepend: 'https://'
    endunless
  endif

  assign whatsapp_input = section.settings.social_whatsapp_number | strip
  assign whatsapp_url = ""
  if whatsapp_input != blank
    if whatsapp_input contains "wa.me" or whatsapp_input contains "whatsapp.com"
      assign whatsapp_url = whatsapp_input
      unless whatsapp_url contains "://"
        assign whatsapp_url = whatsapp_url | prepend: "https://"
      endunless
    else
      assign clean_phone = whatsapp_input | replace: " ", "" | replace: "+", "" | replace: "-", ""
      assign whatsapp_url = "https://wa.me/" | append: clean_phone
    endif
  endif
%}

<style>
  #FooterBlacro-{{ section.id }} .footer-blacro__block-title--preset-body {
    font-family: var(--font-paragraph--family) !important;
    font-size: var(--font-paragraph--size, 1.6rem) !important;
    font-weight: var(--font-paragraph--weight, 400) !important;
    text-transform: var(--font-paragraph--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__block-title--preset-subheading {
    font-family: var(--font-subheading--family) !important;
    font-size: var(--font-subheading--size, 1.8rem) !important;
    font-weight: var(--font-subheading--weight, 600) !important;
    text-transform: var(--font-subheading--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__block-title--preset-heading {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-heading--size, 2rem) !important;
    font-weight: var(--font-heading--weight, 700) !important;
    text-transform: var(--font-heading--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__block-title--preset-accent {
    font-family: var(--font-accent--family) !important;
    font-size: var(--font-accent--size, 1.4rem) !important;
    font-weight: var(--font-accent--weight, 400) !important;
    text-transform: var(--font-accent--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__block-title--preset-custom {
    font-size: {{ section.settings.footer_title_custom_size }}px !important;
    {% if section.settings.footer_title_custom_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-weight: var(--font-paragraph--weight, 400) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.footer_title_custom_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.footer_title_custom_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.footer_title_custom_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-weight: var(--font-accent--weight, 400) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% endif %}
  }

  #FooterBlacro-{{ section.id }} .footer-blacro__link--preset-body {
    font-family: var(--font-paragraph--family) !important;
    font-size: var(--font-paragraph--size, 1.6rem) !important;
    font-weight: var(--font-paragraph--weight, 400) !important;
    text-transform: var(--font-paragraph--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__link--preset-subheading {
    font-family: var(--font-subheading--family) !important;
    font-size: var(--font-subheading--size, 1.8rem) !important;
    font-weight: var(--font-subheading--weight, 600) !important;
    text-transform: var(--font-subheading--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__link--preset-heading {
    font-family: var(--font-heading--family) !important;
    font-size: var(--font-heading--size, 2rem) !important;
    font-weight: var(--font-heading--weight, 700) !important;
    text-transform: var(--font-heading--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__link--preset-accent {
    font-family: var(--font-accent--family) !important;
    font-size: var(--font-accent--size, 1.4rem) !important;
    font-weight: var(--font-accent--weight, 400) !important;
    text-transform: var(--font-accent--case, none) !important;
  }
  #FooterBlacro-{{ section.id }} .footer-blacro__link--preset-custom {
    font-size: {{ section.settings.footer_links_custom_size }}px !important;
    {% if section.settings.footer_links_custom_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-weight: var(--font-paragraph--weight, 400) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.footer_links_custom_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.footer_links_custom_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.footer_links_custom_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-weight: var(--font-accent--weight, 400) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% endif %}
  }

  /* Centering SVG icons and making sure they size correctly */
  #FooterBlacro-{{ section.id }} .footer-blacro__social-link svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    display: block;
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-blacro" id="FooterBlacro-{{ section.id }}" style="padding-block-start: {{ section.settings.padding_block_start }}px; padding-block-end: {{ section.settings.padding_block_end }}px;">
  {%- unless request.design_mode -%}
    <script>
      (function() {
        const footer = document.getElementById('FooterBlacro-{{ section.id }}');
        if (footer) {
          footer.classList.add('footer-blacro--animated');
          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  footer.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            }, { threshold: 0.05 });
            observer.observe(footer);
          } else {
            footer.classList.add('is-visible');
          }
        }
      })();
    </script>
  {%- endunless -%}
  
  <div class="footer-blacro__container">
    <div class="footer-blacro__hero">
      <div class="footer-blacro__hero-copy">
        {% if section.settings.brand_logo_top != blank %}
          <div class="footer-blacro__brand-logo-wrapper" style="display: flex; justify-content: {%- if section.settings.brand_logo_top_alignment == 'center' -%}center{%- elsif section.settings.brand_logo_top_alignment == 'right' -%}flex-end{%- else -%}flex-start{%- endif -%};">
            <img 
              src="{{ section.settings.brand_logo_top | image_url: width: 300 }}" 
              alt="{{ shop.name }}"
              class="footer-blacro__brand-logo"
              style="max-width: {{ section.settings.brand_logo_top_width }}px;"
              width="{{ section.settings.brand_logo_top.width }}"
              height="{{ section.settings.brand_logo_top.height }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <p class="footer-blacro__eyebrow">{{ brand_name }}</p>
        {% endif %}
        <h2 class="footer-blacro__headline">{{ section.settings.hero_heading | default: 'Join Blacro Loyalty' }}</h2>
        <p class="footer-blacro__text">{{ section.settings.hero_text | default: 'Unlock 10% Off Your First Purchase Plus More Rewards And Benefits' }}</p>
        {% if section.settings.hero_button_url != blank %}
          <a href="{{ section.settings.hero_button_url }}" class="footer-blacro__hero-button">
            <span>{{ section.settings.hero_button_label | default: 'SIGN UP' }}</span>
            <svg class="footer-blacro__button-arrow" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
      
      <div class="footer-blacro__hero-links">
        <div class="footer-blacro__block">
          <p class="footer-blacro__block-title footer-blacro__block-title--preset-{{ section.settings.footer_title_font }}">Company</p>
          {% if company_menu != blank and company_menu.links.size > 0 %}
            <ul class="footer-blacro__link-list">
              {% for link in company_menu.links %}
                <li><a href="{{ link.url }}" class="footer-blacro__link--preset-{{ section.settings.footer_links_font }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-blacro__hint">Add a Company menu in section settings.</p>
          {% endif %}
        </div>

        <div class="footer-blacro__block footer-blacro__social-block">
          <p class="footer-blacro__block-title footer-blacro__block-title--preset-{{ section.settings.footer_title_font }}">Social</p>
          <div class="footer-blacro__social-list">
            {%- if instagram_url != blank -%}
              <a href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" class="footer-blacro__social-link" aria-label="Instagram">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  {%- render 'icon', icon: 'instagram' -%}
                </svg>
              </a>
            {%- endif -%}
            {%- if facebook_url != blank -%}
              <a href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer" class="footer-blacro__social-link" aria-label="Facebook">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  {%- render 'icon', icon: 'facebook' -%}
                </svg>
              </a>
            {%- endif -%}
            {%- if linkedin_url != blank -%}
              <a href="{{ linkedin_url }}" target="_blank" rel="noopener noreferrer" class="footer-blacro__social-link" aria-label="LinkedIn">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  {%- render 'icon', icon: 'linkedin' -%}
                </svg>
              </a>
            {%- endif -%}
            {%- if whatsapp_url != blank -%}
              <a href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer" class="footer-blacro__social-link" aria-label="WhatsApp">
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  {%- render 'icon', icon: 'whatsapp' -%}
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <!-- Giant brand watermark / Big logo -->
    <div class="footer-blacro__large-brand-wrapper">
      {% if section.settings.brand_logo_bottom != blank %}
        <div class="footer-blacro__large-brand-logo-container" style="max-width: {{ section.settings.brand_logo_bottom_width }}px; margin: 0 auto; position: relative;">
          <!-- Front Logo -->
          <img 
            src="{{ section.settings.brand_logo_bottom | image_url: width: 1400 }}" 
            alt="{{ shop.name }} Large Logo"
            class="footer-blacro__large-brand-logo footer-blacro__large-brand-logo--front"
            style="display: block; width: 100%; height: auto;"
            loading="lazy"
            width="{{ section.settings.brand_logo_bottom.width }}"
            height="{{ section.settings.brand_logo_bottom.height }}"
          >
          <!-- Back Logo (Pre-flipped on Y-axis) -->
          <img 
            src="{{ section.settings.brand_logo_bottom | image_url: width: 1400 }}" 
            alt="{{ shop.name }} Large Logo"
            class="footer-blacro__large-brand-logo footer-blacro__large-brand-logo--back"
            style="display: block; width: 100%; height: auto;"
            loading="lazy"
            width="{{ section.settings.brand_logo_bottom.width }}"
            height="{{ section.settings.brand_logo_bottom.height }}"
          >
        </div>
      {% else %}
        <span class="footer-blacro__large-brand">{{ brand_name }}</span>
      {% endif %}
    </div>

    <div class="footer-blacro__bottom">
      <div class="footer-blacro__policies">
        {% if policy_menu != blank and policy_menu.links.size > 0 %}
          {% for link in policy_menu.links %}
            <a href="{{ link.url }}" class="footer-blacro__link--preset-{{ section.settings.footer_links_font }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <span class="footer-blacro__hint">Add a Policies menu in section settings.</span>
        {% endif %}
      </div>
      <div class="footer-blacro__copyright">
        <span>© {{ 'now' | date: '%Y' }} {{ brand_name }}. All rights reserved.</span>
      </div>
    </div>
  </div>
</div>


{% stylesheet %}
  .footer-blacro {
    position: relative;
    color: var(--color-foreground);
    overflow: hidden;
    /* Premium subtle radial glow */
    background: radial-gradient(circle at 80% 20%, rgba(var(--color-foreground-rgb), 0.02), transparent 60%), var(--gradient-background);
  }

  /* Fade-in/out on viewport intersection */
  .footer-blacro--animated {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro--animated.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .footer-blacro__container {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 2rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-blacro__hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .footer-blacro__hero-copy {
    max-width: 540px;
  }

  .footer-blacro__eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
    opacity: 0.5;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .footer-blacro__headline {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-transform: none;
  }

  .footer-blacro__text {
    margin: 0 0 2rem;
    color: var(--color-foreground);
    opacity: 0.65;
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 480px;
  }

  /* Premium sleek pill CTA button with arrow transition */
  .footer-blacro__hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    color: var(--color-foreground);
    background: transparent;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__hero-button .footer-blacro__button-arrow {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__hero-button:hover {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .footer-blacro__hero-button:hover .footer-blacro__button-arrow {
    transform: translateX(4px);
  }

  /* 2-column link layout (Company & Social) */
  .footer-blacro__hero-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  .footer-blacro__block-title {
    margin: 0 0 1.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 1;
  }

  .footer-blacro__link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .footer-blacro__link-list a {
    display: inline-block;
    color: var(--color-foreground);
    opacity: 0.7;
    text-decoration: none;
    font-size: 0.95rem;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left;
  }

  /* Sibling Fade Effect for Link List */
  .footer-blacro__link-list:hover a {
    opacity: 0.35;
  }

  .footer-blacro__link-list a:hover {
    opacity: 1;
    transform: translateX(4px);
  }

  .footer-blacro__social-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-blacro__social-note {
    margin: 0 0 0.5rem;
    color: var(--color-foreground);
    opacity: 0.65;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .footer-blacro__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-blacro__social-link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.12);
    background: transparent;
    color: var(--color-foreground);
    transition: border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sibling Fade Effect for Socials */
  .footer-blacro__social-list:hover .footer-blacro__social-link {
    opacity: 0.4;
  }

  .footer-blacro__social-link:hover {
    opacity: 1 !important;
    border-color: var(--color-foreground);
    background: rgba(var(--color-foreground-rgb), 0.04);
    transform: translateY(-2px);
  }

  /* Giant brand watermark footer element */
  .footer-blacro__large-brand-wrapper {
    margin-block-start: 2rem;
    margin-block-end: 1rem;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    padding-block-start: 1rem;
    perspective: 1200px;
  }

  .footer-blacro__large-brand {
    display: block;
    text-align: center;
    font-size: clamp(3rem, 12.5vw, 11rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.05;
  }

  .footer-blacro__brand-logo-wrapper {
    margin-bottom: 1.5rem;
  }

  .footer-blacro__brand-logo {
    display: block;
    height: auto;
  }

  @keyframes footerLogoSpin {
    from {
      transform: rotateY(0deg);
    }
    to {
      transform: rotateY(360deg);
    }
  }

  .footer-blacro__large-brand-logo-container {
    display: block;
    position: relative;
    transform-style: preserve-3d;
    animation: footerLogoSpin 12s linear infinite;
    transform-origin: center;
  }

  .footer-blacro__large-brand-logo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 1 !important;
    filter: none !important;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .footer-blacro__large-brand-logo--front {
    position: relative;
    z-index: 5;
    transform: rotateY(0deg);
  }

  .footer-blacro__large-brand-logo--back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
    transform: rotateY(180deg);
  }

  .footer-blacro__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.08);
    padding-top: 2rem;
  }

  .footer-blacro__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
  }

  .footer-blacro__policies a {
    color: var(--color-foreground);
    opacity: 0.6;
    font-size: 0.85rem;
    text-decoration: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sibling Fade Effect for Policies */
  .footer-blacro__policies:hover a {
    opacity: 0.35;
  }

  .footer-blacro__policies a:hover {
    opacity: 1;
  }

  .footer-blacro__copyright {
    color: var(--color-foreground);
    opacity: 0.4;
    font-size: 0.85rem;
  }

  .footer-blacro__hint {
    color: rgba(var(--color-foreground-rgb), 0.6);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 980px) {
    .footer-blacro__hero {
      gap: 3rem;
    }
  }

  @media screen and (max-width: 768px) {
    .footer-blacro__hero {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-blacro__hero-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer-blacro__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    .footer-blacro__policies {
      justify-content: center;
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 480px) {
    .footer-blacro__hero-links {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
{% endstylesheet %}


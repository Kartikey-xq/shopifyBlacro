{% comment %}
  Premium Footer section for BLACRO
  Fully customizer-controllable spacings, fonts, and split settings.
  Monospaced, uppercase premium styling.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --footer-header-color: {{ section.settings.footer_header_color }};
    --footer-link-color: {{ section.settings.footer_link_color }};
    --footer-divider-text-color: {{ section.settings.footer_divider_text_color }};
  }

  #BlacroFooter-{{ section.id }} {
    background-color: var(--footer-bg);
    color: #ffffff;
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__top-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--ph);
    padding-right: var(--ph);
  }

  @media screen and (min-width: 769px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__top-container {
      padding-left: var(--ph-desktop);
      padding-right: var(--ph-desktop);
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--header-mb);
    width: 100%;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__logo-wrap {
    transform: translateX(var(--logo-x-offset));
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__logo-wrap img {
    height: auto;
    object-fit: contain;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__logo-text {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: var(--ls);
    text-transform: uppercase;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__bird-wrap img {
    height: auto;
    object-fit: contain;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__bird-placeholder {
    display: block;
    color: #ffffff;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--group-gap);
    width: 100%;
  }

  @media screen and (max-width: 980px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group {
    display: flex;
    flex-direction: column;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group-label {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-labels);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: var(--footer-header-color);
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group-content {
    display: flex;
    flex-direction: column;
    gap: var(--link-gap);
    align-items: flex-start;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-links);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--footer-link-color);
    opacity: 1;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.3s ease;
    text-align: left;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link:hover {
    opacity: 0.6;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link .bracket {
    color: #555555;
    margin-right: 4px;
    margin-left: 4px;
    font-weight: normal;
    transition: color 0.3s ease;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link:hover .bracket {
    color: #ffffff;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__divider {
    border: 0;
    border-top: 1px solid #222222;
    margin-top: 48px;
    margin-bottom: 0;
    width: 100%;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__copyright {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-copyright);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: #888888;
    text-align: center;
    line-height: 1.5;
    width: 100%;
    padding-top: {{ section.settings.copyright_padding_top }}px;
    padding-bottom: {{ section.settings.copyright_padding_bottom }}px;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--split-gap);
    width: 100%;
    background-color: var(--footer-bg);
    height: var(--split-height-mobile);
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-half {
    position: relative;
    overflow: hidden;
    height: 100%;
    width: 100%;
  }

  @media screen and (min-width: 769px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__split {
      height: var(--split-height);
    }
  }

  #BlacroFooter-{{ section.id }} .split-gallery-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;
  }

  #BlacroFooter-{{ section.id }} .split-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--split-overlay-color, #000000);
    z-index: 2;
    opacity: 1;
    pointer-events: none;
  }

  #BlacroFooter-{{ section.id }} .split-overlay.is-revealed {
    opacity: 0;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row {
    width: 100vw;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    box-sizing: border-box;
    border-top: {{ section.settings.footer_row_line_thickness }}px solid {{ section.settings.footer_row_top_line_color }};
    border-bottom: {{ section.settings.footer_row_line_thickness }}px solid {{ section.settings.footer_row_bottom_line_color }};
    padding-top: {{ section.settings.footer_row_padding_top }}px;
    padding-bottom: {{ section.settings.footer_row_padding_bottom }}px;
    margin-top: 48px;
    margin-bottom: 0;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding-left: var(--ph);
    padding-right: var(--ph);
    box-sizing: border-box;
  }

  @media screen and (min-width: 769px) {
    #BlacroFooter-{{ section.id }} .footer-badge-row__inner {
      padding-left: var(--ph-desktop);
      padding-right: var(--ph-desktop);
    }
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__col {
    flex: 1;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__col--left {
    justify-content: flex-start;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__col--center {
    justify-content: center;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__col--right {
    justify-content: flex-end;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__text {
    font-family: inherit;
    font-size: var(--fs-links);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: var(--footer-divider-text-color);
    white-space: nowrap;
  }

  #BlacroFooter-{{ section.id }} .footer-badge-row__image {
    height: auto;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 749px) {
    #BlacroFooter-{{ section.id }} .footer-badge-row {
      margin-top: 32px;
      margin-bottom: 0;
    }
    #BlacroFooter-{{ section.id }} .footer-badge-row__inner {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    #BlacroFooter-{{ section.id }} .footer-badge-row__image {
      max-width: calc({{ section.settings.footer_row_image_max_width }}px * 0.75) !important;
    }
    #BlacroFooter-{{ section.id }} .footer-badge-row__text {
      font-size: max(9px, calc(var(--fs-links) * 0.8));
    }
  }
</style>

<div 
  class="blacro-footer" 
  id="BlacroFooter-{{ section.id }}"
  style="
    --pt: {{ section.settings.section_padding_top }}px;
    --pb: {{ section.settings.section_padding_bottom }}px;
    --ph: {{ section.settings.section_padding_horizontal }}px;
    --ph-desktop: {{ section.settings.section_padding_horizontal_desktop }}px;
    --group-gap: {{ section.settings.group_gap }}px;
    --link-gap: {{ section.settings.link_gap }}px;
    --header-mb: {{ section.settings.header_margin_bottom }}px;
    --split-height: {{ section.settings.split_section_height }}px;
    --split-height-mobile: {{ section.settings.split_height_mobile }}px;
    --split-gap: {{ section.settings.split_gap }}px;
    --footer-bg: {{ section.settings.footer_bg_color }};
    --logo-x-offset: {{ section.settings.brand_logo_x_offset | default: 0 }}px;
    --fs-links: {{ section.settings.font_size_links }}px;
    --fs-labels: {{ section.settings.font_size_labels }}px;
    --fs-copyright: {{ section.settings.font_size_copyright }}px;
    --ls: {{ section.settings.letter_spacing }}px;
    --split-overlay-color: {{ section.settings.split_overlay_color }};
    --split-duration: {{ section.settings.split_display_duration }}s;
  "
>
  <div class="blacro-footer__top-container">
    
    <!-- HEADER ROW -->
    <div class="blacro-footer__header">
      <div class="blacro-footer__logo-wrap">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: 300 }}" 
            alt="{{ shop.name }}" 
            loading="lazy" 
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            style="width: {{ section.settings.brand_logo_width | default: 160 }}px; height: auto;"
          >
        {%- else -%}
          <span class="blacro-footer__logo-text">BLACRO</span>
        {%- endif -%}
      </div>
      <div class="blacro-footer__bird-wrap">
        {%- if section.settings.brand_icon != blank -%}
          <img 
            src="{{ section.settings.brand_icon | image_url: width: 100 }}" 
            alt="Brand Icon" 
            loading="lazy"
            width="{{ section.settings.brand_icon.width }}"
            height="{{ section.settings.brand_icon.height }}"
            style="width: {{ section.settings.brand_icon_width | default: 80 }}px; height: auto;"
          >
        {%- else -%}
          <svg class="blacro-footer__bird-placeholder" viewBox="0 0 100 100" width="40" height="40" fill="none" stroke="#ffffff" stroke-width="1.5">
            <path d="M10 50 C 30 35, 45 45, 50 60 C 55 45, 70 35, 90 50 C 70 55, 55 55, 50 65 C 45 55, 30 55, 10 50 Z" />
          </svg>
        {%- endif -%}
      </div>
    </div>

    <!-- LINK GROUPS -->
    <div class="blacro-footer__grid">
      
      <!-- NAVIGATION group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">NAVIGATION</h3>
        <div class="blacro-footer__group-content">
          {%- for link in linklists[section.settings.nav_menu].links -%}
            <a class="blacro-footer__link" href="{{ link.url }}">
              <span class="bracket">[</span> <span class="link-text">{{ link.title | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endfor -%}
        </div>
      </div>

      <!-- EMAIL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">EMAIL</h3>
        <div class="blacro-footer__group-content">
          {%- if section.settings.email != blank -%}
            <a class="blacro-footer__link" href="mailto:{{ section.settings.email }}">
              <span class="bracket">[</span> <span class="link-text">{{ section.settings.email | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- SOCIAL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">SOCIAL</h3>
        <div class="blacro-footer__group-content">
          {%- if section.settings.use_shop_social_links -%}
            {%- assign platforms = "instagram,facebook,linkedin,twitter,youtube,tiktok,pinterest,snapchat,tumblr,vimeo" | split: "," -%}
            {%- for platform in platforms -%}
              {%- assign prop = "social_" | append: platform | append: "_link" -%}
              {%- if settings[prop] != blank -%}
                <a class="blacro-footer__link" href="{{ settings[prop] }}">
                  <span class="bracket">[</span> <span class="link-text">{{ platform | replace: "_", " " | upcase }}</span> <span class="bracket">]</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_link' -%}
                {%- if block.settings.label != blank and block.settings.url != blank -%}
                  <a class="blacro-footer__link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                    <span class="bracket">[</span> <span class="link-text">{{ block.settings.label | upcase }}</span> <span class="bracket">]</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- LEGAL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">LEGAL</h3>
        <div class="blacro-footer__group-content">
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <a class="blacro-footer__link" href="{{ link.url }}">
              <span class="bracket">[</span> <span class="link-text">{{ link.title | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endfor -%}
        </div>
      </div>

    </div>

    {%- if section.settings.footer_row_text_left != blank or section.settings.footer_row_image_center != blank or section.settings.footer_row_text_right != blank -%}
      <div class="footer-badge-row" style="border-top: {{ section.settings.footer_row_line_thickness }}px solid {{ section.settings.footer_row_top_line_color }}; border-bottom: {{ section.settings.footer_row_line_thickness }}px solid {{ section.settings.footer_row_bottom_line_color }};">
        <div class="footer-badge-row__inner">
          <div class="footer-badge-row__col footer-badge-row__col--left">
            {%- if section.settings.footer_row_text_left != blank -%}
              <span class="footer-badge-row__text">{{ section.settings.footer_row_text_left }}</span>
            {%- else -%}
              <span></span>
            {%- endif -%}
          </div>
          <div class="footer-badge-row__col footer-badge-row__col--center">
            {%- if section.settings.footer_row_image_center != blank -%}
              <img 
                src="{{ section.settings.footer_row_image_center | image_url: width: 200 }}" 
                alt="{{ section.settings.footer_row_image_center.alt | escape }}" 
                loading="lazy" 
                width="{{ section.settings.footer_row_image_center.width }}"
                height="{{ section.settings.footer_row_image_center.height }}"
                class="footer-badge-row__image"
                style="max-width: {{ section.settings.footer_row_image_max_width }}px;"
              >
            {%- else -%}
              <span></span>
            {%- endif -%}
          </div>
          <div class="footer-badge-row__col footer-badge-row__col--right">
            {%- if section.settings.footer_row_text_right != blank -%}
              <span class="footer-badge-row__text">{{ section.settings.footer_row_text_right }}</span>
            {%- else -%}
              <span></span>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- COPYRIGHT BAR -->
    {%- unless section.settings.footer_row_text_left != blank or section.settings.footer_row_image_center != blank or section.settings.footer_row_text_right != blank -%}
      <hr class="blacro-footer__divider">
    {%- endunless -%}
    <div class="blacro-footer__copyright">
      {{ section.settings.copyright_text | upcase }}
    </div>

  </div>

  {%- assign image_urls = "" -%}
  {%- for i in (1..5) -%}
    {%- assign img_key = 'split_image_' | append: i -%}
    {%- assign img = section.settings[img_key] -%}
    {%- if img != blank -%}
      {%- if image_urls != "" -%}{%- assign image_urls = image_urls | append: "," -%}{%- endif -%}
      {%- assign img_url = img | image_url: width: 1200 -%}
      {%- assign image_urls = image_urls | append: img_url -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if image_urls == "" and section.settings.logo != blank -%}
    {%- assign image_urls = section.settings.logo | image_url: width: 1200 -%}
  {%- endif -%}

  {%- assign image_list = image_urls | split: "," -%}

  {%- comment -%} Preload all split gallery images {%- endcomment -%}
  {%- for img_url in image_list -%}
    {%- if img_url != blank -%}
      <link rel="preload" as="image" href="{{ img_url }}">
    {%- endif -%}
  {%- endfor -%}

  <!-- 50/50 SPLIT SECTION -->
  <div 
    class="blacro-footer__split"
    id="BlacroFooterSplit-{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-slide-duration="{{ section.settings.split_display_duration }}"
    data-images='{{ image_list | json }}'
  >
    <!-- Left Half -->
    <div class="blacro-footer__split-half blacro-footer__split-half--left">
      <div class="split-gallery-bg"></div>
      <div class="split-overlay"></div>
    </div>

    <!-- Right Half -->
    <div class="blacro-footer__split-half blacro-footer__split-half--right">
      <div class="split-gallery-bg"></div>
      <div class="split-overlay"></div>
    </div>
  </div>

  <script>
  (function() {
    function initGallery(sectionContainer) {
      const splitContainer = sectionContainer.querySelector('.blacro-footer__split');
      if (!splitContainer) return;

      const imagesJson = splitContainer.getAttribute('data-images');
      if (!imagesJson) return;

      let images = [];
      try {
        images = JSON.parse(imagesJson);
      } catch(e) {
        console.error("Failed to parse gallery images", e);
        return;
      }

      if (images.length === 0) return;

      const autoplay = splitContainer.getAttribute('data-autoplay') === 'true';
      const duration = parseFloat(splitContainer.getAttribute('data-slide-duration')) * 1000;

      const leftBg = splitContainer.querySelector('.blacro-footer__split-half--left .split-gallery-bg');
      const rightBg = splitContainer.querySelector('.blacro-footer__split-half--right .split-gallery-bg');
      const leftOverlay = splitContainer.querySelector('.blacro-footer__split-half--left .split-overlay');
      const rightOverlay = splitContainer.querySelector('.blacro-footer__split-half--right .split-overlay');

      if (!leftBg || !rightBg || !leftOverlay || !rightOverlay) return;

      let rightIndex = 0;
      let leftIndex = 0;
      let isStepA = true;

      function renderStep() {
        if (isStepA) {
          const rightImg = images[rightIndex % images.length];
          rightBg.style.backgroundImage = `url("${rightImg}")`;
          
          leftOverlay.classList.remove('is-revealed');
          rightOverlay.classList.add('is-revealed');
        } else {
          const leftImg = images[(leftIndex + 1) % images.length];
          leftBg.style.backgroundImage = `url("${leftImg}")`;
          
          leftOverlay.classList.add('is-revealed');
          rightOverlay.classList.remove('is-revealed');
        }
      }

      // Initial render
      renderStep();

      if (images.length === 0 || duration <= 0) return;

      function nextStep() {
        if (isStepA) {
          leftIndex = rightIndex;
          isStepA = false;
        } else {
          rightIndex = (rightIndex + 2) % images.length;
          isStepA = true;
        }
        renderStep();
      }

      function startTimer() {
        if (!autoplay) return;
        stopTimer();
        splitContainer.galleryTimer = setInterval(nextStep, duration);
      }

      function stopTimer() {
        if (splitContainer.galleryTimer) {
          clearInterval(splitContainer.galleryTimer);
          splitContainer.galleryTimer = null;
        }
      }

      // Stop existing timers if any
      if (splitContainer.galleryTimer) {
        clearInterval(splitContainer.galleryTimer);
      }

      startTimer();

      // Pause on hover
      splitContainer.addEventListener('mouseenter', stopTimer);
      splitContainer.addEventListener('mouseleave', startTimer);
    }

    // Hook Shopify theme editor events
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}' || event.target.querySelector('#BlacroFooterSplit-{{ section.id }}')) {
        const section = event.target.classList.contains('shopify-section') ? event.target : event.target.closest('.shopify-section');
        if (section) {
          initGallery(section);
        }
      }
    });

    // Regular page load
    function init() {
      const section = document.querySelector('#shopify-section-{{ section.id }}');
      if (section) {
        initGallery(section);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
</div>

{% schema %}
{
  "name": "BLACRO Premium Footer",
  "tag": "footer",
  "class": "section-footer-blacro",
  "settings": [
    {
      "type": "header",
      "content": "Brand Identity (Header Row)"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand Logo (Left)"
    },
    {
      "type": "image_picker",
      "id": "brand_icon",
      "label": "Brand Icon / Bird (Right)"
    },
    {
      "type": "header",
      "content": "Footer Top Row — Logo Sizes"
    },
    {
      "type": "range",
      "id": "brand_logo_width",
      "min": 80,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 160,
      "label": "Brand logo width"
    },
    {
      "type": "range",
      "id": "brand_logo_x_offset",
      "min": -80,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Brand logo horizontal offset"
    },
    {
      "type": "range",
      "id": "brand_icon_width",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80,
      "label": "Brand icon width"
    },
    {
      "type": "header",
      "content": "Footer Link Group Settings"
    },
    {
      "type": "link_list",

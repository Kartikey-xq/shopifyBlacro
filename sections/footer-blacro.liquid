{% comment %}
  Premium Footer section for BLACRO
  Fully customizer-controllable spacings, fonts, and split settings.
  Monospaced, uppercase premium styling.
{% endcomment %}

<style>
  #BlacroFooter-{{ section.id }} {
    background-color: var(--footer-bg);
    color: #ffffff;
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__top-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--ph);
    padding-right: var(--ph);
  }

  @media screen and (min-width: 769px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__top-container {
      padding-left: var(--ph-desktop);
      padding-right: var(--ph-desktop);
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--header-mb);
    width: 100%;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__logo-wrap img {
    height: auto;
    object-fit: contain;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__logo-text {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: var(--ls);
    text-transform: uppercase;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__bird-wrap img {
    height: auto;
    object-fit: contain;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__bird-placeholder {
    display: block;
    color: #ffffff;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--group-gap);
    width: 100%;
  }

  @media screen and (max-width: 980px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group {
    display: flex;
    flex-direction: column;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group-label {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-labels);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: #888888;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__group-content {
    display: flex;
    flex-direction: column;
    gap: var(--link-gap);
    align-items: flex-start;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-links);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    opacity: 1;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.3s ease;
    text-align: left;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link:hover {
    opacity: 0.6;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link .bracket {
    color: #555555;
    margin-right: 4px;
    margin-left: 4px;
    font-weight: normal;
    transition: color 0.3s ease;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__link:hover .bracket {
    color: #ffffff;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__divider {
    border: 0;
    border-top: 1px solid #222222;
    margin-top: 48px;
    margin-bottom: 0;
    width: 100%;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__copyright {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: var(--fs-copyright);
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: #888888;
    text-align: center;
    line-height: 1.5;
    width: 100%;
    padding-top: var(--copyright-pt);
    padding-bottom: var(--copyright-pb);
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--split-gap);
    width: 100%;
    background-color: var(--footer-bg);
    height: var(--split-height-mobile);
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-half {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  @media screen and (min-width: 769px) {
    #BlacroFooter-{{ section.id }} .blacro-footer__split {
      height: var(--split-height);
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-video-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #BlacroFooter-{{ section.id }} iframe.blacro-footer__video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    transform: translate(-50%, -50%);
    border: none;
  }

  /* Make sure video iframe covers the container on larger screen width */
  @media screen and (min-aspect-ratio: 16/9) {
    #BlacroFooter-{{ section.id }} iframe.blacro-footer__video {
      height: 56.25vw;
    }
  }
  @media screen and (max-aspect-ratio: 16/9) {
    #BlacroFooter-{{ section.id }} iframe.blacro-footer__video {
      width: 177.77vh;
    }
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-img-wrap {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--footer-bg);
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-img-wrap--logo {
    padding: var(--split-logo-pv) var(--split-logo-ph);
    box-sizing: border-box;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #BlacroFooter-{{ section.id }} .blacro-footer__split-logo-text {
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 900;
    letter-spacing: var(--ls);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.08);
    user-select: none;
  }
</style>

<div 
  class="blacro-footer" 
  id="BlacroFooter-{{ section.id }}"
  style="
    --pt: {{ section.settings.section_padding_top }}px;
    --pb: {{ section.settings.section_padding_bottom }}px;
    --ph: {{ section.settings.section_padding_horizontal }}px;
    --ph-desktop: {{ section.settings.section_padding_horizontal_desktop }}px;
    --group-gap: {{ section.settings.group_gap }}px;
    --link-gap: {{ section.settings.link_gap }}px;
    --header-mb: {{ section.settings.header_margin_bottom }}px;
    --copyright-pt: {{ section.settings.copyright_padding_top }}px;
    --copyright-pb: {{ section.settings.copyright_padding_bottom }}px;
    --split-height: {{ section.settings.split_section_height }}px;
    --split-height-mobile: {{ section.settings.split_height_mobile }}px;
    --split-gap: {{ section.settings.split_gap }}px;
    --split-logo-ph: {{ section.settings.split_logo_padding_horizontal }}%;
    --split-logo-pv: {{ section.settings.split_logo_padding_vertical }}%;
    --footer-bg: {{ section.settings.footer_bg_color }};
    --fs-links: {{ section.settings.font_size_links }}px;
    --fs-labels: {{ section.settings.font_size_labels }}px;
    --fs-copyright: {{ section.settings.font_size_copyright }}px;
    --ls: {{ section.settings.letter_spacing }}px;
  "
>
  <div class="blacro-footer__top-container">
    
    <!-- HEADER ROW -->
    <div class="blacro-footer__header">
      <div class="blacro-footer__logo-wrap">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: 300 }}" 
            alt="{{ shop.name }}" 
            loading="lazy" 
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            style="width: {{ section.settings.brand_logo_width | default: 160 }}px; height: auto;"
          >
        {%- else -%}
          <span class="blacro-footer__logo-text">BLACRO</span>
        {%- endif -%}
      </div>
      <div class="blacro-footer__bird-wrap">
        {%- if section.settings.brand_icon != blank -%}
          <img 
            src="{{ section.settings.brand_icon | image_url: width: 100 }}" 
            alt="Brand Icon" 
            loading="lazy"
            width="{{ section.settings.brand_icon.width }}"
            height="{{ section.settings.brand_icon.height }}"
            style="width: {{ section.settings.brand_icon_width | default: 80 }}px; height: auto;"
          >
        {%- else -%}
          <svg class="blacro-footer__bird-placeholder" viewBox="0 0 100 100" width="40" height="40" fill="none" stroke="#ffffff" stroke-width="1.5">
            <path d="M10 50 C 30 35, 45 45, 50 60 C 55 45, 70 35, 90 50 C 70 55, 55 55, 50 65 C 45 55, 30 55, 10 50 Z" />
          </svg>
        {%- endif -%}
      </div>
    </div>

    <!-- LINK GROUPS -->
    <div class="blacro-footer__grid">
      
      <!-- NAVIGATION group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">NAVIGATION</h3>
        <div class="blacro-footer__group-content">
          {%- for link in linklists[section.settings.nav_menu].links -%}
            <a class="blacro-footer__link" href="{{ link.url }}">
              <span class="bracket">[</span> <span class="link-text">{{ link.title | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endfor -%}
        </div>
      </div>

      <!-- EMAIL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">EMAIL</h3>
        <div class="blacro-footer__group-content">
          {%- if section.settings.email != blank -%}
            <a class="blacro-footer__link" href="mailto:{{ section.settings.email }}">
              <span class="bracket">[</span> <span class="link-text">{{ section.settings.email | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- SOCIAL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">SOCIAL</h3>
        <div class="blacro-footer__group-content">
          {%- if section.settings.use_shop_social_links -%}
            {%- assign platforms = "instagram,facebook,linkedin,twitter,youtube,tiktok,pinterest,snapchat,tumblr,vimeo" | split: "," -%}
            {%- for platform in platforms -%}
              {%- assign prop = "social_" | append: platform | append: "_link" -%}
              {%- if settings[prop] != blank -%}
                <a class="blacro-footer__link" href="{{ settings[prop] }}">
                  <span class="bracket">[</span> <span class="link-text">{{ platform | replace: "_", " " | upcase }}</span> <span class="bracket">]</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_link' -%}
                {%- if block.settings.label != blank and block.settings.url != blank -%}
                  <a class="blacro-footer__link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                    <span class="bracket">[</span> <span class="link-text">{{ block.settings.label | upcase }}</span> <span class="bracket">]</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- LEGAL group -->
      <div class="blacro-footer__group">
        <h3 class="blacro-footer__group-label">LEGAL</h3>
        <div class="blacro-footer__group-content">
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <a class="blacro-footer__link" href="{{ link.url }}">
              <span class="bracket">[</span> <span class="link-text">{{ link.title | upcase }}</span> <span class="bracket">]</span>
            </a>
          {%- endfor -%}
        </div>
      </div>

    </div>

    <!-- COPYRIGHT BAR -->
    <hr class="blacro-footer__divider">
    <div class="blacro-footer__copyright">
      {{ section.settings.copyright_text | upcase }}
    </div>

  </div>

  <!-- 50/50 SPLIT SECTION -->
  <div class="blacro-footer__split">
    
    <!-- Left Half: Video -->
    <div class="blacro-footer__split-half">
      {%- if section.settings.split_video != blank -%}
        <div class="blacro-footer__split-video-wrap">
          {{ section.settings.split_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: "blacro-footer__video" }}
        </div>
      {%- elsif section.settings.split_video_url != blank -%}
        <div class="blacro-footer__split-video-wrap">
          {%- if section.settings.split_video_url.type == 'youtube' -%}
            <iframe 
              class="blacro-footer__video" 
              src="https://www.youtube.com/embed/{{ section.settings.split_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.split_video_url.id }}&controls=0&showinfo=0&rel=0&playsinline=1" 
              allow="autoplay; encrypted-media" 
              allowfullscreen
            ></iframe>
          {%- elsif section.settings.split_video_url.type == 'vimeo' -%}
            <iframe 
              class="blacro-footer__video" 
              src="https://player.vimeo.com/video/{{ section.settings.split_video_url.id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1" 
              allow="autoplay; fullscreen" 
              allowfullscreen
            ></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="blacro-footer__split-img-wrap" style="background-color: var(--footer-bg);">
          <span class="blacro-footer__split-logo-text">BREED APART</span>
        </div>
      {%- endif -%}
    </div>

    <!-- Right Half: Image -->
    <div class="blacro-footer__split-half">
      <div class="blacro-footer__split-img-wrap{% if section.settings.split_image == blank and section.settings.logo != blank %} blacro-footer__split-img-wrap--logo{% endif %}">
        {%- if section.settings.split_image != blank -%}
          <img 
            class="blacro-footer__split-img" 
            src="{{ section.settings.split_image | image_url: width: 1200 }}" 
            alt="BLACRO Campaign" 
            loading="lazy"
            width="{{ section.settings.split_image.width }}"
            height="{{ section.settings.split_image.height }}"
          >
        {%- elsif section.settings.logo != blank -%}
          <img 
            class="blacro-footer__split-logo-img" 
            src="{{ section.settings.logo | image_url: width: 600 }}" 
            alt="{{ shop.name }} Logo" 
            loading="lazy"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        {%- else -%}
          <span class="blacro-footer__split-logo-text">BLACRO</span>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "BLACRO Premium Footer",
  "tag": "footer",
  "class": "section-footer-blacro",
  "settings": [
    {
      "type": "header",
      "content": "Brand Identity (Header Row)"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand Logo (Left)"
    },
    {
      "type": "image_picker",
      "id": "brand_icon",
      "label": "Brand Icon / Bird (Right)"
    },
    {
      "type": "header",
      "content": "Footer Top Row — Logo Sizes"
    },
    {
      "type": "range",
      "id": "brand_logo_width",
      "min": 80,
      "max": 400,
      "step": 5,
      "unit": "px",
      "default": 160,
      "label": "Brand logo width"
    },
    {
      "type": "range",
      "id": "brand_icon_width",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 80,
      "label": "Brand icon width"
    },
    {
      "type": "header",
      "content": "Footer Link Group Settings"
    },
    {
      "type": "link_list",
      "id": "nav_menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "info@blacro.in"
    },
    {
      "type": "checkbox",
      "id": "use_shop_social_links",
      "label": "Use theme global social links",
      "default": true,
      "info": "If checked, social links are auto-pulled from Theme Settings. If unchecked, manually add social_link blocks."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "2026 BLACRO® BREED APART. ALL RIGHTS RESERVED."
    },
    {
      "type": "range",
      "id": "copyright_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Copyright row padding top"
    },
    {
      "type": "range",
      "id": "copyright_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Copyright row padding bottom"
    },
    {
      "type": "header",
      "content": "50/50 Split Bottom Section"
    },
    {
      "type": "video",
      "id": "split_video",
      "label": "Split native video",
      "info": "Upload a native video to Shopify. Takes priority over URL settings below."
    },
    {
      "type": "video_url",
      "id": "split_video_url",
      "label": "Split video URL (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"],
      "info": "Alternative video source URL."
    },
    {
      "type": "image_picker",
      "id": "split_image",
      "label": "Split image (Right half)",
      "info": "Defaults to brand logo if left blank."
    },
    {
      "type": "range",
      "id": "split_logo_padding_horizontal",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "%",
      "default": 15,
      "label": "Logo horizontal padding (% of panel)"
    },
    {
      "type": "range",
      "id": "split_logo_padding_vertical",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "%",
      "default": 15,
      "label": "Logo vertical padding (% of panel)"
    },
    {
      "type": "range",
      "id": "split_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Gap between video and logo panels"
    },
    {
      "type": "range",
      "id": "split_height_mobile",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 240,
      "label": "50/50 split height (mobile)"
    },
    {
      "type": "range",
      "id": "split_section_height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600,
      "label": "50/50 split height (desktop)"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "font_size_links",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "Link font size"
    },
    {
      "type": "range",
      "id": "font_size_labels",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Category label font size"
    },
    {
      "type": "range",
      "id": "font_size_copyright",
      "min": 8,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Copyright font size"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2,
      "label": "Letter spacing (all caps text)"
    },
    {
      "type": "header",
      "content": "Layout Padding & Spacing Settings"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "Section padding top"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "Section padding bottom"
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Horizontal padding (mobile)"
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "Horizontal padding (desktop)"
    },
    {
      "type": "range",
      "id": "group_gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Gap between link groups"
    },
    {
      "type": "range",
      "id": "link_gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Gap between links within a group"
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Logo row bottom spacing"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "footer_bg_color",
      "label": "Footer background color",
      "default": "#0a0a0a"

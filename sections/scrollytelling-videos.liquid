{% comment %}
  Scrollytelling Vertical Videos Section
  Inspired by Represent Clothing's home page layout.
{% endcomment %}

{% liquid
  assign text_color = section.settings.color_text
  assign text_color_active = section.settings.color_text_active
  assign bg_color = section.settings.color_bg
%}

<style>
  #Scrollytelling-{{ section.id }} {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background-color: {{ bg_color }};
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__scroll-container {
    height: 100%;
    width: 100%;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    /* Hide scrollbars */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE 10+ */
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__scroll-container::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__slide {
    position: relative;
    height: 100vh;
    width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    background-color: {{ bg_color }};
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__video {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__video-placeholder {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    color: {{ text_color }};
    opacity: 0.6;
    font-size: 1.25rem;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px dashed rgba(var(--color-foreground-rgb), 0.2);
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__sidebar {
    position: absolute;
    z-index: 10;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 500px;
    transition: all 0.4s ease;
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__sidebar--left {
    left: 8%;
    text-align: left;
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__sidebar--right {
    right: 8%;
    text-align: right;
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__text-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__text-item {
    color: {{ text_color }};
    opacity: 0.25;
    font-size: clamp(1.8rem, 3.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateX(-15px);
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__sidebar--right .scrollytelling__text-item {
    transform: translateX(15px);
  }

  #Scrollytelling-{{ section.id }} .scrollytelling__text-item.is-active {
    color: {{ text_color_active }};
    opacity: 1;
    transform: translateX(0);
    font-weight: 700;
  }

  @media screen and (max-width: 768px) {
    #Scrollytelling-{{ section.id }} .scrollytelling__sidebar {
      left: 6% !important;
      right: 6% !important;
      top: auto !important;
      bottom: 8% !important;
      transform: none !important;
      text-align: left !important;
      max-width: 100% !important;
    }

    #Scrollytelling-{{ section.id }} .scrollytelling__text-item {
      font-size: clamp(1.4rem, 6vw, 2.2rem) !important;
      transform: translateY(10px) !important;
    }

    #Scrollytelling-{{ section.id }} .scrollytelling__text-item.is-active {
      transform: translateY(0) !important;
    }
  }
</style>

<div class="scrollytelling" id="Scrollytelling-{{ section.id }}">
  
  <!-- Stationary Overlay Text Sidebar -->
  <div class="scrollytelling__sidebar scrollytelling__sidebar--{{ section.settings.sidebar_alignment }}">
    <div class="scrollytelling__text-list">
      {%- for block in section.blocks -%}
        <div 
          class="scrollytelling__text-item{% if forloop.first %} is-active{% endif %}" 
          data-index="{{ forloop.index0 }}" 
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.heading | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Scroll Container containing vertical videos -->
  <div class="scrollytelling__scroll-container">
    {%- for block in section.blocks -%}
      <div class="scrollytelling__slide" data-slide-index="{{ forloop.index0 }}">
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'scrollytelling__video' }}
        {%- else -%}
          <div class="scrollytelling__video-placeholder">
            <span>Slide {{ forloop.index }} Video Placeholder</span>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

</div>

<script>
  (function() {
    function init() {
      const section = document.getElementById('Scrollytelling-{{ section.id }}');
      if (!section) return;

      const scrollContainer = section.querySelector('.scrollytelling__scroll-container');
      const slides = section.querySelectorAll('.scrollytelling__slide');
      const textItems = section.querySelectorAll('.scrollytelling__text-item');

      if (!scrollContainer || slides.length === 0) return;

      const observerOptions = {
        root: scrollContainer,
        threshold: 0.6
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const index = entry.target.getAttribute('data-slide-index');

            // Highlight the active text element in the sidebar
            textItems.forEach(item => {
              if (item.getAttribute('data-index') === index) {
                item.classList.add('is-active');
              } else {
                item.classList.remove('is-active');
              }
            });

            // CPU/Performance Optimization: Play only active video, pause others
            const activeVideo = entry.target.querySelector('video');
            if (activeVideo) {
              activeVideo.play().catch(() => {});
            }

            slides.forEach(slide => {
              if (slide.getAttribute('data-slide-index') !== index) {
                const inactiveVideo = slide.querySelector('video');
                if (inactiveVideo) {
                  inactiveVideo.pause();
                }
              }
            });
          }
        });
      }, observerOptions);

      slides.forEach(slide => observer.observe(slide));

      // Save observer instance for clean up on unload
      section._scrollyObserver = observer;
    }

    // Initialize on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Handle Shopify Theme Editor events
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        init();
      }
    });

    document.addEventListener('shopify:section:unload', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        const sectionEl = document.getElementById('Scrollytelling-{{ section.id }}');
        if (sectionEl && sectionEl._scrollyObserver) {
          sectionEl._scrollyObserver.disconnect();
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Scrollytelling Videos",
  "tag": "section",
  "class": "section-scrollytelling-videos",
  "settings": [
    {
      "type": "color",
      "id": "color_bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Inactive Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_text_active",
      "label": "Active Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "sidebar_alignment",
      "label": "Sidebar Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted Video",
          "info": "Upload or select a vertical video."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "REPRESENT STREETWEAR"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Scrollytelling Videos",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "REPRESENT ORIGINALS"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "CRAFTED IN ENGLAND"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "STREETWEAR AESTHETIC"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "ESTABLISHED 2011"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Custom Collection Carousel with Hover Image
  Renders collection title and a responsive horizontal carousel of products.
  Supports manual title, price, image, hover image, and link overrides.
{% endcomment %}

{% liquid
  assign collection_title = section.settings.collection_title | default: section.settings.collection.title | default: 'Featured Collection'
  assign cleaned_collection_title = collection_title | remove: "━" | strip
  assign collection_url = section.settings.collection.url | default: '#'
  assign section_collection = section.settings.collection
  assign collection_products = section_collection.products
  assign title_animation = section.settings.title_animation | default: 'fade-up'
  assign title_animation_duration = section.settings.title_animation_duration | default: 700
  assign has_title_animation = true
  if title_animation == 'none' or title_animation == 'off'
    assign has_title_animation = false
  endif

  # Enforce uniform aspect ratio
  assign aspect_ratio = '3 / 4'
  case section.settings.image_ratio
    when 'square'
      assign aspect_ratio = '1 / 1'
    when 'portrait-alt'
      assign aspect_ratio = '4 / 5'
    when 'landscape'
      assign aspect_ratio = '16 / 9'
    when 'adapt'
      assign first_product = collection_products | first
      if first_product.featured_image != blank
        assign aspect_ratio = first_product.featured_image.aspect_ratio
      else
        assign aspect_ratio = '3 / 4'
      endif
  endcase
%}

{% style %}
  {% liquid
    assign cols_desktop = 4
    assign cols_tablet = 3
    assign cols_mobile = 2

    if section.settings.enable_carousel == false or section.settings.enable_carousel == nil
      assign desktop_cols = section.settings.grid_columns_desktop | plus: 0
      assign cols_desktop = desktop_cols
      
      if desktop_cols < 3
        assign cols_tablet = desktop_cols
      endif
      if desktop_cols < 2
        assign cols_mobile = desktop_cols
      endif
    endif

    assign desktop_image_height = 'auto'
    if section.settings.desktop_card_height == 'small'
      assign desktop_image_height = '280px'
    elsif section.settings.desktop_card_height == 'medium'
      assign desktop_image_height = '380px'
    elsif section.settings.desktop_card_height == 'large'
      assign desktop_image_height = '480px'
    elsif section.settings.desktop_card_height == 'custom'
      assign desktop_image_height = section.settings.desktop_card_custom_height | append: 'px'
    endif
  %}

  .section-collection-carousel-hover {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  #CollectionCarousel-{{ section.id }} {
    --carousel-gap: {{ section.settings.carousel_gap | default: 20 }}px;
    --carousel-padding-horizontal: {{ section.settings.padding_horizontal | default: 8 }}px;
    --cols-desktop: {{ cols_desktop }};
    --cols-tablet: {{ cols_tablet }};
    --cols-mobile: {{ cols_mobile }};
    --product-info-left-offset: {{ section.settings.product_info_left_offset | default: 0 }}px;
    --collection-carousel-aspect-ratio: {{ aspect_ratio }};
    --desktop-image-height: {{ desktop_image_height }};
    --quick-add-icon-color: {{ section.settings.quick_add_icon_color | default: '#ffffff' }};
    --grid-columns-desktop: {{ section.settings.grid_columns_desktop | default: 4 }};
    --mobile-grid-row-gap: {{ section.settings.mobile_grid_row_gap | default: 24 }}px;
    width: 100% !important;
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__quick-add-btn {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    color: var(--quick-add-icon-color) !important;
    transition: transform 0.2s ease, opacity 0.2s ease, color 0.2s ease !important;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__quick-add-btn::after {
    display: none !important;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__quick-add-btn:hover {
    transform: scale(1.05) !important;
    background-color: transparent !important;
    background: transparent !important;
    color: var(--quick-add-icon-color) !important;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__quick-add-btn.is-success {
    background-color: transparent !important;
    background: transparent !important;
    color: #10b981 !important;
    border: none !important;
    box-shadow: none !important;
  }
  #CollectionCarousel-{{ section.id }} .btn-spinner {
    border-color: rgba(255, 255, 255, 0.15) !important;
    border-top-color: currentColor !important;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__title-link {
    text-decoration: none;
    color: inherit;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__title-link:hover {
    text-decoration: underline;
  }
  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__card-link-overlay {
    z-index: 2 !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__header {
    margin-top: {{ section.settings.title_margin_top | default: 0 }}px !important;
    margin-bottom: {{ section.settings.title_margin_bottom | default: 30 }}px !important;
    justify-content: {% if section.settings.title_alignment == 'left' %}flex-start{% elsif section.settings.title_alignment == 'right' %}flex-end{% else %}center{% endif %} !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__title {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    width: 100% !important;
    justify-content: {% if section.settings.title_alignment == 'left' %}flex-start{% elsif section.settings.title_alignment == 'right' %}flex-end{% else %}center{% endif %} !important;
    {% if section.settings.collection_title_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-size: var(--font-paragraph--size, 1.6rem) !important;
      font-weight: var(--font-paragraph--weight, 400) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.collection_title_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-size: var(--font-subheading--size, 1.8rem) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.collection_title_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-size: var(--font-heading--size, 2rem) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.collection_title_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-size: var(--font-accent--size, 1.4rem) !important;
      font-weight: var(--font-accent--weight, 400) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% elsif section.settings.collection_title_font == 'custom' %}
      font-size: {{ section.settings.collection_title_custom_size }}px !important;
      {% if section.settings.collection_title_custom_font == 'body' %}
        font-family: var(--font-paragraph--family) !important;
        font-weight: var(--font-paragraph--weight, 400) !important;
        text-transform: var(--font-paragraph--case, none) !important;
      {% elsif section.settings.collection_title_custom_font == 'subheading' %}
        font-family: var(--font-subheading--family) !important;
        font-weight: var(--font-subheading--weight, 600) !important;
        text-transform: var(--font-subheading--case, none) !important;
      {% elsif section.settings.collection_title_custom_font == 'heading' %}
        font-family: var(--font-heading--family) !important;
        font-weight: var(--font-heading--weight, 700) !important;
        text-transform: var(--font-heading--case, none) !important;
      {% elsif section.settings.collection_title_custom_font == 'accent' %}
        font-family: var(--font-accent--family) !important;
        font-weight: var(--font-accent--weight, 400) !important;
        text-transform: var(--font-accent--case, none) !important;
      {% endif %}
    {% endif %}
  }

  {%- unless has_title_animation -%}
    #CollectionCarousel-{{ section.id }} .collection-hover-carousel__title {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  {%- endunless -%}

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__title-line {
    display: block !important;
    height: 1px !important;
    width: 40px !important;
    background-color: {{ section.settings.title_line_color | default: 'currentColor' }} !important;
    flex-shrink: 0 !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__product-title {
    {% if section.settings.title_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-size: var(--font-paragraph--size, 1.6rem) !important;
      font-weight: var(--font-paragraph--weight, 400) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.title_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-size: var(--font-subheading--size, 1.8rem) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.title_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-size: var(--font-heading--size, 2rem) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.title_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-size: var(--font-accent--size, 1.4rem) !important;
      font-weight: var(--font-accent--weight, 400) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% elsif section.settings.title_font == 'custom' %}
      font-size: {{ section.settings.title_custom_size }}px !important;
      {% if section.settings.title_custom_font == 'body' %}
        font-family: var(--font-paragraph--family) !important;
        font-weight: var(--font-paragraph--weight, 400) !important;
        text-transform: var(--font-paragraph--case, none) !important;
      {% elsif section.settings.title_custom_font == 'subheading' %}
        font-family: var(--font-subheading--family) !important;
        font-weight: var(--font-subheading--weight, 600) !important;
        text-transform: var(--font-subheading--case, none) !important;
      {% elsif section.settings.title_custom_font == 'heading' %}
        font-family: var(--font-heading--family) !important;
        font-weight: var(--font-heading--weight, 700) !important;
        text-transform: var(--font-heading--case, none) !important;
      {% elsif section.settings.title_custom_font == 'accent' %}
        font-family: var(--font-accent--family) !important;
        font-weight: var(--font-accent--weight, 400) !important;
        text-transform: var(--font-accent--case, none) !important;
      {% endif %}
    {% endif %}
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__product-price {
    {% if section.settings.price_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-size: var(--font-paragraph--size, 1.6rem) !important;
      font-weight: var(--font-paragraph--weight, 400) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.price_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-size: var(--font-subheading--size, 1.8rem) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.price_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-size: var(--font-heading--size, 2rem) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.price_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-size: var(--font-accent--size, 1.4rem) !important;
      font-weight: var(--font-accent--weight, 400) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% elsif section.settings.price_font == 'custom' %}
      font-size: {{ section.settings.price_custom_size }}px !important;
      {% if section.settings.price_custom_font == 'body' %}
        font-family: var(--font-paragraph--family) !important;
        font-weight: var(--font-paragraph--weight, 400) !important;
        text-transform: var(--font-paragraph--case, none) !important;
      {% elsif section.settings.price_custom_font == 'subheading' %}
        font-family: var(--font-subheading--family) !important;
        font-weight: var(--font-subheading--weight, 600) !important;
        text-transform: var(--font-subheading--case, none) !important;
      {% elsif section.settings.price_custom_font == 'heading' %}
        font-family: var(--font-heading--family) !important;
        font-weight: var(--font-heading--weight, 700) !important;
        text-transform: var(--font-heading--case, none) !important;
      {% elsif section.settings.price_custom_font == 'accent' %}
        font-family: var(--font-accent--family) !important;
        font-weight: var(--font-accent--weight, 400) !important;
        text-transform: var(--font-accent--case, none) !important;
      {% endif %}
    {% endif %}
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__info {
    padding-left: var(--product-info-left-offset, 0px) !important;
    text-align: {{ section.settings.text_alignment | default: 'left' }} !important;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %} !important;
  }

  #CollectionCarousel-{{ section.id }} product-swatches {
    padding-left: var(--product-info-left-offset, 0px) !important;
  }

  #CollectionCarousel-{{ section.id }} swatches-variant-picker-component {
    --product-swatches-padding-inline-start: 0px !important;
    --overflow-list-padding-inline: 0px !important;
  }

  #CollectionCarousel-{{ section.id }} .variant-option--swatches {
    margin-left: 0 !important;
    padding-left: 0 !important;
    gap: 4px !important;
  }

  #CollectionCarousel-{{ section.id }} .variant-option__color-count {
    margin-left: 2px !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__size-opt {
    {% if section.settings.size_font == 'body' %}
      font-family: var(--font-paragraph--family) !important;
      font-size: var(--font-paragraph--size, 1.4rem) !important;
      font-weight: var(--font-paragraph--weight, 500) !important;
      text-transform: var(--font-paragraph--case, none) !important;
    {% elsif section.settings.size_font == 'subheading' %}
      font-family: var(--font-subheading--family) !important;
      font-size: var(--font-subheading--size, 1.4rem) !important;
      font-weight: var(--font-subheading--weight, 600) !important;
      text-transform: var(--font-subheading--case, none) !important;
    {% elsif section.settings.size_font == 'heading' %}
      font-family: var(--font-heading--family) !important;
      font-size: var(--font-heading--size, 1.4rem) !important;
      font-weight: var(--font-heading--weight, 700) !important;
      text-transform: var(--font-heading--case, none) !important;
    {% elsif section.settings.size_font == 'accent' %}
      font-family: var(--font-accent--family) !important;
      font-size: var(--font-accent--size, 1.2rem) !important;
      font-weight: var(--font-accent--weight, 500) !important;
      text-transform: var(--font-accent--case, none) !important;
    {% elsif section.settings.size_font == 'custom' %}
      font-size: {{ section.settings.size_custom_size }}px !important;
      {% if section.settings.size_custom_font == 'body' %}
        font-family: var(--font-paragraph--family) !important;
        font-weight: var(--font-paragraph--weight, 500) !important;
        text-transform: var(--font-paragraph--case, none) !important;
      {% elsif section.settings.size_custom_font == 'subheading' %}
        font-family: var(--font-subheading--family) !important;
        font-weight: var(--font-subheading--weight, 600) !important;
        text-transform: var(--font-subheading--case, none) !important;
      {% elsif section.settings.size_custom_font == 'heading' %}
        font-family: var(--font-heading--family) !important;
        font-weight: var(--font-heading--weight, 700) !important;
        text-transform: var(--font-heading--case, none) !important;
      {% elsif section.settings.size_custom_font == 'accent' %}
        font-family: var(--font-accent--family) !important;
        font-weight: var(--font-accent--weight, 500) !important;
        text-transform: var(--font-accent--case, none) !important;
      {% endif %}
    {% endif %}
  }

  #CollectionCarousel-{{ section.id }} .page-width {
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__header {
    padding-left: calc(var(--carousel-padding-horizontal, 0px) + var(--page-margin, 2rem)) !important;
    padding-right: calc(var(--carousel-padding-horizontal, 0px) + var(--page-margin, 2rem)) !important;
  }

  #CollectionCarousel-{{ section.id }} .collection-hover-carousel__track {
    padding-left: var(--carousel-padding-horizontal, 0px) !important;
    padding-right: var(--carousel-padding-horizontal, 0px) !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    width: 100% !important;
  }

  @media screen and (max-width: 768px) {
    #CollectionCarousel-{{ section.id }} .collection-hover-carousel__track {
      padding-left: var(--carousel-padding-horizontal, 0px) !important;
      padding-right: var(--carousel-padding-horizontal, 0px) !important;
    }
    #CollectionCarousel-{{ section.id }} .collection-hover-carousel__header {
      padding-left: calc(var(--carousel-padding-horizontal, 0px) + 2rem) !important;
      padding-right: calc(var(--carousel-padding-horizontal, 0px) + 2rem) !important;
    }
  }

  @media screen and (max-width: 480px) {
    #CollectionCarousel-{{ section.id }} .collection-hover-carousel__item {
      {% if section.settings.enable_carousel %}
        flex: 0 0 70%; /* Shows 1.4 cards to indicate scrolling */
      {% else %}
        flex: 0 0 calc((100% - (var(--cols-mobile) - 1) * var(--carousel-gap, 20px)) / var(--cols-mobile));
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    {% if section.settings.desktop_card_height != 'adapt' %}
      #CollectionCarousel-{{ section.id }} .collection-hover-carousel__image-wrapper {
        height: var(--desktop-image-height) !important;
        max-height: var(--desktop-image-height) !important;
        aspect-ratio: auto !important;
      }
      #CollectionCarousel-{{ section.id }} .collection-hover-carousel__img {
        object-fit: cover !important;
        height: 100% !important;
        width: 100% !important;
      }
    {% endif %}
  }

  #CollectionCarousel-{{ section.id }} .swatch {
    width: {{ section.settings.swatch_size }}px !important;
    height: {{ section.settings.swatch_size }}px !important;
    --swatch-width: {{ section.settings.swatch_size }}px !important;
    --swatch-height: {{ section.settings.swatch_size }}px !important;
  }
{% endstyle %}

{%- if section.settings.mobile_layout == 'grid' -%}
  {% style %}
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .collection-hover-carousel__track {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        column-gap: {{ section.settings.carousel_gap | default: 20 }}px !important;
        row-gap: {{ section.settings.mobile_grid_row_gap | default: 24 }}px !important;
        overflow-x: visible !important;
        scroll-snap-type: none !important;
        -webkit-overflow-scrolling: auto !important;
        padding-left: var(--carousel-padding-horizontal, 1.5rem) !important;
        padding-right: var(--carousel-padding-horizontal, 1.5rem) !important;
      }
      #shopify-section-{{ section.id }} .collection-hover-carousel__item {
        flex: none !important;
        width: 100% !important;
        max-width: 100% !important;
        scroll-snap-align: none !important;
      }
      #shopify-section-{{ section.id }} .collection-hover-carousel__nav,
      #shopify-section-{{ section.id }} .collection-hover-carousel__btn {
        display: none !important;
      }
    }
  {% endstyle %}
{%- endif -%}

{%- if section.settings.desktop_layout == 'grid_2x2' -%}
  {% style %}
    @media (min-width: 990px) {
      #shopify-section-{{ section.id }} .collection-hover-carousel__track--grid-2x2 {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        column-gap: {{ section.settings.carousel_gap | default: 20 }}px !important;
        row-gap: {{ section.settings.grid_row_gap | default: 24 }}px !important;
        overflow-x: visible !important;
        scroll-behavior: auto !important;
        scroll-snap-type: none !important;
      }
      #shopify-section-{{ section.id }} .collection-hover-carousel__track--grid-2x2 .collection-hover-carousel__item {
        flex: none !important;
        width: 100% !important;
        max-width: 100% !important;
      }
      #shopify-section-{{ section.id }}[data-desktop-layout="grid_2x2"] .collection-hover-carousel__nav,
      #shopify-section-{{ section.id }}[data-desktop-layout="grid_2x2"] .collection-hover-carousel__btn {
        display: none !important;
      }
    }
  {% endstyle %}
{%- endif -%}

<div 
  id="CollectionCarousel-{{ section.id }}" 
  class="collection-hover-carousel {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %}"
  data-mobile-layout="{{ section.settings.mobile_layout | default: 'carousel' }}"
  data-desktop-layout="{{ section.settings.desktop_layout | default: 'carousel' }}"
  style="
    padding-top: {{ section.settings.padding_top }}px; 
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.custom_bg_color != blank %}--collection-carousel-bg: {{ section.settings.custom_bg_color }};{% endif %}
    {% if section.settings.custom_text_color != blank %}--collection-carousel-text: {{ section.settings.custom_text_color }};{% endif %}
    --product-title-font-weight: {{ section.settings.product_title_font_weight | default: '700' }};
  "
>
  <div class="page-width">
    <!-- Header with Collection Title and Navigation Controls -->
    {% if section.settings.show_collection_title or section.settings.enable_carousel %}
      <div class="collection-hover-carousel__header{% if has_title_animation %} collection-hover-carousel__header--{{ title_animation }}{% endif %}"{% if has_title_animation %} style="--title-animation-duration: {{ title_animation_duration }}ms;"{% endif %}>
        {% if section.settings.show_collection_title %}
          <div class="collection-hover-carousel__heading">
            <h2 class="collection-hover-carousel__title">
              <span class="collection-hover-carousel__title-line"></span>
              <span class="collection-hover-carousel__title-text">{{ cleaned_collection_title }}</span>
              <span class="collection-hover-carousel__title-line"></span>
            </h2>
          </div>
        {% endif %}
        {% if false %}
          <div class="collection-hover-carousel__nav">
            <button 
              class="collection-hover-carousel__btn collection-hover-carousel__btn--prev"
              aria-label="Previous slide"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </button>
            <button 
              class="collection-hover-carousel__btn collection-hover-carousel__btn--next"
              aria-label="Next slide"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Carousel Track Wrapper -->
    <div class="collection-hover-carousel__track-wrapper">
      <div class="collection-hover-carousel__track {% unless section.settings.enable_carousel %}collection-hover-carousel__track--grid{% endunless %}{% if section.settings.desktop_layout == 'grid_2x2' %} collection-hover-carousel__track--grid-2x2{% endif %}">
        {% if section_collection != blank and collection_products.size > 0 %}
          {%- assign products_limit = section.settings.products_to_show | default: 8 -%}
          {%- if section.settings.desktop_layout == 'grid_2x2' -%}
            {%- assign products_limit = 4 -%}
          {%- endif -%}
          {% for product in collection_products limit: products_limit %}
            {% liquid
              assign title = product.title | default: 'Sample Product'
              assign price_text = product.price | money_without_trailing_zeros
              assign primary_image = product.featured_image
              assign hover_image = nil
              if section.settings.show_secondary_image and product.images.size > 1
                assign hover_image = product.images[1]
              endif
              assign card_url = product.url
            %}
            <div class="collection-hover-carousel__item">
              <div class="collection-hover-carousel__card">
                <div class="collection-hover-carousel__image-wrapper{% if hover_image != blank and hover_image != primary_image %} has-hover-image{% endif %}">
                  {% if primary_image != blank %}
                    {{ primary_image 
                      | image_url: width: 1200 
                      | image_tag: 
                        loading: 'lazy', 
                        sizes: '(min-width: 750px) 25vw, 50vw', 
                        widths: '200, 300, 400, 500, 600, 800, 1000, 1200', 
                        class: 'collection-hover-carousel__img collection-hover-carousel__img--primary',
                        alt: title
                    }}
                    {% if hover_image != blank and hover_image != primary_image %}
                      {{ hover_image 
                        | image_url: width: 1200 
                        | image_tag: 
                          loading: 'lazy', 
                          sizes: '(min-width: 750px) 25vw, 50vw', 
                          widths: '200, 300, 400, 500, 600, 800, 1000, 1200', 
                          class: 'collection-hover-carousel__img collection-hover-carousel__img--hover',
                          alt: ''
                      }}
                    {% endif %}
                  {% else %}
                    {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'collection-hover-carousel__placeholder-svg' }}
                  {% endif %}

                  <a href="{{ card_url }}" class="collection-hover-carousel__card-link-overlay" aria-label="{{ title | escape }}"></a>

                  {% comment %} --- Custom Quick Add Sizes Overlay --- {% endcomment %}
                  {%- assign size_option = nil -%}
                  {%- assign size_option_index = -1 -%}
                  {%- for option in product.options_with_values -%}
                    {%- assign name_downcase = option.name | downcase -%}
                    {%- if name_downcase == 'size' or name_downcase == 'sizes' or name_downcase == 'taille' or name_downcase == 'größe' or name_downcase == 'talla' -%}
                      {%- assign size_option = option -%}
                      {%- assign size_option_index = forloop.index0 -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <div class="collection-hover-carousel__quick-add" data-product-id="{{ product.id }}">
                    <button 
                      class="collection-hover-carousel__quick-add-btn" 
                      aria-label="{% if section.settings.disable_quick_add %}Quick add disabled{% else %}Add to cart / Select size{% endif %}" 
                      type="button"
                      {% if section.settings.disable_quick_add %}
                        aria-disabled="true"
                        tabindex="-1"
                        onclick="event.preventDefault(); event.stopPropagation(); return false;"
                        onkeydown="if(event.key==='Enter'||event.key===' '||event.keyCode===13||event.keyCode===32){event.preventDefault(); event.stopPropagation(); return false;}"
                      {% endif %}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                      <span class="btn-spinner hidden"></span>
                    </button>
                    
                    {%- if size_option != blank -%}
                      <div class="collection-hover-carousel__sizes-overlay">
                        <div class="collection-hover-carousel__sizes-list">
                          {%- for value in size_option.values -%}
                            <button 
                              class="collection-hover-carousel__size-opt" 
                              data-size-value="{{ value | escape }}"
                              data-size-index="{{ size_option_index }}"
                              type="button"
                            >
                              {{ value }}
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                      
                      <script type="application/json" class="product-variants-json">
                        {{ product.variants | json }}
                      </script>
                    {%- else -%}
                      <script type="application/json" class="product-variants-json">
                        {{ product.variants | json }}
                      </script>
                    {%- endif -%}
                  </div>
                </div>
                <div class="collection-hover-carousel__info{% if section.settings.justify_title_price %} collection-hover-carousel__info--justify{% endif %}">
                  <h4 class="collection-hover-carousel__product-title"><a href="{{ card_url }}" class="collection-hover-carousel__title-link" style="font-weight: var(--product-title-font-weight);">{{ title }}</a></h4>
                  <p class="collection-hover-carousel__product-price">{{ price_text }}</p>
                </div>
                
                {% liquid
                  assign product_has_swatches = false
                  for product_option in product.options_with_values
                    assign swatch_count = product_option.values | map: 'swatch' | compact | size
                    assign option_name_downcase = product_option.name | downcase
                    if swatch_count > 0 or option_name_downcase == 'color' or option_name_downcase == 'colour' or option_name_downcase == 'farbe' or option_name_downcase == 'couleur'
                      assign product_has_swatches = true
                    endif
                  endfor
                %}
                {% if section.settings.show_swatches and product_has_swatches %}
                  <product-swatches
                    data-product-id="{{ product.id }}"
                    data-product-url="{{ product.url }}"
                    style="
                      --swatch-size: {{ section.settings.swatch_size }}px;
                      --overflow-list-alignment: {{ section.settings.swatches_alignment }};
                      --overflow-list-alignment-mobile: {{ section.settings.swatches_alignment_mobile }};
                      --product-swatches-alignment: {% if section.settings.swatches_alignment == 'flex-start' %}start{% elsif section.settings.swatches_alignment == 'flex-end' %}end{% else %}center{% endif %};
                      --product-swatches-alignment-mobile: {% if section.settings.swatches_alignment_mobile == 'flex-start' %}start{% elsif section.settings.swatches_alignment_mobile == 'flex-end' %}end{% else %}center{% endif %};
                      --product-swatches-padding-block-start: {{ section.settings.swatches_padding_top }}px;
                      --product-swatches-padding-block-end: {{ section.settings.swatches_padding_bottom }}px;
                      --product-swatches-padding-inline-start: {{ section.settings.swatches_padding_left }}px;
                      --product-swatches-padding-inline-end: {{ section.settings.swatches_padding_right }}px;
                      --variant-picker-swatch-radius: {{ section.settings.swatches_border_radius }}px;
                      --style-border-swatch-width: {{ section.settings.swatches_border_width }}px;
                      --style-border-swatch-style: {{ section.settings.swatches_border_style }};
                      --color-border: {{ section.settings.swatches_border_color }};
                    "
                  >
                    {% render 'variant-swatches', product_resource: product %}
                  </product-swatches>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% comment %} Fallback items if no blocks exist {% endcomment %}
          {%- assign products_limit = section.settings.products_to_show | default: 8 -%}
          {%- if section.settings.desktop_layout == 'grid_2x2' -%}
            {%- assign products_limit = 4 -%}
          {%- endif -%}
          {% for i in (1..products_limit) %}
            {% assign placeholder_index = i | modulo: 4 | plus: 1 %}
            <div class="collection-hover-carousel__item">
              <div class="collection-hover-carousel__card">
                <div class="collection-hover-carousel__image-wrapper">
                  {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'collection-hover-carousel__placeholder-svg' }}
                  <a href="#" class="collection-hover-carousel__card-link-overlay" aria-label="Sample Product {{ i }}"></a>
                </div>
                <div class="collection-hover-carousel__info{% if section.settings.justify_title_price %} collection-hover-carousel__info--justify{% endif %}">
                  <h4 class="collection-hover-carousel__product-title"><a href="#" class="collection-hover-carousel__title-link" style="font-weight: var(--product-title-font-weight);">Sample Product {{ i }}</a></h4>
                  <p class="collection-hover-carousel__product-price">Rs. 1,200 INR</p>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Quick Add Overlay and plus button styling */
  .collection-hover-carousel__quick-add {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .collection-hover-carousel__quick-add-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #000000;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    opacity: 0;
    transform: scale(0.9);
    pointer-events: auto;
    padding: 0;
    overflow: hidden;
  }

  .collection-hover-carousel__quick-add-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -150%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    pointer-events: none;
    transition: none;
  }

  @media (hover: hover) {
    .collection-hover-carousel__quick-add-btn:hover::after {
      left: 150%;
      transition: left 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  .collection-hover-carousel__quick-add-btn:hover {
    transform: scale(1.05);
    background-color: #000000;
    color: #ffffff;
  }

  .collection-hover-carousel__quick-add-btn svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  /* Show plus button on card hover */
  @media (hover: hover) {
    .collection-hover-carousel__card:hover .collection-hover-carousel__quick-add-btn {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Always show plus button on touch devices */
  @media (hover: none) {
    .collection-hover-carousel__quick-add-btn {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Spinner element for loading */
  .btn-spinner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(0,0,0,0.1);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spinner-rotate 0.6s linear infinite;
  }

  .btn-spinner.hidden {
    display: none;
  }

  @keyframes spinner-rotate {
    to { transform: rotate(360deg); }
  }

  /* Sizes overlay container */
  .collection-hover-carousel__sizes-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: #000000;
    z-index: 15;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 6px 0;
    box-shadow: none;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: auto;
  }

  /* Open/Active state */
  .collection-hover-carousel__quick-add.is-active .collection-hover-carousel__sizes-overlay {
    transform: translateY(0);
  }

  /* Hide plus button when size options overlay is open */
  .collection-hover-carousel__quick-add.is-active .collection-hover-carousel__quick-add-btn {
    opacity: 0 !important;
    transform: scale(0.8) !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  .collection-hover-carousel__sizes-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    width: 100%;
  }

  /* Memory representation of array data structure */
  .collection-hover-carousel__size-opt {
    flex: 0 0 auto;
    min-width: 42px;
    height: 32px;
    border: 1px solid #d1d5db;
    background-color: #f3f4f6;
    color: #111827;
    font-family: inherit;
    font-size: 1.2rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 4px;
    padding: 0 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .collection-hover-carousel__size-opt:hover:not(:disabled) {
    background-color: #111827;
    color: #ffffff;
    border-color: #111827;
    transform: translateY(-1px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
  }

  .collection-hover-carousel__size-opt:active:not(:disabled),
  .collection-hover-carousel__size-opt.is-active {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
    transform: scale(0.95);
  }

  /* Strikethrough for unavailable sizes */
  .collection-hover-carousel__size-opt:disabled,
  .collection-hover-carousel__size-opt.is-unavailable {
    opacity: 0.35;
    background-color: #f9fafb;
    color: #9ca3af;
    border-color: #e5e7eb;
    cursor: not-allowed;
    position: relative;
    overflow: hidden;
    box-shadow: none;
    transform: none !important;
  }

  .collection-hover-carousel__size-opt.is-unavailable::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: #9ca3af;
    transform: rotate(-45deg);
  }

  /* Success pop animation */
  .collection-hover-carousel__quick-add-btn.is-success,
  .collection-hover-carousel__size-opt.is-success {
    background-color: #10b981 !important;
    color: #ffffff !important;
    border-color: #10b981 !important;
    animation: success-pop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes success-pop {
    0% { transform: scale(0.8); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }

  .collection-hover-carousel {
    padding: 8px 0;
    background-color: var(--collection-carousel-bg, var(--color-background, #000000));
    color: var(--collection-carousel-text, var(--color-foreground, #ffffff));
    overflow: hidden;
    font-family: var(--font-body--family), sans-serif;
  }

  .collection-hover-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .collection-hover-carousel__heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .collection-hover-carousel__title-link {
    text-decoration: none;
    color: inherit;
  }

  .collection-hover-carousel__title {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-foreground-heading, inherit);
    text-transform: uppercase;
  }

  .collection-hover-carousel__header--fade-up .collection-hover-carousel__title,
  .collection-hover-carousel__header--slide-left .collection-hover-carousel__title,
  .collection-hover-carousel__header--zoom-in .collection-hover-carousel__title {
    opacity: 0;
    transition: opacity var(--title-animation-duration, 700ms) ease, transform var(--title-animation-duration, 700ms) ease;
    will-change: opacity, transform;
  }

  .collection-hover-carousel__header--fade-up .collection-hover-carousel__title {
    transform: translateY(1rem);
  }

  .collection-hover-carousel__header--slide-left .collection-hover-carousel__title {
    transform: translateX(-1.25rem);
  }

  .collection-hover-carousel__header--zoom-in .collection-hover-carousel__title {
    transform: scale(0.95);
  }

  .collection-hover-carousel__header.title-visible .collection-hover-carousel__title {
    opacity: 1;
    transform: none;
  }

  .collection-hover-carousel__nav {
    display: flex;
    gap: 1rem;
  }

  .collection-hover-carousel__btn {
    background: transparent;
    border: 1px solid var(--color-border, rgba(var(--color-foreground-rgb), 0.15));
    color: var(--color-foreground, #ffffff);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
    padding: 0;
  }

  .collection-hover-carousel__btn:hover {
    background-color: var(--color-foreground, #ffffff);
    color: var(--color-background, #000000);
    border-color: var(--color-foreground, #ffffff);
  }

  .collection-hover-carousel__btn svg {
    width: 18px;
    height: 18px;
  }

  .collection-hover-carousel__view-collection-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 0.9rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.12);
    background: rgba(var(--color-foreground-rgb), 0.08);
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--font-body--family), sans-serif;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 0 0 1px rgba(var(--color-foreground-rgb), 0.04);
  }

  .collection-hover-carousel__view-collection-button:hover {
    background: rgba(var(--color-foreground-rgb), 0.12);
    border-color: rgba(var(--color-foreground-rgb), 0.24);
    box-shadow: 0 12px 25px rgba(var(--color-foreground-rgb), 0.08);
    transform: translateY(-1px);
  }

  .collection-hover-carousel__view-collection-button::after {
    content: '→';
    display: inline-block;
    margin-left: 0.65rem;
    font-size: 0.95em;
    opacity: 0.9;
  }

  .collection-hover-carousel__track-wrapper {
    position: relative;
    width: 100%;
  }

  .collection-hover-carousel__track {
    display: flex;
    gap: var(--carousel-gap, 2rem);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .collection-hover-carousel__track--grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-desktop, 4), 1fr);
    gap: var(--carousel-gap, 20px);
    overflow-x: visible;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .collection-hover-carousel__track--grid .collection-hover-carousel__item {
    flex: none;
    width: 100%;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .collection-hover-carousel__track--grid {
      grid-template-columns: repeat(2, 1fr) !important;
      column-gap: var(--carousel-gap, 20px) !important;
      row-gap: var(--mobile-grid-row-gap, 24px) !important;
    }
  }

  .collection-hover-carousel__track::-webkit-scrollbar {
    display: none; /* Safari and Chrome */
  }

  .collection-hover-carousel__item {
    flex: 0 0 calc((100% - (var(--cols-desktop) - 1) * var(--carousel-gap, 20px)) / var(--cols-desktop));
    scroll-snap-align: start;
  }

  .collection-hover-carousel__card {
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .collection-hover-carousel__card-link-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .collection-hover-carousel__card product-swatches {
    position: relative;
    z-index: 2;
  }

  .collection-hover-carousel__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: var(--collection-carousel-aspect-ratio, 3 / 4);
    overflow: hidden;
    background-color: transparent;
    margin-bottom: 1.2rem;
  }

  .collection-hover-carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    position: absolute;
    top: 0;
    left: 0;
  }

  .collection-hover-carousel__img--hover {
    opacity: 0;
    z-index: 1;
  }

  .collection-hover-carousel__card:hover .has-hover-image .collection-hover-carousel__img--hover {
    opacity: 1;
    z-index: 2;
  }

  .collection-hover-carousel__card:hover .has-hover-image .collection-hover-carousel__img--primary {
    opacity: 0;
    transform: scale(1.03);
  }

  .collection-hover-carousel__card:hover .collection-hover-carousel__image-wrapper:not(.has-hover-image) .collection-hover-carousel__img--primary {
    transform: scale(1.03);
  }

  .collection-hover-carousel__placeholder-svg {
    width: 100%;
    height: 100%;
    background-color: transparent;
    fill: var(--color-foreground-muted, #222222);
  }

  .collection-hover-carousel__info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .collection-hover-carousel__product-title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-foreground-heading, var(--color-foreground, inherit));
    letter-spacing: normal;
    text-transform: none;
  }

  .collection-hover-carousel__product-price {
    margin: 0;
    font-family: var(--font-body--family), sans-serif;
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    font-weight: var(--font-weight-regular);
    color: var(--color-foreground-muted, rgba(var(--color-foreground-rgb), 0.6));
  }

  .collection-hover-carousel__info--justify {
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    gap: 1rem !important;
    margin-bottom: 0.4rem !important;
    width: 100%;
  }

  .collection-hover-carousel__info--justify .collection-hover-carousel__product-title {
    flex: 1 !important;
    min-width: 0 !important;
    text-align: left !important;
  }

  .collection-hover-carousel__info--justify .collection-hover-carousel__product-price {
    flex-shrink: 0 !important;
    text-align: right !important;
    white-space: nowrap !important;
  }


  /* Responsiveness */
  @media screen and (max-width: 1024px) {
    .collection-hover-carousel__item {
      flex: 0 0 calc((100% - (var(--cols-tablet) - 1) * var(--carousel-gap, 20px)) / var(--cols-tablet));
    }
  }

  @media screen and (max-width: 768px) {
    .collection-hover-carousel__item {
      flex: 0 0 calc((100% - (var(--cols-mobile) - 1) * var(--carousel-gap, 20px)) / var(--cols-mobile));
    }

    .collection-hover-carousel .page-width {
      padding-left: 0;
      padding-right: 0;
    }

    .collection-hover-carousel__header {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding-left: 2rem;
      padding-right: 2rem;
      margin-bottom: 2rem;
    }

    .collection-hover-carousel__heading {
      justify-content: center;
    }

    .collection-hover-carousel__nav {
      display: none;
    }

    .collection-hover-carousel__track {
      padding-left: var(--carousel-padding-horizontal, 2rem);
      padding-right: var(--carousel-padding-horizontal, 2rem);
    }
  }

  @media screen and (max-width: 480px) {
    .collection-hover-carousel__title {
      font-size: 1.8rem;
    }

    .collection-hover-carousel__btn {
      width: 36px;
      height: 36px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initCarousel(sectionId) {
      const section = document.getElementById('CollectionCarousel-' + sectionId);
      if (!section) return;
      
      const mobileLayout = section.getAttribute('data-mobile-layout');
      if (mobileLayout === 'grid' && window.innerWidth <= 749) return;

      const desktopLayout = section.getAttribute('data-desktop-layout');
      if (desktopLayout === 'grid_2x2' && window.innerWidth >= 990) return;
      
      const track = section.querySelector('.collection-hover-carousel__track');
      const prevBtn = section.querySelector('.collection-hover-carousel__btn--prev');
      const nextBtn = section.querySelector('.collection-hover-carousel__btn--next');
      if (!track || !prevBtn || !nextBtn) return;

      function getScrollAmount() {
        const firstItem = track.querySelector('.collection-hover-carousel__item');
        if (firstItem) {
          // scroll by card width plus actual dynamic gap
          const style = window.getComputedStyle(track);
          const gap = parseFloat(style.columnGap || style.gap) || 20;
          return firstItem.getBoundingClientRect().width + gap; 
        }
        return 300;
      }

      prevBtn.addEventListener('click', function(e) {
        e.preventDefault();
        track.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });
      });

      nextBtn.addEventListener('click', function(e) {
        e.preventDefault();
        track.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });
      });
    }

    function initTitleReveal(sectionId) {
      const section = document.getElementById('CollectionCarousel-' + sectionId);
      if (!section) return;

      const header = section.querySelector('.collection-hover-carousel__header');
      if (!header) return;

      const hasAnimation = header.classList.contains('collection-hover-carousel__header--fade-up') ||
                            header.classList.contains('collection-hover-carousel__header--slide-left') ||
                            header.classList.contains('collection-hover-carousel__header--zoom-in');
      if (!hasAnimation) return;

      if (!('IntersectionObserver' in window)) {
        header.classList.add('title-visible');
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            header.classList.add('title-visible');
          } else {
            header.classList.remove('title-visible');
          }
        });
      }, {
        threshold: 0.2
      });

      observer.observe(section);
    }

    function initQuickAdd(sectionId) {
      const section = document.getElementById('CollectionCarousel-' + sectionId);
      if (!section) return;

      const cards = section.querySelectorAll('.collection-hover-carousel__card');
      cards.forEach(card => {
        const quickAddContainer = card.querySelector('.collection-hover-carousel__quick-add');
        if (!quickAddContainer) return;

        const plusBtn = quickAddContainer.querySelector('.collection-hover-carousel__quick-add-btn');
        const sizesOverlay = quickAddContainer.querySelector('.collection-hover-carousel__sizes-overlay');
        const sizeButtons = quickAddContainer.querySelectorAll('.collection-hover-carousel__size-opt');

        // Function to update size buttons availability based on selected color swatch
        function updateAvailability() {
          const jsonEl = quickAddContainer.querySelector('.product-variants-json');
          if (!jsonEl) return;
          const variants = JSON.parse(jsonEl.textContent);

          // Find checked swatch in this card
          const checkedSwatch = card.querySelector('product-swatches input[type="radio"]:checked');
          const selectedColor = checkedSwatch ? checkedSwatch.value.trim() : null;

          sizeButtons.forEach(btn => {
            const sizeValue = btn.dataset.sizeValue.trim();
            const sizeIndex = parseInt(btn.dataset.sizeIndex, 10);

            // Find if there is an available variant matching this size (+ color if selectedColor exists)
            let isAvailable = false;
            for (const variant of variants) {
              if (!variant.available) continue;
              if (variant.options[sizeIndex] !== sizeValue) continue;

              if (selectedColor) {
                let matchesColor = false;
                for (let i = 0; i < variant.options.length; i++) {
                  if (i !== sizeIndex && variant.options[i] === selectedColor) {
                    matchesColor = true;
                    break;
                  }
                }
                if (!matchesColor) continue;
              }
              isAvailable = true;
              break;
            }

            if (isAvailable) {
              btn.classList.remove('is-unavailable');
              btn.disabled = false;
            } else {
              btn.classList.add('is-unavailable');
              btn.disabled = true;
            }
          });
        }

        // Run availability initially
        updateAvailability();

        // Re-run availability when swatches change
        card.addEventListener('change', function(e) {
          if (e.target.name && e.target.name.includes('-swatch')) {
            updateAvailability();
          }
        });

        let dismissTimeout = null;

        function startDismissTimer() {
          clearDismissTimer();
          dismissTimeout = setTimeout(() => {
            quickAddContainer.classList.remove('is-active');
          }, 3000);
        }

        function clearDismissTimer() {
          if (dismissTimeout) {
            clearTimeout(dismissTimeout);
            dismissTimeout = null;
          }
        }

        // Store clear function on container for external dismiss triggers
        quickAddContainer._clearDismissTimer = clearDismissTimer;

        // Toggling overlay on click (+ button)
        if (plusBtn) {
          if (plusBtn.getAttribute('aria-disabled') === 'true') {
            const blockEvent = function(e) {
              e.preventDefault();
              e.stopPropagation();
              if (typeof e.stopImmediatePropagation === 'function') {
                e.stopImmediatePropagation();
              }
              return false;
            };
            plusBtn.addEventListener('click', blockEvent, true);
            plusBtn.addEventListener('pointerdown', blockEvent, true);
            plusBtn.addEventListener('mousedown', blockEvent, true);
            plusBtn.addEventListener('touchstart', blockEvent, { capture: true, passive: false });
            plusBtn.addEventListener('keydown', function(e) {
              if (e.key === 'Enter' || e.key === ' ' || e.keyCode === 13 || e.keyCode === 32) {
                blockEvent(e);
              }
            }, true);
          } else {
            plusBtn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();

              // If there are sizes, show sizes overlay
              if (sizesOverlay) {
                // Close all other overlays in this section
                section.querySelectorAll('.collection-hover-carousel__quick-add').forEach(el => {
                  if (el !== quickAddContainer) {
                    el.classList.remove('is-active');
                    if (typeof el._clearDismissTimer === 'function') {
                      el._clearDismissTimer();
                    }
                  }
                });

                const isActive = quickAddContainer.classList.contains('is-active');
                if (isActive) {
                  quickAddContainer.classList.remove('is-active');
                  clearDismissTimer();
                } else {
                  quickAddContainer.classList.add('is-active');
                  startDismissTimer();
                }
              } else {
                // No size options: add first available variant directly
                const jsonEl = quickAddContainer.querySelector('.product-variants-json');
                if (!jsonEl) return;
                const variants = JSON.parse(jsonEl.textContent);

                // Find selected color swatch (if any)
                const checkedSwatch = card.querySelector('product-swatches input[type="radio"]:checked');
                const selectedColor = checkedSwatch ? checkedSwatch.value.trim() : null;

                let targetVariant = null;
                // 1. Try matching selected color first
                if (selectedColor) {
                  targetVariant = variants.find(v => v.available && v.options.includes(selectedColor));
                }
                // 2. Fall back to first available variant
                if (!targetVariant) {
                  targetVariant = variants.find(v => v.available);
                }
                // 3. Fall back to first variant of all
                if (!targetVariant) {
                  targetVariant = variants[0];
                }

                if (targetVariant) {
                  addToCart(targetVariant.id, quickAddContainer, plusBtn);
                }
              }
            });
          }
        }

        // Desktop hover inactivity check
        card.addEventListener('mouseenter', function() {
          clearDismissTimer();
        });

        card.addEventListener('mouseleave', function() {
          if (quickAddContainer.classList.contains('is-active')) {
            startDismissTimer();
          }
        });

        // Clicking overlay resets timer
        if (sizesOverlay) {
          sizesOverlay.addEventListener('click', function(e) {
            e.stopPropagation(); // Stop propagation so it doesn't trigger card link click
            clearDismissTimer();
            startDismissTimer();
          });
        }

        // Clicking a size option adds that variant to cart
        sizeButtons.forEach(btn => {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();

            const sizeValue = btn.dataset.sizeValue.trim();
            const sizeIndex = parseInt(btn.dataset.sizeIndex, 10);
            
            const jsonEl = quickAddContainer.querySelector('.product-variants-json');
            if (!jsonEl) return;
            const variants = JSON.parse(jsonEl.textContent);

            // Find selected color swatch (if any)
            const checkedSwatch = card.querySelector('product-swatches input[type="radio"]:checked');
            const selectedColor = checkedSwatch ? checkedSwatch.value.trim() : null;

            let targetVariant = null;
            // Find variant matching size and color (if present)
            for (const variant of variants) {
              if (variant.options[sizeIndex] !== sizeValue) continue;
              if (selectedColor) {
                let matchesColor = false;
                for (let i = 0; i < variant.options.length; i++) {
                  if (i !== sizeIndex && variant.options[i] === selectedColor) {
                    matchesColor = true;
                    break;
                  }
                }
                if (!matchesColor) continue;
              }
              targetVariant = variant;
              // Prefer available variant
              if (variant.available) {
                break;
              }
            }

            if (targetVariant) {
              clearDismissTimer();
              addToCart(targetVariant.id, quickAddContainer, btn);
            }
          });
        });
      });

      // Close overlays when clicking outside
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.collection-hover-carousel__quick-add')) {
          section.querySelectorAll('.collection-hover-carousel__quick-add').forEach(el => {
            el.classList.remove('is-active');
            if (typeof el._clearDismissTimer === 'function') {
              el._clearDismissTimer();
            }
          });
        }
      });
    }

    // Ajax add to cart function
    function addToCart(variantId, container, triggerBtn) {
      if (!variantId) return;

      // Add loading state
      triggerBtn.disabled = true;
      triggerBtn.classList.add('is-loading');
      const originalContent = triggerBtn.innerHTML;

      if (triggerBtn.classList.contains('collection-hover-carousel__quick-add-btn')) {
        // Show loading spinner for plus button
        triggerBtn.innerHTML = '<span class="btn-spinner"></span>';
      } else {
        // Show loading state for size button
        triggerBtn.innerHTML = '...';
      }

      // Prepare request
      const formData = new FormData();
      formData.append('id', variantId);
      formData.append('quantity', 1);

      // Query active cart sections to refresh
      const cartItemsComponents = document.querySelectorAll('cart-items-component');
      let cartItemComponentsSectionIds = [];
      cartItemsComponents.forEach((item) => {
        if (item && item.dataset && item.dataset.sectionId) {
          cartItemComponentsSectionIds.push(item.dataset.sectionId);
        }
      });
      if (cartItemComponentsSectionIds.length > 0) {
        formData.append('sections', cartItemComponentsSectionIds.join(','));
      }

      fetch(window.Shopify?.routes?.root + 'cart/add.js', {
        method: 'POST',
        body: formData,
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.json())
      .then(response => {
        if (response.status) {
          alert(response.description || response.message);
          // Revert on error
          triggerBtn.classList.remove('is-loading');
          triggerBtn.innerHTML = originalContent;
          triggerBtn.disabled = false;
        } else {
          // Success micro-interaction
          triggerBtn.classList.remove('is-loading');
          triggerBtn.classList.add('is-success');

          if (triggerBtn.classList.contains('collection-hover-carousel__quick-add-btn')) {
            // Checkmark SVG for plus button
            triggerBtn.innerHTML = '<svg class="success-checkmark" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          } else {
            // Checkmark text for size variant button
            triggerBtn.innerHTML = '✓';
          }

          // Fetch updated cart to dispatch update event
          fetch(window.Shopify?.routes?.root + 'cart.js')
            .then(res => res.json())
            .then(cart => {
              // Dispatch event to open cart drawer and update bubble
              const event = new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: cart,
                  sourceId: variantId.toString(),
                  data: {
                    source: 'product-form-component',
                    itemCount: 1,
                    productId: container.dataset.productId,
                    sections: response.sections
                  }
                }
              });
              document.dispatchEvent(event);

              // Explicitly open the cart drawer dialog
              const cartDrawer = document.querySelector('cart-drawer-component');
              if (cartDrawer) {
                cartDrawer.open();
              }
            });

          // Wait 2 seconds in success state, then smoothly close overlay/revert button
          setTimeout(() => {
            triggerBtn.classList.remove('is-success');
            triggerBtn.innerHTML = originalContent;
            triggerBtn.disabled = false;
            
            // Close the sizes overlay
            container.classList.remove('is-active');
          }, 2000);
        }
      })
      .catch(err => {
        console.error('Error adding to cart:', err);
        // Revert on catch block error
        triggerBtn.classList.remove('is-loading');
        triggerBtn.innerHTML = originalContent;
        triggerBtn.disabled = false;
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      initCarousel('{{ section.id }}');
      {% if has_title_animation %}
        initTitleReveal('{{ section.id }}');
      {% endif %}
      initQuickAdd('{{ section.id }}');
    });

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initCarousel('{{ section.id }}');
        {% if has_title_animation %}
          initTitleReveal('{{ section.id }}');
        {% endif %}
        initQuickAdd('{{ section.id }}');
      }
    });
  })();
</script>


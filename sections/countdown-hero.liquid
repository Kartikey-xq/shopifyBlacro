            <div class="countdown-hero__unit" data-unit="hours">
              <div class="countdown-hero__digit-slot" data-slot><span class="countdown-hero__digit countdown-hero__digit--current">11</span></div>
            </div>
            <div class="countdown-hero__sep" aria-hidden="true"></div>
            <div class="countdown-hero__unit" data-unit="minutes">
              <div class="countdown-hero__digit-slot" data-slot><span class="countdown-hero__digit countdown-hero__digit--current">47</span></div>
            </div>
            <div class="countdown-hero__sep" aria-hidden="true"></div>

          <span class="countdown-hero__sr-only" data-timer-announcer>Countdown active: 2 days, 11 hours, 47 minutes, 7 seconds remaining.</span>
        </div>

        <div class="countdown-hero__block countdown-hero__block--labels" style="--m-bottom-d: 52px; --m-bottom-m: 44px;">
          <div class="countdown-hero__labels" aria-hidden="true">

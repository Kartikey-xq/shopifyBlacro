            <div class="countdown-hero__label-spacer"></div>
            <div class="countdown-hero__label">HOURS</div>
            <div class="countdown-hero__label-spacer"></div>
            <div class="countdown-hero__label">MINUTES</div>
            <div class="countdown-hero__label-spacer"></div>

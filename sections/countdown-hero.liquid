</div>

<script>
(function() {
  function initCountdownHero(root) {
    if (!root || root._countdownInitialized) return;
    root._countdownInitialized = true;

    const timerEl = root.querySelector('[data-countdown-timer]');
    if (!timerEl) return;

    const announcer = root.querySelector('[data-timer-announcer]');
    const completedDisplay = root.querySelector('[data-completed-display]');
    const isAnimationEnabled = timerEl.dataset.enableAnimation !== 'false';
    const expiryAction = timerEl.dataset.expiryAction || 'zero';
    const completedMsg = timerEl.dataset.completedMsg || 'PRE ORDERS ARE NOW OPEN';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Parse target date/time
    let targetTime = null;
    const rawTarget = timerEl.dataset.targetDate;
    if (rawTarget && rawTarget.trim()) {
      let formatted = rawTarget.trim();
      if (formatted.includes(' ') && !formatted.includes('T')) {
        formatted = formatted.replace(' ', 'T');
      }
      const parsed = new Date(formatted);
      if (!isNaN(parsed.getTime())) {
        targetTime = parsed.getTime();
      }
    }

    // Default target: if none specified, set relative 2d 11h 47m 7s
    if (!targetTime) {
      const storageKey = 'countdown_hero_target_' + root.id;
      let stored = null;
      try { stored = sessionStorage.getItem(storageKey); } catch(e) {}
      if (stored && !isNaN(parseInt(stored, 10))) {
        targetTime = parseInt(stored, 10);
      } else {
        targetTime = Date.now() + (2 * 86400 + 11 * 3600 + 47 * 60 + 7) * 1000;
        try { sessionStorage.setItem(storageKey, targetTime); } catch(e) {}
      }
    }

    function getRemaining() {
      const now = Date.now();
      const diff = Math.max(0, targetTime - now);
      const totalSec = Math.floor(diff / 1000);
      const d = Math.floor(totalSec / 86400);
      const h = Math.floor((totalSec % 86400) / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      return {
        diff,
        totalSec,
        days: String(d).padStart(2, '0'),
        hours: String(h).padStart(2, '0'),
        minutes: String(m).padStart(2, '0'),
        seconds: String(s).padStart(2, '0')
      };
    }

    function handleCompletion() {
      if (expiryAction === 'message') {
        root.setAttribute('data-completed', 'true');
        root.setAttribute('data-hide-timer', 'true');
        if (completedDisplay) completedDisplay.textContent = completedMsg;
      } else {
        root.setAttribute('data-completed', 'true');
      }
    }

    // Single slot roll mechanism (outgoing slides up to -100%, incoming slides in from 100% to 0)
    function rollSlot(slot, nextValStr, animate) {
      if (!slot) return;
      const digits = Array.from(slot.querySelectorAll('.countdown-hero__digit'));
      const currentVisible = digits.find(d => !d.classList.contains('countdown-hero__digit--outgoing')) || digits[digits.length - 1];

      if (currentVisible && currentVisible.textContent === nextValStr) {
        return;
      }

      // Clean any extraneous elements so at most 1 element exists before roll
      digits.forEach(d => {
        if (d !== currentVisible && d.parentNode) {
          d.remove();
        }
      });

      if (!animate || !isAnimationEnabled || prefersReducedMotion) {
        if (currentVisible) {
          currentVisible.className = 'countdown-hero__digit countdown-hero__digit--current';
          currentVisible.textContent = nextValStr;
          currentVisible.style.transition = 'none';
          currentVisible.style.transform = 'translateY(0)';
        } else {
          const span = document.createElement('span');
          span.className = 'countdown-hero__digit countdown-hero__digit--current';
          span.textContent = nextValStr;
          slot.appendChild(span);
        }
        return;
      }

      // Two elements stacked: outgoing and incoming
      const outgoing = currentVisible;
      const incoming = document.createElement('span');
      incoming.className = 'countdown-hero__digit countdown-hero__digit--incoming';
      incoming.textContent = nextValStr;
      incoming.style.transform = 'translateY(100%)';
      incoming.style.transition = 'none';
      slot.appendChild(incoming);

      // Force layout reflow
      void incoming.offsetHeight;

      // Outgoing slides upward out of view
      if (outgoing) {
        outgoing.className = 'countdown-hero__digit countdown-hero__digit--outgoing';
        outgoing.style.transition = 'transform 1000ms linear';
        outgoing.style.transform = 'translateY(-100%)';
      }

      // Incoming slides in from below
      incoming.className = 'countdown-hero__digit countdown-hero__digit--incoming countdown-hero__digit--sliding-in';
      incoming.style.transition = 'transform 1000ms linear';
      incoming.style.transform = 'translateY(0)';

      const finish = () => {
        if (outgoing && outgoing.parentNode) {
          outgoing.remove();
        }
        incoming.className = 'countdown-hero__digit countdown-hero__digit--current';
        incoming.style.transition = 'none';
        incoming.style.transform = 'translateY(0)';
      };

      let finished = false;
      const handleDone = () => {
        if (finished) return;
        finished = true;
        finish();
      };

      incoming.addEventListener('transitionend', handleDone, { once: true });
      setTimeout(handleDone, 1000);
    }

    const unitNames = ['days', 'hours', 'minutes', 'seconds'];
    const unitSlots = {};
    unitNames.forEach(name => {
      const u = timerEl.querySelector('[data-unit="' + name + '"]');
      if (u) unitSlots[name] = u.querySelector('.countdown-hero__digit-slot');
    });

    const currentValues = { days: null, hours: null, minutes: null, seconds: null };

    // Initial populate without animation
    const initial = getRemaining();
    unitNames.forEach(name => {
      currentValues[name] = initial[name];
      rollSlot(unitSlots[name], initial[name], false);
    });

    if (initial.diff <= 0) {
      handleCompletion();
      return;
    }

    function tick() {
      const rem = getRemaining();
      if (rem.diff <= 0) {
        unitNames.forEach(name => rollSlot(unitSlots[name], '00', true));
        handleCompletion();
        if (root._countdownTimer) clearTimeout(root._countdownTimer);
        root._countdownTimer = null;
        return;
      }

      // Seconds continuously rolls every second
      rollSlot(unitSlots.seconds, rem.seconds, true);
      currentValues.seconds = rem.seconds;

      // Minutes roll only when value actually changes
      if (rem.minutes !== currentValues.minutes) {
        rollSlot(unitSlots.minutes, rem.minutes, true);
        currentValues.minutes = rem.minutes;
      }

      // Hours roll only when value actually changes
      if (rem.hours !== currentValues.hours) {
        rollSlot(unitSlots.hours, rem.hours, true);
        currentValues.hours = rem.hours;
      }

      // Days roll only when value actually changes
      if (rem.days !== currentValues.days) {
        rollSlot(unitSlots.days, rem.days, true);
        currentValues.days = rem.days;
      }

      if (announcer && rem.seconds === '00') {
        announcer.textContent = 'Countdown active: ' + rem.days + ' days, ' + rem.hours + ' hours, ' + rem.minutes + ' minutes remaining.';
      }

      // Schedule next tick synced to new Date()
      const nextDiff = Math.max(0, targetTime - Date.now());
      const nextDelay = (nextDiff % 1000) || 1000;
      root._countdownTimer = setTimeout(tick, nextDelay);
    }

    // Initial delay synced to exact second boundary of targetTime / Date.now()
    const firstDiff = Math.max(0, targetTime - Date.now());
    const firstDelay = (firstDiff % 1000) || 1000;
    root._countdownTimer = setTimeout(tick, firstDelay);

    // Resync when tab becomes visible again after background throttling
    function onVisibilityChange() {
      if (document.visibilityState === 'visible') {
        if (root._countdownTimer) clearTimeout(root._countdownTimer);
        const rem = getRemaining();
        if (rem.diff <= 0) {
          unitNames.forEach(name => rollSlot(unitSlots[name], '00', false));
          handleCompletion();
          return;
        }
        unitNames.forEach(name => {
          currentValues[name] = rem[name];
          rollSlot(unitSlots[name], rem[name], false);
        });
        const d = Math.max(0, targetTime - Date.now());
        const delay = (d % 1000) || 1000;
        root._countdownTimer = setTimeout(tick, delay);
      }
    }
    document.addEventListener('visibilitychange', onVisibilityChange);

    root._cleanup = function() {
      if (root._countdownTimer) clearTimeout(root._countdownTimer);
      document.removeEventListener('visibilitychange', onVisibilityChange);
    };
  }

  function setup() {
    document.querySelectorAll('[data-countdown-hero]').forEach(initCountdownHero);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }

  // Shopify Theme Editor live reload hooks
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && e.target.querySelector('[data-countdown-hero]')) {
      const el = e.target.querySelector('[data-countdown-hero]');
      if (el._cleanup) el._cleanup();
      el._countdownInitialized = false;
      initCountdownHero(el);
    }
  });

  document.addEventListener('shopify:section:unload', function(e) {
    if (e.target && e.target.querySelector('[data-countdown-hero]')) {
      const el = e.target.querySelector('[data-countdown-hero]');
      if (el && el._cleanup) {
        el._cleanup();
      }
    }
  });
})();
</script>


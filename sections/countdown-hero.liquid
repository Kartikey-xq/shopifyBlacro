{% comment %}
  Standalone Countdown Hero Section
  Recreates the minimal luxury streetwear preorder countdown design 1:1.
  Completely independent and isolated from existing hero section.
{% endcomment %}

{% liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#f4f3ec'
  assign min_height = '100svh'
  if section.settings.section_height == 'viewport_height'
    assign min_height = '100vh'
  elsif section.settings.section_height == 'three_quarter'
    assign min_height = '75svh'
  elsif section.settings.section_height == 'custom'
    assign min_height = section.settings.custom_height | append: 'svh'
  endif
%}

{% style %}
  #CountdownHero-{{ section_id }} {
    --ch-bg-color: {{ bg_color }};
    --ch-text-color: {{ text_color }};
    --ch-min-height: {{ min_height }};
    --ch-content-max-width: {{ section.settings.content_max_width | default: 680 }}px;
    --ch-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --ch-padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --ch-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 40 }}px;
    --ch-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    --ch-anim-duration: {{ section.settings.animation_duration | default: 300 }}ms;

    position: relative;
    width: 100%;
    min-height: var(--ch-min-height);
    background-color: var(--ch-bg-color);
    color: var(--ch-text-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: var(--ch-padding-top);
    padding-bottom: var(--ch-padding-bottom);
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} {
      padding-top: var(--ch-padding-top-mobile);
      padding-bottom: var(--ch-padding-bottom-mobile);
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} {
      padding-top: 20px;
      padding-bottom: 20px;
    }
  }

  #CountdownHero-{{ section_id }} .countdown-hero__container {
    width: 100%;
    max-width: var(--ch-content-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__content-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Block base positioning & responsive margins */
  #CountdownHero-{{ section_id }} .countdown-hero__block {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: var(--m-top-d, 0px);
    margin-bottom: var(--m-bottom-d, 0px);
    z-index: var(--z-index, 10);
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block {
      margin-top: var(--m-top-m, 0px);
      margin-bottom: var(--m-bottom-m, 0px);
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block {
      margin-top: 0px !important;
    }
  }

  /* Desktop absolute positioning override */
  #CountdownHero-{{ section_id }} .countdown-hero__block[data-pos-desktop="true"] {
    position: absolute !important;
    top: var(--pos-top, auto);
    bottom: var(--pos-bottom, auto);
    left: var(--pos-left, auto);
    right: var(--pos-right, auto);
  }

  #CountdownHero-{{ section_id }} .countdown-hero__block[data-centered-desktop="true"] {
    left: 0 !important;
    right: 0 !important;
    margin-inline: auto !important;
    width: fit-content !important;
  }

  /* Mobile absolute positioning override */
  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block[data-pos-mobile="true"] {
      position: absolute !important;
      top: var(--pos-top-mobile, var(--pos-top, auto));
      bottom: var(--pos-bottom-mobile, var(--pos-bottom, auto));
      left: var(--pos-left-mobile, var(--pos-left, auto));
      right: var(--pos-right-mobile, var(--pos-right, auto));
    }

    #CountdownHero-{{ section_id }} .countdown-hero__block[data-centered-mobile="true"] {
      left: 0 !important;
      right: 0 !important;
      margin-inline: auto !important;
      width: fit-content !important;
    }
  }

  /* 1. Logo Block */
  #CountdownHero-{{ section_id }} .countdown-hero__logo-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__logo-img {
    display: block;
    width: var(--logo-width, 110px);
    height: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__logo-img {
      width: var(--logo-width-m, 95px);
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block--logo {
      margin-bottom: 16px !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__logo-img {
      width: 65px !important;
    }
  }

  /* 2. Preorder Text Block */
  #CountdownHero-{{ section_id }} .countdown-hero__preorder-text {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: var(--preorder-size, 13px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--preorder-spacing, 0.32em);
    color: var(--preorder-color, #e6e5dc);
    text-align: center;
    margin: 0;
    padding-left: var(--preorder-spacing, 0.32em);
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__preorder-text {
      font-size: var(--preorder-size-m, 10px);
      letter-spacing: var(--preorder-spacing-m, 0.3em);
      padding-left: var(--preorder-spacing-m, 0.3em);
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block--preorder {
      margin-bottom: 12px !important;
    }
  }

  /* 3. Countdown Timer Block */
  #CountdownHero-{{ section_id }} .countdown-hero__timer {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    font-family: 'Anton', var(--font-heading--family, 'Impact', sans-serif);
    font-size: var(--timer-size, 78px);
    line-height: 1;
    color: var(--timer-color, #f4f3ec);
    user-select: none;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__timer {
      max-width: 380px;
      font-size: var(--timer-size-m, 52px);
    }
  }

  @media screen and (max-width: 360px) {
    #CountdownHero-{{ section_id }} .countdown-hero__timer {
      font-size: 42px;
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block--countdown {
      margin-bottom: 6px !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__timer {
      font-size: 40px !important;
    }
  }

  #CountdownHero-{{ section_id }} .countdown-hero__unit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    height: 1.15em;
    width: 100%;
    min-width: 1.25em;
    line-height: 1.15em;
    text-align: center;
    vertical-align: middle;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    will-change: transform;
    transform: translateY(0);
    /* pure vertical translateY scroll only - NO opacity fades */
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit--current {
    transform: translateY(0);
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit--outgoing {
    transform: translateY(-100%);
    transition: transform 1s linear;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit--incoming {
    transform: translateY(100%);
  }

  #CountdownHero-{{ section_id }} .countdown-hero__digit--sliding-in {
    transform: translateY(0);
    transition: transform 1s linear;
  }

  /* Stable Colon Separator with custom square blocks */
  #CountdownHero-{{ section_id }} .countdown-hero__sep {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.36em;
    width: 0.45em;
    height: 1.08em;
    vertical-align: middle;
    margin: 0 clamp(4px, 1.2vw, 10px);
    user-select: none;
    color: var(--sep-color, #f4f3ec);
  }

  #CountdownHero-{{ section_id }} .countdown-hero__sep::before,
  #CountdownHero-{{ section_id }} .countdown-hero__sep::after {
    content: "";
    display: block;
    width: 0.12em;
    height: 0.12em;
    background-color: currentColor;
    border-radius: 0.015em;
  }

  /* Completed Message Container */
  #CountdownHero-{{ section_id }} .countdown-hero__completed-msg {
    display: none;
    font-size: clamp(16px, 2.5vw, 24px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    color: var(--timer-color, #f4f3ec);
  }

  #CountdownHero-{{ section_id }}[data-completed="true"] .countdown-hero__completed-msg {
    display: block;
  }

  #CountdownHero-{{ section_id }}[data-completed="true"][data-hide-timer="true"] .countdown-hero__timer {
    display: none;
  }

  /* 4. Unit Labels Block */
  #CountdownHero-{{ section_id }} .countdown-hero__labels {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: var(--label-size, 11px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--label-spacing, 0.22em);
    color: var(--label-color, #cccccc);
    user-select: none;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__labels {
      max-width: 380px;
      font-size: var(--label-size-m, 8px);
      letter-spacing: var(--label-spacing-m, 0.18em);
    }
  }

  @media screen and (max-width: 360px) {
    #CountdownHero-{{ section_id }} .countdown-hero__labels {
      font-size: 7.5px;
      letter-spacing: 0.12em;
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block--labels {
      margin-bottom: 16px !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__labels {
      font-size: 8px !important;
    }
  }

  #CountdownHero-{{ section_id }} .countdown-hero__label {
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: var(--label-spacing, 0.22em);
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__label {
      padding-left: var(--label-spacing-m, 0.18em);
    }
  }

  #CountdownHero-{{ section_id }} .countdown-hero__label-spacer {
    width: 0.45em;
    margin: 0 clamp(4px, 1.2vw, 10px);
    visibility: hidden;
  }

  /* 5. Stay Tuned Button Block */
  #CountdownHero-{{ section_id }} .countdown-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--btn-pad-v, 11px) var(--btn-pad-h, 34px);
    border-radius: var(--btn-radius, 9999px);
    border-width: var(--btn-border-w, 1px);
    border-style: solid;
    border-color: var(--btn-border-color, #ffffff);
    background-color: var(--btn-bg, transparent);
    color: var(--btn-color, #f4f3ec);
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: var(--btn-size, 13px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--btn-spacing, 0.26em);
    text-decoration: none;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, opacity 0.2s ease;
    padding-left: calc(var(--btn-pad-h, 34px) + var(--btn-spacing, 0.26em));
    line-height: 1.2;
    min-height: 42px;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__btn {
      padding: var(--btn-pad-v-m, 9px) var(--btn-pad-h-m, 28px);
      font-size: var(--btn-size-m, 10.5px);
      letter-spacing: var(--btn-spacing-m, 0.25em);
      padding-left: calc(var(--btn-pad-h-m, 28px) + var(--btn-spacing-m, 0.25em));
      min-height: 34px;
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__block--button {
      margin-bottom: 12px !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__btn {
      padding: 6px 22px !important;
      font-size: 10px !important;
      min-height: 30px !important;
    }
  }

  #CountdownHero-{{ section_id }} .countdown-hero__btn:hover {
    background-color: rgba(244, 243, 236, 0.12);
    border-color: #ffffff;
    color: #ffffff;
    opacity: 0.95;
  }

  #CountdownHero-{{ section_id }} .countdown-hero__btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* 6. Tagline Block */
  #CountdownHero-{{ section_id }} .countdown-hero__tagline {
    font-family: var(--font-body--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: var(--tagline-size, 11px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tagline-spacing, 0.45em);
    color: var(--tagline-color, #b5b4aa);
    text-align: center;
    margin: 0;
    padding-left: var(--tagline-spacing, 0.45em);
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    #CountdownHero-{{ section_id }} .countdown-hero__tagline {
      font-size: var(--tagline-size-m, 8.5px);
      letter-spacing: var(--tagline-spacing-m, 0.42em);
      padding-left: var(--tagline-spacing-m, 0.42em);
    }
  }

  @media screen and (max-height: 520px) {
    #CountdownHero-{{ section_id }} .countdown-hero__tagline {
      font-size: 8px !important;
    }
  }

  /* Accessibility visually hidden */
  #CountdownHero-{{ section_id }} .countdown-hero__sr-only {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }

  /* Accessibility: Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    #CountdownHero-{{ section_id }} .countdown-hero__digit {
      transition: none !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__digit--outgoing {
      display: none !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__digit--incoming {
      transform: translateY(0) !important;
      transition: none !important;
    }
    #CountdownHero-{{ section_id }} .countdown-hero__btn {
      transition: none !important;
    }
  }
{% endstyle %}

<div
  id="CountdownHero-{{ section_id }}"
  class="countdown-hero countdown-hero--{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-countdown-hero
  {{ section.shopify_attributes }}
>
  <div class="countdown-hero__container">
    <div class="countdown-hero__content-wrapper">

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            # Positioning checks
            assign is_pos_d = false
            if block.settings.pos_top != 'auto' and block.settings.pos_top != blank
              assign is_pos_d = true
            elsif block.settings.pos_bottom != 'auto' and block.settings.pos_bottom != blank
              assign is_pos_d = true
            elsif block.settings.pos_left != 'auto' and block.settings.pos_left != blank
              assign is_pos_d = true
            elsif block.settings.pos_right != 'auto' and block.settings.pos_right != blank
              assign is_pos_d = true
            endif

            assign is_pos_m = false
            if block.settings.pos_top_mobile != 'auto' and block.settings.pos_top_mobile != blank
              assign is_pos_m = true
            elsif block.settings.pos_bottom_mobile != 'auto' and block.settings.pos_bottom_mobile != blank
              assign is_pos_m = true
            elsif block.settings.pos_left_mobile != 'auto' and block.settings.pos_left_mobile != blank
              assign is_pos_m = true
            elsif block.settings.pos_right_mobile != 'auto' and block.settings.pos_right_mobile != blank
              assign is_pos_m = true
            elsif is_pos_d
              assign is_pos_m = true
            endif

            assign is_center_d = false
            assign is_center_m = false
            if block.settings.center_horizontally
              if is_pos_d
                assign is_center_d = true
              endif
              if is_pos_m
                assign is_center_m = true
              endif
            endif
          -%}

          <div
            id="CountdownBlock-{{ block.id }}"
            class="countdown-hero__block countdown-hero__block--{{ block.type }} countdown-hero__block--{{ block.id }}"
            data-pos-desktop="{{ is_pos_d }}"
            data-pos-mobile="{{ is_pos_m }}"
            data-centered-desktop="{{ is_center_d }}"
            data-centered-mobile="{{ is_center_m }}"
            style="
              --pos-top: {{ block.settings.pos_top | default: 'auto' }};
              --pos-bottom: {{ block.settings.pos_bottom | default: 'auto' }};
              --pos-left: {{ block.settings.pos_left | default: 'auto' }};
              --pos-right: {{ block.settings.pos_right | default: 'auto' }};
              --pos-top-mobile: {{ block.settings.pos_top_mobile | default: 'auto' }};
              --pos-bottom-mobile: {{ block.settings.pos_bottom_mobile | default: 'auto' }};
              --pos-left-mobile: {{ block.settings.pos_left_mobile | default: 'auto' }};
              --pos-right-mobile: {{ block.settings.pos_right_mobile | default: 'auto' }};
              --m-top-d: {{ block.settings.margin_top_desktop | default: 0 }}px;
              --m-top-m: {{ block.settings.margin_top_mobile | default: 0 }}px;
              --m-bottom-d: {{ block.settings.margin_bottom_desktop | default: 0 }}px;
              --m-bottom-m: {{ block.settings.margin_bottom_mobile | default: 0 }}px;
              --z-index: {{ block.settings.z_index | default: 10 }};
            "
            {{ block.shopify_attributes }}
          >
            {%- case block.type -%}
              {%- when 'logo' -%}
                <div
                  class="countdown-hero__logo-wrapper"
                  style="
                    --logo-width: {{ block.settings.logo_width | default: 110 }}px;
                    --logo-width-m: {{ block.settings.logo_width_mobile | default: 95 }}px;
                  "
                >
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'eager',
                        class: 'countdown-hero__logo-img',
                        alt: block.settings.logo_alt | default: 'Brand Logo'
                    }}
                  {%- else -%}
                    <img
                      src="{{ 'blacro-symbol-white@2x.png' | asset_url }}"
                      alt="{{ block.settings.logo_alt | default: 'Brand symbol' | escape }}"
                      class="countdown-hero__logo-img"
                      width="95"
                      height="70"
                      loading="eager"
                    >
                  {%- endif -%}
                </div>

              {%- when 'preorder_text' -%}
                <p
                  class="countdown-hero__preorder-text"
                  style="
                    --preorder-size: {{ block.settings.font_size_desktop | default: 13 }}px;
                    --preorder-size-m: {{ block.settings.font_size_mobile | default: 10 }}px;
                    --preorder-spacing: {{ block.settings.letter_spacing | default: 3 }}px;
                    --preorder-spacing-m: {{ block.settings.letter_spacing | default: 3 }}px;
                    --preorder-color: {{ block.settings.color | default: '#e6e5dc' }};
                  "
                >
                  {{ block.settings.text | default: 'PRE ORDERS BEGIN IN' }}
                </p>

              {%- when 'countdown' -%}
                <div
                  class="countdown-hero__timer"
                  role="timer"
                  aria-label="Preorders countdown timer"
                  data-countdown-timer
                  data-target-date="{{ block.settings.target_date | default: section.settings.target_date | escape }}"
                  data-enable-animation="{{ block.settings.enable_animation | default: section.settings.enable_animation | default: true }}"
                  data-animation-duration="{{ block.settings.animation_duration | default: section.settings.animation_duration | default: 300 }}"
                  data-expiry-action="{{ block.settings.completion_behavior | default: section.settings.completion_behavior | default: 'zero' }}"
                  data-completed-msg="{{ block.settings.completed_message | default: section.settings.completed_message | escape }}"
                  style="
                    --timer-size: {{ block.settings.font_size_desktop | default: 78 }}px;
                    --timer-size-m: {{ block.settings.font_size_mobile | default: 52 }}px;
                    --timer-color: {{ block.settings.color | default: '#f4f3ec' }};
                    --sep-color: {{ block.settings.separator_color | default: '#f4f3ec' }};
                  "
                >
                  <!-- Days Unit -->
                  <div class="countdown-hero__unit" data-unit="days">
                    <div class="countdown-hero__digit-slot" data-slot>
                      <span class="countdown-hero__digit countdown-hero__digit--current">02</span>
                    </div>
                  </div>

                  <div class="countdown-hero__sep" aria-hidden="true"></div>

                  <!-- Hours Unit -->
                  <div class="countdown-hero__unit" data-unit="hours">
                    <div class="countdown-hero__digit-slot" data-slot>
                      <span class="countdown-hero__digit countdown-hero__digit--current">11</span>
                    </div>
                  </div>


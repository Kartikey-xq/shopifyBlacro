{% liquid
  assign sec_settings = section.settings
  assign scheme = sec_settings.color_scheme
  if scheme != blank
    assign bg_color = scheme.settings.background
    assign text_color = scheme.settings.foreground
  else
    assign bg_color = 'var(--color-background)'
    assign text_color = 'var(--color-foreground)'
  endif
%}

{%- style -%}
  #Section-{{ section.id }} {
    {%- if sec_settings.custom_bg_color != blank -%}
      background-color: {{ sec_settings.custom_bg_color }};
      --color-background: {{ sec_settings.custom_bg_color }};
    {%- elsif bg_color != blank -%}
      background-color: {{ bg_color }};
      --color-background: {{ bg_color }};
    {%- endif -%}
    {%- if sec_settings.custom_text_color != blank -%}
      color: {{ sec_settings.custom_text_color }};
      --color-foreground: {{ sec_settings.custom_text_color }};
    {%- elsif text_color != blank -%}
      color: {{ text_color }};
      --color-foreground: {{ text_color }};
    {%- endif -%}
    --video-fit: {{ sec_settings.video_fit }};
    --mobile-video-height: {{ sec_settings.mobile_video_height }};
  }

  #Section-{{ section.id }} .product-split-features__text-column {
    background-color: #ffffff !important;
    color: #000000 !important;
    --color-background: #ffffff !important;
    --color-foreground: #000000 !important;
    --color-foreground-rgb: 0, 0, 0 !important;
  }

  {%- for block in section.blocks -%}
    {%- if block.type == 'text_point' -%}
      .block-{{ block.id }} .product-split-features__point-title {
        margin: 0 0 0.5rem 0;
        {%- if block.settings.title_text_color != blank -%}
          color: {{ block.settings.title_text_color }};
        {%- else -%}
          color: #000000 !important;
        {%- endif -%}

        {%- if block.settings.title_font_preset == 'body' -%}
          font-family: var(--font-paragraph--family);
          font-size: var(--font-paragraph--size, 1.6rem);
          font-weight: var(--font-paragraph--weight, 400);
          text-transform: var(--font-paragraph--case, none);
        {%- elsif block.settings.title_font_preset == 'subheading' -%}
          font-family: var(--font-subheading--family);
          font-size: var(--font-subheading--size, 1.8rem);
          font-weight: var(--font-subheading--weight, 600);
          text-transform: var(--font-subheading--case, none);
        {%- elsif block.settings.title_font_preset == 'heading' -%}
          font-family: var(--font-heading--family);
          font-size: var(--font-heading--size, 2rem);
          font-weight: var(--font-heading--weight, 700);
          text-transform: var(--font-heading--case, none);
        {%- elsif block.settings.title_font_preset == 'accent' -%}
          font-family: var(--font-accent--family);
          font-size: var(--font-accent--size, 1.4rem);
          font-weight: var(--font-accent--weight, 400);
          text-transform: var(--font-accent--case, none);
        {%- elsif block.settings.title_font_preset == 'custom' -%}
          font-family: {{ block.settings.title_font_family }};
          font-size: {{ block.settings.title_custom_size }}px;
          font-weight: {{ block.settings.title_font_weight }};
          text-transform: {{ block.settings.title_text_transform }};
        {%- endif -%}
      }

      .block-{{ block.id }} .product-split-features__point-text {
        {%- if block.settings.body_text_color != blank -%}
          color: {{ block.settings.body_text_color }};
        {%- else -%}
          color: #000000 !important;
        {%- endif -%}

        {%- if block.settings.body_font_preset == 'body' -%}
          font-family: var(--font-paragraph--family);
          font-size: var(--font-paragraph--size, 1.6rem);
          font-weight: var(--font-paragraph--weight, 400);
          text-transform: var(--font-paragraph--case, none);
        {%- elsif block.settings.body_font_preset == 'subheading' -%}
          font-family: var(--font-subheading--family);
          font-size: var(--font-subheading--size, 1.8rem);
          font-weight: var(--font-subheading--weight, 600);
          text-transform: var(--font-subheading--case, none);
        {%- elsif block.settings.body_font_preset == 'heading' -%}
          font-family: var(--font-heading--family);
          font-size: var(--font-heading--size, 2rem);
          font-weight: var(--font-heading--weight, 700);
          text-transform: var(--font-heading--case, none);
        {%- elsif block.settings.body_font_preset == 'accent' -%}
          font-family: var(--font-accent--family);
          font-size: var(--font-accent--size, 1.4rem);
          font-weight: var(--font-accent--weight, 400);
          text-transform: var(--font-accent--case, none);
        {%- elsif block.settings.body_font_preset == 'custom' -%}
          font-family: {{ block.settings.body_font_family }};
          font-size: {{ block.settings.body_custom_size }}px;
          font-weight: {{ block.settings.body_font_weight }};
          text-transform: {{ block.settings.body_text_transform }};
          line-height: var(--line-height--body-{{ block.settings.body_line_height }});
        {%- endif -%}
      }

      .block-{{ block.id }} {
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
    {%- endif -%}
  {%- endfor -%}

  @media screen and (max-width: 749px) {
    .mobile-video-first {
      flex-direction: column-reverse;
    }
    #Section-{{ section.id }} .product-split-features__video-column {
      height: 100vh;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .product-split-features {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .product-split-features {
      flex-direction: row;
      min-height: 100vh;
    }
    .product-split-features--text_left {
      flex-direction: row;
    }
    .product-split-features--text_right {
      flex-direction: row-reverse;
    }
  }

  .product-split-features__text-column {
    width: 100%;
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 5rem 2.5rem;
    box-sizing: border-box;
    background-color: #ffffff;
    color: #000000;
  }

  @media screen and (min-width: 750px) {
    .product-split-features__text-column {
      width: 50%;
      flex: 1 1 50%;
      min-height: 100vh;
      padding: 8rem 5rem;
    }
  }

  .product-split-features__text-container {
    max-width: 580px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .product-split-features__point ul,
  .product-split-features__point ol {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .product-split-features__point li {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .product-split-features__point li::before {
    content: none !important;
  }

  .product-split-features__video-column {
    width: 100%;
    flex: none;
    position: relative;
    overflow: hidden;
    height: var(--mobile-video-height, 60vh);
  }

  @media screen and (min-width: 750px) {
    .product-split-features__video-column {
      width: 50%;
      flex: 1 1 50%;
      height: 100vh;
    }
  }

  .product-split-features__video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .product-split-features__video {
    width: 100%;
    height: 100%;
    object-fit: var(--video-fit, cover);
    display: block;
    border: none;
  }

  .product-split-features__video-wrapper svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    fill: rgb(var(--color-foreground-rgb) / 0.15);
  }
{% endstylesheet %}

<div
  id="Section-{{ section.id }}"
  class="product-split-features color-{{ sec_settings.color_scheme }} product-split-features--{{ sec_settings.desktop_layout }}{% if section.settings.mobile_stack_order == 'video_first' %} mobile-video-first{% endif %}"
>
  <div class="product-split-features__text-column">
    <div class="product-split-features__text-container">
      {%- for block in section.blocks -%}
        {%- if block.type == 'text_point' -%}
          {%- liquid
            assign block_title = block.settings.title
            assign metafield_source = block.settings.metafield_key | default: 'auto'

            if metafield_source == 'auto'
              assign title_clean = block.settings.title | downcase | strip
              if title_clean contains 'top length'
                assign metafield_source = 'top-length-type'
              elsif title_clean contains 'neckline'
                assign metafield_source = 'neckline'
              elsif title_clean contains 'sleeve'
                assign metafield_source = 'sleeve-length-type'
              elsif title_clean contains 'color'
                assign metafield_source = 'color-pattern'
              else
                assign metafield_source = 'none'
              endif
            endif

            assign target_metafield = blank
            assign is_metafield = true

            case metafield_source
              when 'top-length-type'
                assign target_metafield = product.metafields.shopify['top-length-type']
                if block_title == blank
                  assign block_title = 'Top length type'
                endif
              when 'neckline'
                assign target_metafield = product.metafields.shopify.neckline
                if block_title == blank
                  assign block_title = 'Neckline type'
                endif
              when 'sleeve-length-type'
                assign target_metafield = product.metafields.shopify['sleeve-length-type']
                if block_title == blank
                  assign block_title = 'Sleeve length type'
                endif
              when 'color-pattern'
                assign target_metafield = product.metafields.shopify['color-pattern']
                if block_title == blank
                  assign block_title = 'Color'
                endif
              else
                assign is_metafield = false
            endcase

            assign display_value = ''

            if is_metafield
              if target_metafield != blank and target_metafield.value != blank
                for item in target_metafield.value
                  assign item_label = item.label.value | default: item.label | default: item.name | default: item | strip_html | strip
                  if item_label != blank
                    if display_value == ''
                      assign display_value = item_label
                    else
                      assign display_value = display_value | append: ', ' | append: item_label
                    endif
                  endif
                endfor
                if display_value == ''
                  assign single_item = target_metafield.value
                  assign item_label = single_item.label.value | default: single_item.label | default: single_item.name | default: single_item | strip_html | strip
                  assign display_value = item_label
                endif
              endif
            else
              assign raw_text = block.settings.text | strip_html | strip
              if raw_text != blank and raw_text != 'Dynamically link to metafield or write descriptive features.'
                unless block.settings.text contains 'product.metafields'
                  assign display_value = block.settings.text
                endunless
              endif
            endif
          -%}
          
          {%- if display_value != blank -%}
            <div class="product-split-features__point block-{{ block.id }}" {{ block.shopify_attributes }}>
              {%- if block_title != blank -%}
                <h4 class="product-split-features__point-title">{{ block_title }}</h4>
              {%- endif -%}
              <div class="product-split-features__point-text">
                {%- if is_metafield -%}
                  <p>{{ display_value }}</p>
                {%- else -%}
                  {{ display_value }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="product-split-features__video-column">
    <div class="product-split-features__video-wrapper">
      {%- liquid
        assign found_video = blank
        for media in product.media
          if media.media_type == 'video' or media.media_type == 'external_video'
            assign found_video = media
            break
          endif
        endfor
      -%}
      {%- if found_video != blank -%}
        {%- if found_video.media_type == 'video' -%}
          {{
            found_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'product-split-features__video'
          }}
        {%- elsif found_video.media_type == 'external_video' -%}
          {{
            found_video
            | external_video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'product-split-features__video'
          }}
        {%- endif -%}
      {%- else -%}
        {%- assign fallback_image = product.featured_image | default: product.media[0] -%}
        {%- if fallback_image != blank -%}
          {{
            fallback_image
            | image_url: width: 1400
            | image_tag:
              class: 'product-split-features__video',
              widths: '375, 550, 750, 1100, 1500, 1780, 2000',
              alt: fallback_image.alt | escape
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom 50/50 Video Split",
  "tag": "section",
  "class": "section-product-split-features-video",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "select",
      "id": "video_fit",
      "label": "Video Aspect Ratio / Fit",
      "options": [
        { "value": "cover", "label": "Cover (Full height split)" },
        { "value": "contain", "label": "Contain (Original ratio)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop Layout",
      "options": [
        { "value": "text_left", "label": "Text Left / Video Right" },
        { "value": "text_right", "label": "Video Left / Text Right" }
      ],
      "default": "text_left"
    },
    {
      "type": "select",
      "id": "mobile_video_height",
      "label": "Mobile Video Height",
      "options": [
        { "value": "30vh", "label": "Small (30vh)" },
        { "value": "50vh", "label": "Medium (50vh)" },
        { "value": "60vh", "label": "Large (60vh)" },
        { "value": "80vh", "label": "Extra Large (80vh)" },
        { "value": "100vh", "label": "Full Screen (100vh)" }
      ],
      "default": "60vh"
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom Background Color Override",
      "alpha": true
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "Custom Text Color Override",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_stack_order",
      "label": "Mobile stack order",
      "default": "text_first",
      "options": [
        { "value": "text_first", "label": "Text on top, video on bottom" },
        { "value": "video_first", "label": "Video on top, text on bottom" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "text_point",
      "name": "Bullet Text Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bullet Point Title",
          "info": "Leave blank to automatically detect name from metafield."
        },
        {
          "type": "select",
          "id": "metafield_key",
          "label": "Metafield source",
          "options": [
            { "value": "auto", "label": "Automatic (from title)" },
            { "value": "top-length-type", "label": "Top length type" },
            { "value": "neckline", "label": "Neckline type" },
            { "value": "sleeve-length-type", "label": "Sleeve length type" },
            { "value": "color-pattern", "label": "Color" },
            { "value": "none", "label": "None (Custom text)" }
          ],
          "default": "auto",
          "info": "Automatically pull values from product taxonomy metafields."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Bullet Point Text",
          "default": "<p>Dynamically link to metafield or write descriptive features.</p>"
        },
        {
          "type": "header",
          "content": "Title Typography"
        },
        {
          "type": "select",
          "id": "title_font_preset",
          "label": "Title Font Preset",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subheading", "label": "Subheading" },
            { "value": "heading", "label": "Heading" },
            { "value": "accent", "label": "Accent" },
            { "value": "custom", "label": "Custom size" }
          ],
          "default": "subheading"
        },
        {
          "type": "select",
          "id": "title_font_family",
          "label": "Title Font Family",
          "options": [
            { "value": "var(--font-body--family)", "label": "Body" },
            { "value": "var(--font-subheading--family)", "label": "Subheading" },
            { "value": "var(--font-heading--family)", "label": "Heading" },
            { "value": "var(--font-accent--family)", "label": "Accent" }
          ],
          "default": "var(--font-subheading--family)",
          "visible_if": "{{ block.settings.title_font_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "title_custom_size",
          "min": 10,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Title Custom Font Size",
          "default": 18,
          "visible_if": "{{ block.settings.title_font_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "title_font_weight",
          "label": "Title Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "600",
          "visible_if": "{{ block.settings.title_font_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "title_text_transform",
          "label": "Title Case",
          "options": [
            { "value": "none", "label": "Normal" },
            { "value": "uppercase", "label": "Uppercase" }
          ],
          "default": "none",
          "visible_if": "{{ block.settings.title_font_preset == 'custom' }}"
        },
        {
          "type": "color",
          "id": "title_text_color",
          "label": "Title Text Color Override",
          "alpha": true
        },
        {
          "type": "header",
          "content": "Body Typography"
        },
        {
          "type": "select",
          "id": "body_font_preset",
          "label": "Body Font Preset",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subheading", "label": "Subheading" },
            { "value": "heading", "label": "Heading" },
            { "value": "accent", "label": "Accent" },
            { "value": "custom", "label": "Custom size" }
          ],
          "default": "body"
        },
        {
          "type": "select",
          "id": "body_font_family",
          "label": "Body Font Family",
          "options": [
            { "value": "var(--font-body--family)", "label": "Body" },
            { "value": "var(--font-subheading--family)", "label": "Subheading" },
            { "value": "var(--font-heading--family)", "label": "Heading" },
            { "value": "var(--font-accent--family)", "label": "Accent" }
          ],
          "default": "var(--font-body--family)",
          "visible_if": "{{ block.settings.body_font_preset == 'custom' }}"
        },
        {
          "type": "range",
          "id": "body_custom_size",
          "min": 10,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Body Custom Font Size",
          "default": 16,
          "visible_if": "{{ block.settings.body_font_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "body_font_weight",
          "label": "Body Font Weight",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "400",
          "visible_if": "{{ block.settings.body_font_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "body_line_height",
          "label": "Body Line Height",
          "options": [
            { "value": "tight", "label": "Tight" },
            { "value": "normal", "label": "Normal" },
            { "value": "loose", "label": "Loose" }
          ],
          "default": "normal",
          "visible_if": "{{ block.settings.body_font_preset == 'custom' }}"
        },
        {
          "type": "select",
          "id": "body_text_transform",
          "label": "Body Case",
          "options": [
            { "value": "none", "label": "Normal" },
            { "value": "uppercase", "label": "Uppercase" }
          ],
          "default": "none",
          "visible_if": "{{ block.settings.body_font_preset == 'custom' }}"
        },
        {
          "type": "color",
          "id": "body_text_color",
          "label": "Body Text Color Override",
          "alpha": true
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Bottom Spacing",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 16
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom 50/50 Video Split",
      "blocks": [
        { "type": "text_point" },
        { "type": "text_point" },
        { "type": "text_point" }
      ]
    }
  ]
}
{% endschema %}

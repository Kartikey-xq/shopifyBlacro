

{% liquid
  assign block_settings = block.settings
  assign text = block_settings.text
  if text == blank
    assign product = closest.product
    if request.visual_preview_mode and product == blank
      assign product = collections.all.products.first
    endif
    assign text = product.description
  endif
%}

{%- if block_settings.background -%}
  {%- assign bg_color = block_settings.background_color -%}
  {%- assign bg_color_transparent = bg_color | color_modify: 'alpha', 0 -%}
{%- else -%}
  {%- assign bg_color = 'var(--color-background)' -%}
  {%- assign bg_color_transparent = 'rgb(var(--color-background-rgb) / 0)' -%}
{%- endif -%}

{% style %}
  .block-{{ block.id }} {
    {% render 'spacing-padding', settings: block_settings %}
    {% if block_settings.background %}
      background-color: {{ block_settings.background_color | default: 'rgb(255 255 255 / 1.0)' }};
      border-radius: {{ block_settings.corner_radius }}px;
    {% endif %}
  }

  .block-{{ block.id }} .expandable-description__title {
    margin: 0 0 1rem 0;
    {% if block_settings.title_font == 'body' %}
      font-family: var(--font-paragraph--family);
      font-size: var(--font-paragraph--size, 1.6rem);
      font-weight: var(--font-paragraph--weight, 400);
      text-transform: var(--font-paragraph--case, none);
    {% elsif block_settings.title_font == 'subheading' %}
      font-family: var(--font-subheading--family);
      font-size: var(--font-subheading--size, 1.8rem);
      font-weight: var(--font-subheading--weight, 600);
      text-transform: var(--font-subheading--case, none);
    {% elsif block_settings.title_font == 'heading' %}
      font-family: var(--font-heading--family);
      font-size: var(--font-heading--size, 2rem);
      font-weight: var(--font-heading--weight, 700);
      text-transform: var(--font-heading--case, none);
    {% elsif block_settings.title_font == 'accent' %}
      font-family: var(--font-accent--family);
      font-size: var(--font-accent--size, 1.4rem);
      font-weight: var(--font-accent--weight, 400);
      text-transform: var(--font-accent--case, none);
    {% elsif block_settings.title_font == 'custom' %}
      font-family: {{ block_settings.title_font_family }};
      font-size: {{ block_settings.title_custom_size }}px;
      font-weight: {{ block_settings.title_font_weight }};
      text-transform: {{ block_settings.title_text_transform }};
    {% endif %}
    {% if block_settings.title_color != blank %}
      color: {{ block_settings.title_color }};
    {% endif %}
  }

  .block-{{ block.id }} .expandable-description__content {
    {% if block_settings.body_font == 'body' %}
      font-family: var(--font-paragraph--family);
      font-size: var(--font-paragraph--size, 1.6rem);
      font-weight: var(--font-paragraph--weight, 400);
      text-transform: var(--font-paragraph--case, none);
    {% elsif block_settings.body_font == 'subheading' %}
      font-family: var(--font-subheading--family);
      font-size: var(--font-subheading--size, 1.8rem);
      font-weight: var(--font-subheading--weight, 600);
      text-transform: var(--font-subheading--case, none);
    {% elsif block_settings.body_font == 'heading' %}
      font-family: var(--font-heading--family);
      font-size: var(--font-heading--size, 2rem);
      font-weight: var(--font-heading--weight, 700);
      text-transform: var(--font-heading--case, none);
    {% elsif block_settings.body_font == 'accent' %}
      font-family: var(--font-accent--family);
      font-size: var(--font-accent--size, 1.4rem);
      font-weight: var(--font-accent--weight, 400);
      text-transform: var(--font-accent--case, none);
    {% elsif block_settings.body_font == 'custom' %}
      font-family: {{ block_settings.body_font_family }};
      font-size: {{ block_settings.body_custom_size }}px;
      font-weight: {{ block_settings.body_font_weight }};
      line-height: var(--line-height--body-{{ block_settings.body_line_height }});
    {% endif %}
    {% if block_settings.body_color != blank %}
      color: {{ block_settings.body_color }};
    {% endif %}
  }

  .block-{{ block.id }} .expandable-description__button {
    background: none;
    border: none;
    padding: 0.5rem 0;
    margin-top: 0.5rem;
    cursor: pointer;
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    position: relative;
    z-index: 2;
    transform: none;
    filter: none;
    opacity: 1;
    will-change: auto;
    {% if block_settings.read_more_font == 'body' %}
      font-family: var(--font-paragraph--family);
      font-size: var(--font-paragraph--size, 1.6rem);
      font-weight: var(--font-paragraph--weight, 400);
      text-transform: var(--font-paragraph--case, none);
    {% elsif block_settings.read_more_font == 'subheading' %}
      font-family: var(--font-subheading--family);
      font-size: var(--font-subheading--size, 1.8rem);
      font-weight: var(--font-subheading--weight, 600);
      text-transform: var(--font-subheading--case, none);
    {% elsif block_settings.read_more_font == 'heading' %}
      font-family: var(--font-heading--family);
      font-size: var(--font-heading--size, 2rem);
      font-weight: var(--font-heading--weight, 700);
      text-transform: var(--font-heading--case, none);
    {% elsif block_settings.read_more_font == 'accent' %}
      font-family: var(--font-accent--family);
      font-size: var(--font-accent--size, 1.4rem);
      font-weight: var(--font-accent--weight, 400);
      text-transform: var(--font-accent--case, none);
    {% elsif block_settings.read_more_font == 'custom' %}
      font-family: {{ block_settings.read_more_font_family }};
      font-size: {{ block_settings.read_more_custom_size }}px;
      font-weight: {{ block_settings.read_more_font_weight }};
      text-transform: {{ block_settings.read_more_text_transform }};
    {% endif %}
    {% if block_settings.read_more_color != blank %}
      color: {{ block_settings.read_more_color }};
    {% else %}
      color: var(--color-primary, currentColor);
    {% endif %}
  }

  .block-{{ block.id }} .expandable-description {
    display: block;
    contain: layout style;
  }
  .block-{{ block.id }} .expandable-description__container {
    position: relative;
    max-height: 80px;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: max-height;
    isolation: isolate;
  }
  .block-{{ block.id }} .expandable-description__container::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3.5rem;
    background: linear-gradient(to bottom, {{ bg_color_transparent }} 0%, {{ bg_color }} 85%);
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 1;
  }
  .block-{{ block.id }} .expandable-description.is-expanded .expandable-description__container::after {
    opacity: 0;
  }
  .block-{{ block.id }} .expandable-description__button:hover {
    opacity: 0.8;
  }
{% endstyle %}

<div class="block-{{ block.id }}">
  <expandable-description class="expandable-description" data-truncated-height="80" {{ block.shopify_attributes }}>
    {%- if block_settings.title != blank -%}
      <h3 class="expandable-description__title">{{ block_settings.title }}</h3>
    {%- endif -%}
    <div class="expandable-description__container">
      <div class="expandable-description__content rte">
        {{ text }}
      </div>
    </div>
    <button type="button" class="expandable-description__button" aria-expanded="false" style="display: none;">
      <span class="expandable-description__button-text">{{ 'Read More' }}</span>
    </button>
  </expandable-description>
</div>

<script>
  if (!customElements.get('expandable-description')) {
    class ExpandableDescription extends HTMLElement {
      connectedCallback() {
        this.container = this.querySelector('.expandable-description__container');
        this.content = this.querySelector('.expandable-description__content');
        this.button = this.querySelector('.expandable-description__button');
        this.buttonText = this.querySelector('.expandable-description__button-text');
        this.truncatedHeight = parseInt(this.getAttribute('data-truncated-height') || '80', 10);
        
        if (this.button) {
          this.button.addEventListener('click', () => this.toggle());
        }

        this.resizeObserver = new ResizeObserver(() => this.checkTruncation());
        this.resizeObserver.observe(this.content);
      }

      disconnectedCallback() {
        if (this.resizeObserver) {
          this.resizeObserver.disconnect();
        }
      }

      checkTruncation() {
        if (this.classList.contains('is-expanded')) return;

        const scrollHeight = this.content.scrollHeight;
        if (scrollHeight <= this.truncatedHeight + 10) {
          this.button.style.display = 'none';
          this.container.style.maxHeight = 'none';
        } else {
          this.button.style.display = 'inline-flex';
          this.container.style.maxHeight = `${this.truncatedHeight}px`;
        }
      }

      toggle() {
        const isExpanded = this.classList.contains('is-expanded');
        if (isExpanded) {
          const scrollHeight = this.content.scrollHeight;
          this.container.style.maxHeight = `${scrollHeight}px`;
          this.container.offsetHeight; // force reflow
          this.container.style.maxHeight = `${this.truncatedHeight}px`;
          this.classList.remove('is-expanded');
          this.buttonText.textContent = 'Read More';
          this.button.setAttribute('aria-expanded', 'false');
          this.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          const scrollHeight = this.content.scrollHeight;
          this.container.style.maxHeight = `${scrollHeight}px`;
          this.classList.add('is-expanded');
          this.buttonText.textContent = 'Read Less';
          this.button.setAttribute('aria-expanded', 'true');
          
          const onTransitionEnd = (e) => {
            if (e.propertyName === 'max-height' && this.classList.contains('is-expanded')) {
              this.container.style.maxHeight = 'none';
              this.container.removeEventListener('transitionend', onTransitionEnd);
            }
          };
          this.container.addEventListener('transitionend', onTransitionEnd);
        }
      }
    }
    customElements.define('expandable-description', ExpandableDescription);
  }
</script>

{% schema %}
{
  "name": "t:names.product_description",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Block Title",
      "default": "Product Details"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "Leave blank to dynamically connect to the product description resource."
    },
    {
      "type": "header",
      "content": "Title Typography"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Title Font Preset",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "heading", "label": "Heading" },
        { "value": "accent", "label": "Accent" },
        { "value": "custom", "label": "Custom size" }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "title_font_family",
      "label": "Title Font Family",
      "options": [
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)",
      "visible_if": "{{ block.settings.title_font == 'custom' }}"
    },
    {

{%- style -%}
  #ProductInfoTabs-{{ block.id }} {
    display: block;
    margin-top: {{ block.settings.margin_top | default: 20 }}px;
    margin-bottom: {{ block.settings.margin_bottom | default: 20 }}px;
    padding-top: {{ block.settings.padding_top | default: 16 }}px;
    padding-bottom: {{ block.settings.padding_bottom | default: 16 }}px;
    width: 100%;
    box-sizing: border-box;
  }

  .product-info-tabs-{{ block.id }} {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid {{ block.settings.border_color | default: '#e5e5e5' }};
    border-radius: {{ block.settings.corner_radius | default: 8 }}px;
    overflow: hidden;
  }

  .product-info-tabs-{{ block.id }} .tabs-nav {
    display: flex;
    width: 100%;
    flex-wrap: nowrap;
    border-bottom: 1px solid {{ block.settings.border_color | default: '#e5e5e5' }};
    background: transparent;
    padding: 0;
    margin: 0;
  }

  .product-info-tabs-{{ block.id }} .tab-button {
    flex: 1 1 0;
    width: 0;
    text-align: center;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-family: inherit;
    font-size: clamp(11px, 3vw, 14px);
    color: {{ block.settings.inactive_tab_color | default: '#666666' }};
    font-weight: 400;
    padding: 10px 8px;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    outline: none;
  }

  @media screen and (min-width: 768px) {
    .product-info-tabs-{{ block.id }} .tab-button {
      padding: 12px 16px;
    }
  }

  .product-info-tabs-{{ block.id }} .tab-button:hover {
    color: {{ block.settings.active_tab_color | default: '#000000' }};
  }

  .product-info-tabs-{{ block.id }} .tab-button.active {
    color: {{ block.settings.active_tab_color | default: '#000000' }};
    font-weight: 600;
    border-bottom-color: {{ block.settings.active_tab_color | default: '#000000' }};
  }

  .product-info-tabs-{{ block.id }} .tabs-content {
    padding: 12px;
    min-height: 120px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .product-info-tabs-{{ block.id }} .tabs-content {
      padding: 16px;
    }
  }

  .product-info-tabs-{{ block.id }} .tab-panel {
    display: none;
    outline: none;
  }

  .product-info-tabs-{{ block.id }} .tab-panel.active {
    display: block;
    animation: fadeInTabs-{{ block.id }} 0.25s ease-in-out;
  }

  @keyframes fadeInTabs-{{ block.id }} {
    from { opacity: 0; transform: translateY(2px); }
    to { opacity: 1; transform: translateY(0); }
  }
{%- endstyle -%}

<div id="ProductInfoTabs-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="product-info-tabs-{{ block.id }}">
    <div class="tabs-nav" role="tablist" aria-label="Product Information">
      <button
        class="tab-button active"
        role="tab"
        aria-selected="true"
        aria-controls="ProductInfoPanel-{{ block.id }}-1"
        id="ProductInfoBtn-{{ block.id }}-1"
        tabindex="0"
        type="button"
        data-tab="1"
      >
        {{ block.settings.tab_1_label | default: 'Product Details' }}
      </button>
      <button
        class="tab-button"
        role="tab"
        aria-selected="false"
        aria-controls="ProductInfoPanel-{{ block.id }}-2"
        id="ProductInfoBtn-{{ block.id }}-2"
        tabindex="-1"
        type="button"
        data-tab="2"
      >
        {{ block.settings.tab_2_label | default: 'Shipping & Returns' }}
      </button>
      <button
        class="tab-button"
        role="tab"
        aria-selected="false"
        aria-controls="ProductInfoPanel-{{ block.id }}-3"
        id="ProductInfoBtn-{{ block.id }}-3"
        tabindex="-1"
        type="button"
        data-tab="3"
      >
        {{ block.settings.tab_3_label | default: 'Wash Care' }}
      </button>
    </div>

    <div class="tabs-content">
      <div
        class="tab-panel active"
        id="ProductInfoPanel-{{ block.id }}-1"
        role="tabpanel"
        aria-labelledby="ProductInfoBtn-{{ block.id }}-1"
        data-tab-panel="1"
      >
        <div class="tab-panel-body rte">
          {{ block.settings.tab_1_content }}
        </div>
      </div>
      <div
        class="tab-panel"
        id="ProductInfoPanel-{{ block.id }}-2"
        role="tabpanel"
        aria-labelledby="ProductInfoBtn-{{ block.id }}-2"
        hidden
        data-tab-panel="2"
      >
        <div class="tab-panel-body rte">
          {{ block.settings.tab_2_content }}
        </div>
      </div>
      <div
        class="tab-panel"
        id="ProductInfoPanel-{{ block.id }}-3"
        role="tabpanel"
        aria-labelledby="ProductInfoBtn-{{ block.id }}-3"
        hidden
        data-tab-panel="3"
      >
        <div class="tab-panel-body rte">
          {{ block.settings.tab_3_content }}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const blockContainer = document.getElementById('ProductInfoTabs-{{ block.id }}');
    if (!blockContainer) return;

    const tabButtons = Array.from(blockContainer.querySelectorAll('.tab-button'));
    const tabPanels = Array.from(blockContainer.querySelectorAll('.tab-panel'));

    function switchTab(activeBtn) {
      const activeTabId = activeBtn.getAttribute('data-tab');

      tabButtons.forEach(btn => {
        const isCurrent = btn === activeBtn;
        btn.classList.toggle('active', isCurrent);
        btn.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        btn.setAttribute('tabindex', isCurrent ? '0' : '-1');
      });

      tabPanels.forEach(panel => {
        const panelTabId = panel.getAttribute('data-tab-panel');
        const isCurrent = panelTabId === activeTabId;
        panel.classList.toggle('active', isCurrent);
        panel.hidden = !isCurrent;
      });
    }

    tabButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        switchTab(btn);
      });

      btn.addEventListener('keydown', (e) => {
        let targetIndex = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          targetIndex = (index + 1) % tabButtons.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          targetIndex = (index - 1 + tabButtons.length) % tabButtons.length;
        } else if (e.key === 'Home') {
          targetIndex = 0;
        } else if (e.key === 'End') {
          targetIndex = tabButtons.length - 1;
        }

        if (targetIndex !== null) {
          e.preventDefault();
          const targetTab = tabButtons[targetIndex];
          targetTab.focus();
          switchTab(targetTab);
        }
      });
    });
  })();
</script>


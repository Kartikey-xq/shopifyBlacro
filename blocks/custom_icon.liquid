{% comment %}
  Custom Icon block.
  Supports SVG/Image file picker, absolute positioning and scaling.
{% endcomment %}

<style>
  #shopify-block-{{ block.id }} {
    display: contents !important;
  }
  #custom-icon-{{ block.id }} {
    height: {{ block.settings.icon_height | divided_by: 10.0 }}px !important;
  }
  #custom-icon-{{ block.id }} img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
</style>

<div
  id="custom-icon-{{ block.id }}"
  class="custom-position-block custom-icon-block"
  style="
    {% render 'custom-block-styles', settings: block.settings, type: 'text' %}
    --custom-width: {{ block.settings.icon_width | divided_by: 10.0 }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.icon_file != blank -%}
    <img src="{{ block.settings.icon_file | image_url }}" alt="" width="100" height="100">
  {%- else -%}
    <!-- Simple visible fallback placeholder in editor if no file is selected -->
    <div style="width: 100%; height: 100%; border: 2px dashed rgba(255,255,255,0.4); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10px;">SVG</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Icon",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Icon Source"
    },
    {
      "type": "image_picker",
      "id": "icon_file",
      "label": "Upload SVG"
    },
    {
      "type": "header",
      "content": "Positioning Settings"
    },
    {
      "type": "text",
      "id": "pos_top",
      "label": "Top Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom",
      "label": "Bottom Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left",
      "label": "Left Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_right",
      "label": "Right Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_top_mobile",
      "label": "Top Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom_mobile",
      "label": "Bottom Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left_mobile",
      "label": "Left Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_right_mobile",
      "label": "Right Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Sizing"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon Width",
      "min": 5,
      "max": 5005,
      "step": 50,
      "default": 505,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon Height",
      "min": 5,
      "max": 5005,
      "step": 50,
      "default": 505,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Custom Icon"
    }
  ]
}
{% endschema %}

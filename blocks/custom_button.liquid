{% comment %}
  Custom Button block. Absolute positioning, custom button styles (padding, background, border, colors), optional custom icon upload.
{% endcomment %}

<div 
  class="{% if block.settings.center_horizontally %}custom-button-block--centered{% else %}custom-position-block{% endif %} custom-font-style"
  style="{% render 'custom-block-styles', settings: block.settings, block: block, type: 'button' %}"
  aria-label="Scroll to collection"
  {{ block.shopify_attributes }}
>
  <a
    {%- if block.settings.link != blank -%}
      href="{{ block.settings.link }}"
      {%- if block.settings.open_in_new_tab -%}
        target="_blank"
        rel="noopener noreferrer"
      {%- endif -%}
    {%- endif -%}
    class="custom-button custom-button--icon-{{ block.settings.icon_position }}{% if block.settings.button_style != 'custom' and block.settings.button_style != blank %} {{ block.settings.button_style }}{% endif %}"
    {%- liquid
      assign b_width = block.settings.border_width | default: 1
      assign b_style = block.settings.border_style | default: 'solid'
      assign b_color = block.settings.border_color
      if b_color == blank or b_color == 'rgba(0,0,0,0)'
        assign b_color = '#000000'
      endif
      assign b_radius = block.settings.border_radius | default: 4
      assign is_custom = false
      if block.settings.button_style == 'custom' or block.settings.button_style == blank or block.settings.button_style == nil
        assign is_custom = true
      endif
    -%}
    style="
      --custom-btn-border-width: {{ b_width }}px;
      --custom-btn-border-style: {{ b_style }};
      --custom-btn-border-color: {{ b_color }};
      --custom-btn-border-radius: {{ b_radius }}px;
      --border-width: {{ b_width }}px;
      --border-style: {{ b_style }};
      --border-color: {{ b_color }};
      --border-radius: {{ b_radius }}px;
      box-sizing: border-box !important;
      {%- if is_custom -%}
        border: {{ b_width }}px {{ b_style }} {{ b_color }} !important;
        border-width: {{ b_width }}px !important;
        border-style: {{ b_style }} !important;
        border-color: {{ b_color }} !important;
        border-radius: {{ b_radius }}px !important;
        background-color: {{ block.settings.bg_color | default: 'transparent' }} !important;
        color: {{ block.settings.btn_text_color | default: 'inherit' }} !important;
        padding: {{ block.settings.pad_top | default: 12 }}px {{ block.settings.pad_right | default: 24 }}px {{ block.settings.pad_bottom | default: 12 }}px {{ block.settings.pad_left | default: 24 }}px !important;
      {%- elsif b_width > 0 -%}
        border: {{ b_width }}px {{ b_style }} {{ b_color }} !important;
        border-width: {{ b_width }}px !important;
        border-style: {{ b_style }} !important;
        border-color: {{ b_color }} !important;
        border-radius: {{ b_radius }}px !important;
      {%- endif -%}
    "
  >
    {%- if block.settings.icon_image != blank -%}
      {%- if block.settings.icon_position == 'left' or block.settings.icon_position == 'left-top' or block.settings.icon_position == 'top' -%}
        <span class="custom-button-icon" style="--icon-mask: url('{{ block.settings.icon_image | image_url: width: 100 }}');">
          {{ block.settings.icon_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.icon_image.alt }}
        </span>
      {%- endif -%}
    {%- endif -%}

    <span>{{ block.settings.label | default: 'Click here' }}</span>

    {%- if block.settings.icon_image != blank -%}
      {%- if block.settings.icon_position == 'right-center' or block.settings.icon_position == 'right-top' or block.settings.icon_position == 'bottom' -%}
        <span class="custom-button-icon" style="--icon-mask: url('{{ block.settings.icon_image | image_url: width: 100 }}');">
          {{ block.settings.icon_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: block.settings.icon_image.alt }}
        </span>
      {%- endif -%}
    {%- endif -%}
  </a>
</div>

{% schema %}
{
  "name": "Custom Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button Label",
      "default": "Click here"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "custom", "label": "Custom" },
        { "value": "button", "label": "Primary" },
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ],
      "default": "custom"
    },
    {
      "type": "header",
      "content": "Layout & Sizing Settings"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "100%", "label": "Fill" }
      ],
      "default": "fit-content"
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "pad_left",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "pad_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 4,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "alpha": true,
      "default": "#ffffff",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "alpha": true,
      "default": "#000000",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 1,
      "unit": "px",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "alpha": true,
      "default": "#000000",
      "visible_if": "{{ block.settings.button_style == \"custom\" }}"
    },
    {
      "type": "header",
      "content": "Icon Support"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "left-top", "label": "Left Top" },
        { "value": "right-center", "label": "Right Center" },
        { "value": "right-top", "label": "Right Top" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 8,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon Spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "select",
      "id": "font_preset",
      "label": "Font Preset",
      "options": [
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "body", "label": "Body" },
        { "value": "accent", "label": "Accent" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "custom_font_family",
      "label": "Font family",
      "options": [
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "body", "label": "Body" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "body"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Custom Typography Color",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Custom Font Size (px)",
      "min": 10,
      "max": 110,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 0.8,
      "max": 3.0,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Positioning Settings"
    },
    {
      "type": "checkbox",
      "id": "center_horizontally",
      "label": "Center Horizontally",
      "default": false
    },
    {
      "type": "text",
      "id": "pos_top",
      "label": "Top Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom",
      "label": "Bottom Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left",
      "label": "Left Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto",
      "visible_if": "{{ block.settings.center_horizontally == false }}"
    },
    {
      "type": "text",
      "id": "pos_right",
      "label": "Right Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto",
      "visible_if": "{{ block.settings.center_horizontally == false }}"
    },
    {
      "type": "text",
      "id": "pos_top_mobile",
      "label": "Top Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom_mobile",
      "label": "Bottom Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left_mobile",
      "label": "Left Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto",
      "visible_if": "{{ block.settings.center_horizontally == false }}"
    },
    {
      "type": "text",
      "id": "pos_right_mobile",
      "label": "Right Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto",
      "visible_if": "{{ block.settings.center_horizontally == false }}"
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Custom Button"
    }
  ]
}
{% endschema %}

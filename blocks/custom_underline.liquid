{% comment %}
  Custom Underline block.
  Absolute positioning anywhere on the screen using unified styling parameters.
{% endcomment %}

<style>
  #shopify-block-{{ block.id }} {
    display: contents !important;
  }
  #underline-{{ block.id }} {
    height: {{ block.settings.underline_thickness }}px !important;
  }
</style>

<div
  id="underline-{{ block.id }}"
  class="custom-position-block custom-underline-block"
  style="
    {% render 'custom-block-styles', settings: block.settings, type: 'text' %}
    --custom-width: {{ block.settings.underline_width }}px;
    background: {{ block.settings.underline_color }};
  "
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Custom Underline",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Positioning Settings"
    },
    {
      "type": "text",
      "id": "pos_top",
      "label": "Top Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom",
      "label": "Bottom Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left",
      "label": "Left Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_right",
      "label": "Right Position (Desktop)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_top_mobile",
      "label": "Top Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_bottom_mobile",
      "label": "Bottom Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_left_mobile",
      "label": "Left Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "text",
      "id": "pos_right_mobile",
      "label": "Right Position (Mobile)",
      "default": "auto",
      "info": "e.g. 10%, 50px, auto"
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "underline_width",
      "label": "Underline Width",
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline Thickness",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Underline"
    }
  ]
}
{% endschema %}

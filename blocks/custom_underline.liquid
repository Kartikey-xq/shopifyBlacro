{% comment %}
  Custom Underline block.
  Absolute positioning anywhere on the screen using range sliders for Top, Left, Width, Thickness, and Color.
{% endcomment %}

<style>
  #shopify-block-{{ block.id }} {
    display: contents !important;
  }
  #underline-{{ block.id }} {
    position: absolute;
    display: block;
    width: {{ block.settings.underline_width }}px;
    height: {{ block.settings.underline_thickness }}px;
    background: {{ block.settings.underline_color }};
    top: {{ block.settings.top_position }}px;
    left: {{ block.settings.left_position }}px;
    z-index: 999;
  }
</style>

<div id="underline-{{ block.id }}" class="custom-underline-block" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Custom Underline",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Positioning"
    },
    {
      "type": "range",
      "id": "top_position",
      "label": "Top Position",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "left_position",
      "label": "Left Position",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "underline_width",
      "label": "Underline Width",
      "min": 10,
      "max": 1000,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "underline_thickness",
      "label": "Underline Thickness",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "underline_color",
      "label": "Underline Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom Underline"
    }
  ]
}
{% endschema %}

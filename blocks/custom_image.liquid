{% comment %}
  Custom Image block. Absolute positioning, responsive width, opacity, object fit, and CSS transform.
{% endcomment %}

{% if block.settings.image != blank %}
  <div
    class="custom-image-block"
    style="
      --ci-width: {{ block.settings.image_width }}px;
      --ci-width-m: {{ block.settings.image_width_mobile }}px;
      --ci-opacity: {{ block.settings.image_opacity | divided_by: 100.0 }};
      --ci-object-fit: {{ block.settings.object_fit }};
      --ci-z: {{ block.settings.z_index }};
    "
    {{ block.shopify_attributes }}
  >
    {{
      block.settings.image
      | image_url: width: block.settings.image_width
      | image_tag:
        loading: 'lazy',
        class: 'custom-image-block__img',
        widths: '100, 200, 400, 600, 800'
    }}
  </div>
{% endif %}

{% stylesheet %}
  .shopify-section:has(.custom-image-block) {
    position: relative;
    z-index: 7 !important;
    overflow: visible !important;
  }

  .shopify-section:has(.custom-image-block) .hero,
  .shopify-section:has(.custom-image-block) .hero__container,
  .shopify-section:has(.custom-image-block) .hero__content-wrapper,
  .shopify-section:has(.custom-image-block) .section-content-wrapper {
    overflow: visible !important;
  }

  .shopify-block:has(> .custom-image-block),
  shopify-block:has(> .custom-image-block) {
    display: contents !important;
  }

  .custom-image-block {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) translateY(calc(50% + 2px));
    width: var(--ci-width);
    z-index: var(--ci-z, 5);
    opacity: var(--ci-opacity);
    pointer-events: none;
  }

  .custom-image-block__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: var(--ci-object-fit);
  }

  @media (max-width: 749px) {
    .custom-image-block {
      width: var(--ci-width-m);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (px)",
      "min": 20,
      "max": 800,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image width mobile (px)",
      "min": 20,
      "max": 400,
      "step": 4,
      "default": 120
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Object fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "contain"
    },
    {
      "type": "header",
      "content": "Desktop Positioning"
    },
    {
      "type": "text",
      "id": "pos_top",
      "label": "Top (Desktop)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_bottom",
      "label": "Bottom (Desktop)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_left",
      "label": "Left (Desktop)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_right",
      "label": "Right (Desktop)",
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Mobile Positioning"
    },
    {
      "type": "text",
      "id": "pos_top_mobile",
      "label": "Top (Mobile)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_bottom_mobile",
      "label": "Bottom (Mobile)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_left_mobile",
      "label": "Left (Mobile)",
      "default": "auto"
    },
    {
      "type": "text",
      "id": "pos_right_mobile",
      "label": "Right (Mobile)",
      "default": "auto"
    },
    {
      "type": "range",
      "id": "z_index",
      "label": "Z-index",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "transform",
      "label": "CSS transform (optional)",
      "default": "none",
      "info": "e.g. rotate(5deg) or translateX(-10px)"
    }
  ],
  "presets": [
    {
      "name": "Custom Image"
    }
  ]
}
{% endschema %}

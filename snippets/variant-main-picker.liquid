{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% assign size_chart = product.metafields.custom.size_chart.value | default: product_resource.metafields.custom.size_chart.value | default: product.metafields.custom['size-chart'].value | default: product_resource.metafields.custom['size-chart'].value | default: block_settings.size_chart_image %}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    id="{{ block.id }}"
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; --size-box-bg-color: {{ block_settings.size_box_bg_color | default: '#E8E8E8' }}; --size-selected-dot-color: {{ block_settings.size_selected_dot_color | default: '#16A34A' }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    {%- if block_settings.show_swatches and block_settings.variant_style == 'buttons' -%}
      {% style %}
        [id="{{ block.id }}"] .swatch {
          border-radius: {{ block_settings.swatch_border_radius }}px !important;
          width: {{ block_settings.swatch_size }}px !important;
          height: {{ block_settings.swatch_size }}px !important;
          --swatch-width: {{ block_settings.swatch_size }}px !important;
          --swatch-height: {{ block_settings.swatch_size }}px !important;
        }
        [id="{{ block.id }}"] .variant-option__button-label--has-swatch {
          border-radius: {{ block_settings.swatch_border_radius }}px !important;
          --focus-outline-radius: {{ block_settings.swatch_border_radius }}px !important;
        }

        [id="{{ block.id }}"] .swatch,
        [id="{{ block.id }}"] .variant-option__button-label--has-swatch {
          outline: none !important;
          box-shadow: none !important;
        }

        [id="{{ block.id }}"] .swatch:focus,
        [id="{{ block.id }}"] .swatch:focus-visible,
        [id="{{ block.id }}"] .variant-option__button-label--has-swatch:focus,
        [id="{{ block.id }}"] .variant-option__button-label--has-swatch:focus-visible {
          outline: 2px solid currentColor !important;
          outline-offset: 2px !important;
          border-radius: {{ block_settings.swatch_border_radius }}px !important;
        }
      {% endstyle %}
    {%- endif -%}
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign option_name_downcase = product_option.name | downcase
          if option_name_downcase contains 'care' or option_name_downcase contains 'instruction'
            continue
          endif

          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif

          assign is_size_option = false
          if option_name_downcase == 'size' or option_name_downcase == 'größe' or option_name_downcase == 'taille' or option_name_downcase == 'talla'
            assign is_size_option = true
          endif
        -%}

        {%- if variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          {%- if is_size_option -%}
            {% style %}
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper {
                gap: {{ block_settings.size_option_spacing | default: 0 }}px;
                border: none !important;
                background: none !important;
                overflow: visible !important;
              }
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label {
                background-color: var(--size-box-bg-color, #E8E8E8) !important;
                border: none !important;
                border-radius: var(--variant-picker-button-radius, 4px) !important;
                margin: 0 !important;
                position: relative !important;
                overflow: visible !important;
                color: var(--color-variant-text) !important;
              }
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:not(:last-child) {
                border-right: none !important;
              }
              /* Selected State Styles */
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has(:checked),
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has(:checked):hover {
                background-color: var(--size-box-bg-color, #E8E8E8) !important;
                color: var(--color-variant-text) !important;
                border-bottom: none !important;
                box-shadow: none !important;
              }
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has(:checked)[data-option-available="true"]::after {
                content: '';
                position: absolute;
                top: 50%;
                right: 6px;
                transform: translateY(-50%);
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background-color: var(--size-selected-dot-color, #16A34A);
                pointer-events: none;
                z-index: 2;
              }
              /* Underline on selected available size */
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has(:checked)[data-option-available="true"] .variant-option__button-label__text {
                text-decoration: underline;
                text-underline-offset: 3px;
                text-decoration-thickness: 1px;
                text-decoration-color: currentColor;
              }
              /* No underline when unavailable (even if briefly checked) */
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has(:checked)[data-option-available="false"] .variant-option__button-label__text {
                text-decoration: none;
              }
              /* Unavailable Strikethrough Styles (Composite Background) */
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label svg {
                display: none !important;
              }
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label:has([aria-disabled="true"]) {
                background: 
                  linear-gradient(var(--size-box-bg-color, #E8E8E8), var(--size-box-bg-color, #E8E8E8)) no-repeat center / 24px 20px,
                  linear-gradient(to bottom left, transparent calc(50% - 1px), rgb(var(--color-variant-text-rgb, 0 0 0) / var(--opacity-60, 0.6)) calc(50% - 0.5px), rgb(var(--color-variant-text-rgb, 0 0 0) / var(--opacity-60, 0.6)) calc(50% + 0.5px), transparent calc(50% + 1px)) no-repeat center / 100% 100%,
                  var(--size-box-bg-color, #E8E8E8) !important;
              }
              .variant-picker .variant-option--size-segmented .variant-option__segmented-wrapper .variant-option__button-label .variant-option__button-label__text {
                position: relative !important;
                z-index: 1 !important;
              }
            {% endstyle %}
          {%- endif -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}{% if is_size_option %} variant-option--size-segmented{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {%- if is_size_option and size_chart != blank -%}
                <button type="button" class="pit-size-chart-trigger" aria-haspopup="dialog" aria-label="Open size chart">Size Chart</button>
              {%- else -%}
                {{ product_option.name | escape -}}
              {%- endif -%}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- if is_size_option -%}
              <div class="variant-option__segmented-wrapper">
            {%- endif -%}
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
                data-option-available="{{ product_option_value.available }}"
              >
                {%- liquid
                  assign is_checked = false
                  if product_option_value.selected
                    if is_size_option
                      if product_resource.selected_variant != blank
                        assign is_checked = true
                      endif
                    else
                      assign is_checked = true
                    endif
                  endif
                -%}
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name }}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if is_checked %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled',
                    value: product_option_value.name
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {%- if is_size_option -%}
              </div>
            {%- endif -%}
            {%- if variant_style == 'swatch' -%}
              {%- if option_name_downcase == 'color' or option_name_downcase == 'colour' or option_name_downcase == 'farbe' or option_name_downcase == 'couleur' -%}
                <span class="variant-option__color-count">
                  {{ product_option.values.size }}
                  {%- if product_option.values.size == 1 -%}
                    Colour
                  {%- else -%}
                    Colours
                  {%- endif -%}
                </span>
              {%- endif -%}
            {%- endif -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns{% if is_size_option %} variant-option--size-dropdown{% endif %}">
            {%- if is_size_option and size_chart != blank -%}
              <button type="button" class="pit-size-chart-trigger" aria-haspopup="dialog" aria-label="Open size chart">Size Chart</button>
            {%- else -%}
              <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            {%- endif -%}
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- if is_size_option and product_resource.selected_variant == blank -%}
                  <option value="" disabled selected>Select size</option>
                {%- endif -%}
                {%- for product_option_value in product_option.values -%}
                  {%- liquid
                    assign is_selected = false
                    if product_option_value.selected
                      if is_size_option
                        if product_resource.selected_variant != blank
                          assign is_selected = true
                        endif
                      else
                        assign is_selected = true
                      endif
                    endif
                  -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if is_selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>

  {%- if size_chart != blank -%}
    <div class="pit-size-chart-overlay" id="pit-overlay-{{ block.id }}" role="dialog" aria-modal="true" style="display:none">
      <div class="pit-size-chart-backdrop"></div>
      <div class="pit-size-chart-modal">
        <button class="pit-size-chart-close" type="button" aria-label="Close size chart">&times;</button>
        {{
          size_chart
          | image_url: width: 1600
          | image_tag: alt: 'Size chart', loading: 'lazy', class: 'pit-size-chart-image'
        }}
      </div>
    </div>

    <style>
      .pit-size-chart-trigger {
        background: none !important;
        border: none !important;
        padding: 0 !important;
        cursor: pointer !important;
        font-family: inherit !important;
        font-size: inherit !important;
        color: inherit !important;
        text-decoration: underline dotted !important;
        display: inline !important;
      }

      .pit-size-chart-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .pit-size-chart-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.82);
        z-index: 0;
        cursor: pointer;
      }

      .pit-size-chart-modal {
        position: relative;
        z-index: 1;
        background: transparent;
        max-width: min(90vw, 700px);
        max-height: 90vh;
        overflow-y: auto;
        border-radius: 0;
        padding: 0;
        box-shadow: none;
        margin: auto;
      }

      .pit-size-chart-image {
        width: 100%;
        height: auto;
        max-width: 700px;
        display: block;
      }

      .pit-size-chart-close {
        position: absolute;
        top: 8px;
        right: 12px;
        font-size: 24px;
        line-height: 1;
        background: none;
        border: none;
        cursor: pointer;
        color: #000;
      }
    </style>

    <script>
      (function() {
        const blockId = '{{ block.id }}';
        const overlay = document.getElementById('pit-overlay-' + blockId);
        if (!overlay) return;

        const triggers = Array.from(document.querySelectorAll('#' + blockId + ' .pit-size-chart-trigger, [data-block-id="' + blockId + '"] .pit-size-chart-trigger'));
        const closeBtn = overlay.querySelector('.pit-size-chart-close');
        const backdrop = overlay.querySelector('.pit-size-chart-backdrop');

        function openModal() {
          overlay.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          overlay.style.display = 'none';
          document.body.style.overflow = '';
        }

        triggers.forEach(trigger => {
          trigger.addEventListener('click', function(e) {
            e.preventDefault();
            openModal();
          });
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', closeModal);
        }

        if (backdrop) {
          backdrop.addEventListener('click', closeModal);
        }

        window.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && overlay.style.display === 'flex') {
            closeModal();
          }
        });
      })();
    </script>
  {%- endif -%}
{% endunless %}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }
{% endstylesheet %}
